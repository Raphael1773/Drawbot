// Structure mathématique pour le filtre de Kalman 1D (Lacet / Yaw)
struct Kalman1D {
  float Q_angle = 0.001f;  
  float Q_bias  = 0.003f;  
  float R_measure = 0.03f; 

  float angle = 0.0f; 
  float bias  = 0.0f; 
  float P[2][2] = {{0, 0}, {0, 0}};

  float update(float newAngle, float newRate, float dt) {
    // Étape 1 : Prédiction (Gyro)
    float rate = newRate - bias;
    angle += dt * rate;

    P[0][0] += dt * (dt * P[1][1] - P[0][1] - P[1][0] + Q_angle);
    P[0][1] -= dt * P[1][1];
    P[1][0] -= dt * P[1][1];
    P[1][1] += Q_bias * dt;

    // Étape 2 : Correction (Mag)
    float S = P[0][0] + R_measure;
    float K[2]; 
    K[0] = P[0][0] / S;
    K[1] = P[1][0] / S;

    float y = newAngle - angle;
    if (y > 180.0f)  y -= 360.0f;
    if (y < -180.0f) y += 360.0f;

    angle += K[0] * y;
    bias  += K[1] * y;

    float P00_temp = P[0][0];
    float P01_temp = P[0][1];

    P[0][0] -= K[0] * P00_temp;
    P[0][1] -= K[0] * P01_temp;
    P[1][0] -= K[1] * P00_temp;
    P[1][1] -= K[1] * P01_temp;

    if (angle >= 360.0f) angle -= 360.0f;
    if (angle < 0.0f)    angle += 360.0f;

    return angle;
  }
};

