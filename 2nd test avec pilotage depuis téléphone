}

void writeReg(uint8_t addr, uint8_t reg, uint8_t val) {
  Wire.beginTransmission(addr); Wire.write(reg); Wire.write(val); Wire.endTransmission(); 
}

int16_t read16(uint8_t addr, uint8_t reg) {
  Wire.beginTransmission(addr); Wire.write(reg | 0x80); Wire.endTransmission(false); 
  Wire.requestFrom(addr, (uint8_t)2);
  uint8_t lo = Wire.read(); uint8_t hi = Wire.read();
  return (int16_t)(hi << 8 | lo); 
}

void initLIS3MDL() {
  writeReg(LIS3MDL_ADDR, LIS3_CTRL1, 0x7E); // Boosté à 80 Hz, Ultra-haute performance
  writeReg(LIS3MDL_ADDR, LIS3_CTRL2, 0x00); // ±4 gauss
  writeReg(LIS3MDL_ADDR, LIS3_CTRL3, 0x00); // Mode continu
  writeReg(LIS3MDL_ADDR, LIS3_CTRL4, 0x0C); // Axe Z Ultra-haute performance
  logf("LIS3MDL (Mag) configure a 80Hz (Ultra-Performance)\n");
}

void calibrerGyro() {
  long somme = 0;
  int echantillons = 300;
  logf("Calibration Gyro... LAISSER LE ROBOT IMMOBILE\n");
  for (int i = 0; i < echantillons; i++) {
    somme += myIMU.readRawGyroZ();
    delay(4);
  }
  gyroBiasZ = (float)somme / echantillons;
  logf("Biais Gyro Z calcule et soustrait : %.2f\n", gyroBiasZ);
}

float obtenirCapMagnetometre() {
  int16_t mx = read16(LIS3MDL_ADDR, LIS3_OUT_X_L);
  int16_t my = read16(LIS3MDL_ADDR, LIS3_OUT_X_L + 2);

  float nx = (mx - CALIB_X_OFFSET) / CALIB_X_SCALE;
  float ny = (my - CALIB_Y_OFFSET) / CALIB_Y_SCALE;

  float capRad = atan2(-ny, nx);
  float cap = capRad * 180.0 / PI;
  if (cap < 0) cap += 360.0;
  return cap;
}

void executerFiltreKalman() {
  uint32_t maintenant = millis();
  float dt = (maintenant - tDernierKalman) / 1000.0f;
  if (dt < 0.005f) return; 
  tDernierKalman = maintenant;

  // 1. Lecture de la vitesse angulaire (Gyro Z)
  float gyroBrutZ = myIMU.readRawGyroZ();
  float gyroCorrige = gyroBrutZ - gyroBiasZ;
  float vitesseAngulaireZ = gyroCorrige * 4.375f / 1000.0f; // Conversion en °/s

  // Note : Si la boussole tourne à l'envers lors des rotations, décommente la ligne ci-dessous :
  // vitesseAngulaireZ = -vitesseAngulaireZ;

  // 2. Lecture du cap absolu (Mag)
  float capMag = obtenirCapMagnetometre();

  // 3. Fusion de Kalman
  capGlobal = fKalman.update(capMag, vitesseAngulaireZ, dt);
}

// REINITIALISATION DU SYSTEME CARTESIEN (HOME)
void reinitialiserRepereCartesien() {
  noInterrupts();
  pasDroit = 0; 
  pasGauche = 0;
  ticksOdoDroit = 0; 
  ticksOdoGauche = 0;
  interrupts();

  pasDroitPrev = 0; 
  pasGauchePrev = 0;
  pasDroitOdoPrev = 0; 
  pasGaucheOdoPrev = 0;

  // Configuration avec la position initiale fixe au lieu de 0.0
  Centre_Robot_X = -13.10; 
  Centre_Robot_Y = 0.0;

  float capRad = capGlobal * PI / 180.0;
  x_stylo = Centre_Robot_X + DISTANCE_MI_ENTRAXE_STYLO * cos(capRad);
  y_stylo = Centre_Robot_Y + DISTANCE_MI_ENTRAXE_STYLO * sin(capRad);

  logf("[RESET] Repere cartesian initialise a la position de depart (-13.10, 0).\n");
}

void corrigerPD() {
  if (commandeEnCours != "avancer" && commandeEnCours != "reculer") return;
  if (millis() - tDerniereCorr < 10) return;   
  tDerniereCorr = millis();

  noInterrupts();
  long ticksD = pasDroit; long ticksG = pasGauche;
  interrupts();

  long  ecart      = ticksD - ticksG;
  float derivee    = ecart - ecartPrecedent;
  int   correction = (int)((ecart * Kp) + (derivee * Kd));
  ecartPrecedent   = ecart;

  int pwrD = constrain(PWR_DROIT_AV - correction, 0, 255);
  int pwrG = constrain(PWR_GAUCHE_AV + correction, 0, 255);

  ledcWrite(canalDroit,  pwrD);
  ledcWrite(canalGauche, pwrG);
}

void calculerVitesse() {
  if (millis() - tDerniereVit < INTERVALLE_VITESSE_MS) return;
  float dt = (millis() - tDerniereVit) / 1000.0;
  tDerniereVit = millis();

  noInterrupts();
  long d = pasDroit; long g = pasGauche;
  interrupts();

  float ticksParSecD = (d - pasDroitPrev)  / dt;
  float ticksParSecG = (g - pasGauchePrev) / dt;
  pasDroitPrev  = d; pasGauchePrev = g;

  vitesseDcms = ticksParSecD * CM_PAR_TICK;
  vitesseGcms = ticksParSecG * CM_PAR_TICK;
}

void mettreAJourOdometrie() {
  if (millis() - tDerniereOdo < 10) return; 
  tDerniereOdo = millis();

  noInterrupts();
  long actuelsD = ticksOdoDroit; long actuelsG = ticksOdoGauche;
  interrupts();

  long deltaTicksD = actuelsD - pasDroitOdoPrev;
  long deltaTicksG = actuelsG - pasGaucheOdoPrev;
  pasDroitOdoPrev  = actuelsD; pasGaucheOdoPrev = actuelsG;

  float deltaDDroit  = (float)deltaTicksD * CM_PAR_TICK;
  float deltaDGauche = (float)deltaTicksG * CM_PAR_TICK;
  float deltaDCentre = (deltaDDroit + deltaDGauche) / 2.0;

  float angleMoyenDeg = (capGlobalPrev + capGlobal) / 2.0;
  capGlobalPrev = capGlobal;

  float capRad = angleMoyenDeg * PI / 180.0;

  Centre_Robot_X += deltaDCentre * cos(capRad);
  Centre_Robot_Y += deltaDCentre * sin(capRad);

  x_stylo = Centre_Robot_X + DISTANCE_MI_ENTRAXE_STYLO * cos(capRad);
  y_stylo = Centre_Robot_Y + DISTANCE_MI_ENTRAXE_STYLO * sin(capRad);
}

