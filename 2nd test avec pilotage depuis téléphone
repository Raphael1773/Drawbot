void handleCmd() {
  if (server.hasArg("action")) {
    String nouvelleCommande = server.arg("action");
    if (nouvelleCommande != commandeEnCours) {
      noInterrupts(); pasDroit = 0; pasGauche = 0; interrupts();
      ecartPrecedent = 0;
      
      // REINITIALISATION AUTOMATIQUE SUPPRIMÉE ICI POUR CONSERVER L'ODOMÉTRIE EN CONTINU
    }
    commandeEnCours = nouvelleCommande;
  }
  server.send(200, "text/plain", "ok");
}

