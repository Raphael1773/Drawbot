// ============================================================
// CONTRÔLEUR PROPORTIONNEL DE CAP (virage séquence)
//
// Principe : toutes les 10 ms, on mesure l'écart entre le cap
// cible et capGlobal. La puissance moteur est proportionnelle
// à cet écart, bornée entre PWR_VIRAGE_MIN et PWR_VIRAGE_MAX.
// En dessous de SEUIL_ARRIVE (2°) on considère le virage fini.
//
// virageProportionnel_pwr > 0 → rotation gauche
// virageProportionnel_pwr < 0 → rotation droite
// ============================================================
// ============================================================
// CONTRÔLEUR DE VIRAGE PAR MICRO-PAS
//
// Au lieu de tourner en continu (grand arc), on procède par
// petits pas discrets :
//   1. Tourner jusqu'à ce que le cap ait changé de PAS_VIRAGE_DEG (3°)
//   2. Stop + pause PAUSE_PAS_VIRAGE_MS (100 ms) — magnéto se stabilise
//   3. Vérifier erreur globale :
//        < SEUIL_ARRIVE (2°) → virage terminé
//        sinon              → pas suivant
//
// Arc par pas = 3° × 13,1 cm × π/180 ≈ 0,7 cm  (quasi invisible)
// Durée totale 90° ≈ 30 pas × 120 ms ≈ 3,6 s
// ============================================================
float    targetCapVirage          =   0.0f;
int      virageProportionnel_pwr  =   0;

// Sous-état du virage
enum VirageSousEtat { VIR_TOURNE, VIR_STABILISE };
VirageSousEtat virageSousEtat = VIR_TOURNE;
float    capDebutPas   = 0.0f;  // cap au début du pas en cours
uint32_t tPasVirage    = 0;     // horodatage début de la pause

const float    PAS_VIRAGE_DEG      =  3.0f;   // degrés par micro-pas
const uint32_t PAUSE_PAS_VIRAGE_MS =  100;    // pause stabilisation (ms)
const float    Kp_virage_prop      =  2.5f;   // gain °→PWM pendant le pas
const int      PWR_VIRAGE_MIN      =   80;    // puissance minimale
const int      PWR_VIRAGE_MAX      =  180;    // puissance maximale
const float    SEUIL_ARRIVE        =   2.0f;  // tolérance finale (°)
const float    SEQ_DIST_1   = 20.0f;
const float    SEQ_DIST_2   = 10.0f;
const float    SEQ_DIST_3   = 40.0f;
const float    SEQ_ANGLE    = 90.0f;

// ============================================================
// FONCTIONS BAS NIVEAU
// ============================================================
void writeReg(uint8_t addr, uint8_t reg, uint8_t val) {
  Wire.beginTransmission(addr); Wire.write(reg); Wire.write(val); Wire.endTransmission();
}

int16_t read16(uint8_t addr, uint8_t reg) {
  Wire.beginTransmission(addr); Wire.write(reg | 0x80); Wire.endTransmission(false);
  Wire.requestFrom(addr, (uint8_t)2);
  return (int16_t)(Wire.read() | (Wire.read() << 8));
}

void initLIS3MDL() {
  writeReg(LIS3MDL_ADDR, LIS3_CTRL1, 0x7E);
  writeReg(LIS3MDL_ADDR, LIS3_CTRL2, 0x00);
  writeReg(LIS3MDL_ADDR, LIS3_CTRL3, 0x00);
  writeReg(LIS3MDL_ADDR, LIS3_CTRL4, 0x0C);
}

void calibrerGyro() {
  long somme = 0;
  for (int i = 0; i < 300; i++) { somme += myIMU.readRawGyroZ(); delay(4); }
  gyroBiasZ = (float)somme / 300.0f;
}

float obtenirCapMagnetometre() {
  int16_t mx = read16(LIS3MDL_ADDR, LIS3_OUT_X_L);
  int16_t my = read16(LIS3MDL_ADDR, LIS3_OUT_X_L + 2);
  float nx   = (mx - CALIB_X_OFFSET) / CALIB_X_SCALE;
  float ny   = (my - CALIB_Y_OFFSET) / CALIB_Y_SCALE;
  float cap  = atan2(-ny, nx) * 180.0f / PI;
  if (cap < 0) cap += 360.0f;
  return cap;
}

void executerFiltreKalman() {
  uint32_t maintenant = millis();
  float dt = (maintenant - tDernierKalman) / 1000.0f;
  if (dt < 0.020f) return;
  tDernierKalman = maintenant;
  float gyroCorrige       = myIMU.readRawGyroZ() - gyroBiasZ;
  float vitesseAngulaireZ = gyroCorrige * 4.375f / 1000.0f;
  capGlobal = fKalman.update(obtenirCapMagnetometre(), vitesseAngulaireZ, dt);
}

void reinitialiserRepereCartesien() {
  noInterrupts();
  pasDroit  = 0; pasGauche  = 0;
  ticksOdoDroit = 0; ticksOdoGauche = 0;
  interrupts();
  pasDroitPrev  = 0; pasGauchePrev  = 0;
  pasDroitOdoPrev = 0; pasGaucheOdoPrev = 0;
  capInitialAuReset = capGlobal;
  Centre_Robot_X    = -DISTANCE_MI_ENTRAXE_STYLO;
  Centre_Robot_Y    =  0.0f;
  x_stylo           =  0.0f;
  y_stylo           =  0.0f;
  capGlobalPrev     = capGlobal;
}

void calculerVitesse() {
  if (millis() - tDerniereVit < INTERVALLE_VITESSE_MS) return;
  float dt = (millis() - tDerniereVit) / 1000.0f;
  tDerniereVit = millis();
  noInterrupts(); long d = pasDroit; long g = pasGauche; interrupts();
  vitesseDcms = ((d - pasDroitPrev)  / dt) * CM_PAR_TICK;
  vitesseGcms = ((g - pasGauchePrev) / dt) * CM_PAR_TICK;
  pasDroitPrev = d; pasGauchePrev = g;
}

void mettreAJourOdometrie() {
  if (millis() - tDerniereOdo < 10) return;
  tDerniereOdo = millis();

  noInterrupts();
  long actuelsD = ticksOdoDroit;
  long actuelsG = ticksOdoGauche;
  interrupts();

  long deltaTicksD = actuelsD - pasDroitOdoPrev;
  long deltaTicksG = actuelsG - pasGaucheOdoPrev;
  pasDroitOdoPrev  = actuelsD;
  pasGaucheOdoPrev = actuelsG;

  float distD = (float)deltaTicksD * CM_PAR_TICK;
  float distG = (float)deltaTicksG * CM_PAR_TICK;
  float deltaDCentre = 0.0f;

  if      (commandeEnCours == CMD_AVANCER || commandeEnCours == CMD_VAG || commandeEnCours == CMD_VAD)
    deltaDCentre =  (distD + distG) / 2.0f;
  else if (commandeEnCours == CMD_RECULER || commandeEnCours == CMD_VEG || commandeEnCours == CMD_VED)
    deltaDCentre = -(distD + distG) / 2.0f;

  float diffCap = capGlobal - capGlobalPrev;
  if (diffCap >  180.0f) diffCap -= 360.0f;
  if (diffCap < -180.0f) diffCap += 360.0f;
  float angleMoyenDeg = capGlobalPrev + diffCap / 2.0f;
  capGlobalPrev = capGlobal;

  float capVirtuelDeg = angleMoyenDeg - capInitialAuReset;
  float capRad        = capVirtuelDeg * PI / 180.0f;

  Centre_Robot_X += deltaDCentre * cosf(capRad);
  Centre_Robot_Y += deltaDCentre * sinf(capRad);
  x_stylo = Centre_Robot_X + DISTANCE_MI_ENTRAXE_STYLO * cosf(capRad);
  y_stylo = Centre_Robot_Y + DISTANCE_MI_ENTRAXE_STYLO * sinf(capRad);
}

// ============================================================
// PUSH COORDONNÉES via WebSocket
// Appelé toutes les 200 ms depuis loop().
// Remplace le polling HTTP GET /pos toutes les 300 ms.
// ============================================================
void envoyerPositions() {
  if (millis() - tDernierePosPush < 200) return;
  tDernierePosPush = millis();
  if (wsClientNum < 0) return;   // personne de connecté
  char json[128];
  snprintf(json, sizeof(json),
    "{\"t\":\"pos\",\"rx\":%.1f,\"ry\":%.1f,\"sx\":%.1f,\"sy\":%.1f}",
    Centre_Robot_X * 10.0f, Centre_Robot_Y * 10.0f,
    x_stylo        * 10.0f, y_stylo        * 10.0f);
  webSocket.sendTXT((uint8_t)wsClientNum, json);
}

// ============================================================
// GÉOMÉTRIE TRAJECTOIRE
// ============================================================
float crossTrackError() {
  float dx  = seqSegEndX - seqSegStartX;
  float dy  = seqSegEndY - seqSegStartY;
  float len = sqrtf(dx*dx + dy*dy);
  if (len < 0.001f) return 0.0f;
  float nx = -dy / len;
  float ny =  dx / len;
  return (x_stylo - seqSegStartX)*nx + (y_stylo - seqSegStartY)*ny;
}

float alongTrackProgress() {
  float dx  = seqSegEndX - seqSegStartX;
  float dy  = seqSegEndY - seqSegStartY;
  float len = sqrtf(dx*dx + dy*dy);
  if (len < 0.001f) return 0.0f;
  return ((x_stylo - seqSegStartX)*dx + (y_stylo - seqSegStartY)*dy) / len;
}

float longueurSegment() {
  float dx = seqSegEndX - seqSegStartX;
  float dy = seqSegEndY - seqSegStartY;
  return sqrtf(dx*dx + dy*dy);
}

// ============================================================
// HELPERS DÉMARRAGE DE PHASES
// ============================================================
void demarrerSegment(float dirX, float dirY, float longueur) {
  noInterrupts(); pasDroit = 0; pasGauche = 0; interrupts();
  ecartPrecedent = 0; correctionDynamique = 0; errTransvPrev = 0.0f;
  seqSegStartX = x_stylo; seqSegStartY = y_stylo;
  seqSegEndX   = x_stylo + dirX * longueur;
  seqSegEndY   = y_stylo + dirY * longueur;
  modeTrajectoire = true;
  commandeEnCours = CMD_AVANCER;
  tDebutSegment   = millis();   // horodatage pour le timeout
}

// deltaDeg : +90 = virage gauche, -90 = virage droite
void demarrerTourner(float deltaDeg) {
  targetCapVirage = capGlobal + deltaDeg;
  if (targetCapVirage >= 360.0f) targetCapVirage -= 360.0f;
  if (targetCapVirage <    0.0f) targetCapVirage += 360.0f;
  noInterrupts(); pasDroit = 0; pasGauche = 0; interrupts();
  ecartPrecedent           = 0;
  correctionDynamique      = 0;
  virageProportionnel_pwr  = 0;
  capDebutPas              = capGlobal;
  virageSousEtat           = VIR_TOURNE;
  modeTrajectoire          = false;
  commandeEnCours          = CMD_VIRAGE_PROP;
}

void demarrerMouvementCourt(float distCm, Commande direction) {
  noInterrupts(); pasDroit = 0; pasGauche = 0; interrupts();
  ecartPrecedent = 0; correctionDynamique = 0;
  modeTrajectoire = false;
  ticksCible      = (long)(distCm / CM_PAR_TICK);
  commandeEnCours = direction;
}

void capVersVecteur(float &dirX, float &dirY) {
  float rad = (capGlobal - capInitialAuReset) * PI / 180.0f;
  dirX = cosf(rad);
  dirY = sinf(rad);
}

// ============================================================
// PID
// ============================================================
void corrigerPD() {
  if (commandeEnCours == CMD_STOP) { correctionDynamique = 0; return; }
  if (millis() - tDerniereCorr < 10) return;
  tDerniereCorr = millis();

  if (modeTrajectoire && commandeEnCours == CMD_AVANCER) {
    float err = crossTrackError();
    correctionDynamique = (int)(Kp_traj * err + Kd_traj * (err - errTransvPrev));
    correctionDynamique = constrain(correctionDynamique, -60, 60);
    errTransvPrev = err;
    return;
  }

  noInterrupts(); long tD = pasDroit; long tG = pasGauche; interrupts();
  long  ecart     = 0;
  float kp_actuel = Kp;
  float kd_actuel = Kd;

  switch (commandeEnCours) {
    case CMD_AVANCER:
    case CMD_RECULER:   ecart = tD - tG; break;
    case CMD_ROTATION_GAUCHE:
    case CMD_ROTATION_DROITE:
      ecart = tD - tG; kp_actuel = Kp_rotation; kd_actuel = Kd_rotation; break;
    case CMD_VAG: ecart = tG - (long)(tD * RATIO_VIRAGE); break;
    case CMD_VAD: ecart = tD - (long)(tG * RATIO_VIRAGE); break;
    case CMD_VEG: ecart = tG - (long)(tD * RATIO_VIRAGE); break;
    case CMD_VED: ecart = tD - (long)(tG * RATIO_VIRAGE); break;
    default: break;
  }

  correctionDynamique = (int)((ecart * kp_actuel) + ((ecart - ecartPrecedent) * kd_actuel));
  ecartPrecedent = ecart;
}

// ============================================================
// SÉQUENCE ESCALIER
// ============================================================
void gererSequence() {
  if (!sequenceActive) return;

  switch (etatSequence) {
    case SEQ_AVANCE_1:
      if (alongTrackProgress() >= longueurSegment() ||
          millis() - tDebutSegment > TIMEOUT_SEGMENT_MS) {
        modeTrajectoire = false; commandeEnCours = CMD_STOP;
        tPauseSeq = millis(); etatSequence = SEQ_PAUSE_1;
      }
      break;
    case SEQ_PAUSE_1:
      if (millis() - tPauseSeq >= PAUSE_SEQ_MS) {
        demarrerMouvementCourt(DISTANCE_MI_ENTRAXE_STYLO, CMD_AVANCER);
        etatSequence = SEQ_PRE_VIRAGE_G;
      }
      break;
    case SEQ_PRE_VIRAGE_G: {
      noInterrupts(); long d = pasDroit; interrupts();
      if (d >= ticksCible) {
        commandeEnCours = CMD_STOP; tPauseSeq = millis();
        etatSequence = SEQ_PAUSE_PRE_G;
      }
      break;
    }
    case SEQ_PAUSE_PRE_G:
      if (millis() - tPauseSeq >= PAUSE_SEQ_MS) {
        demarrerTourner(+90.0f);   // +90° = virage gauche
        etatSequence = SEQ_TOURNE_G;
      }
      break;
    // ── Virage gauche par micro-pas ────────────────────────────────────
    case SEQ_TOURNE_G: {
      // Erreur globale (target - actuel), normalisée ±180°
      float errGlobale = targetCapVirage - capGlobal;
      if (errGlobale >  180.0f) errGlobale -= 360.0f;
      if (errGlobale < -180.0f) errGlobale += 360.0f;

      if (virageSousEtat == VIR_TOURNE) {
        // Mesurer combien on a tourné depuis le début de ce pas
        float deltaPas = capGlobal - capDebutPas;
        if (deltaPas >  180.0f) deltaPas -= 360.0f;
        if (deltaPas < -180.0f) deltaPas += 360.0f;

        bool pasFini = fabsf(deltaPas) >= PAS_VIRAGE_DEG
                    || fabsf(errGlobale) < SEUIL_ARRIVE;

        if (pasFini) {
          // Stop et attente de stabilisation du magnéto
          virageProportionnel_pwr = 0;
          commandeEnCours = CMD_STOP;
          virageSousEtat  = VIR_STABILISE;
          tPasVirage      = millis();
        } else {
          // Puissance proportionnelle à l'erreur globale restante
          int pwr = constrain((int)(fabsf(errGlobale) * Kp_virage_prop),
                              PWR_VIRAGE_MIN, PWR_VIRAGE_MAX);
          virageProportionnel_pwr = (errGlobale > 0.0f) ? pwr : -pwr;
          commandeEnCours = CMD_VIRAGE_PROP;
        }
      } else {  // VIR_STABILISE — attente 100 ms
        if (millis() - tPasVirage >= PAUSE_PAS_VIRAGE_MS) {
          // Re-lire l'erreur après stabilisation
          float err = targetCapVirage - capGlobal;
          if (err >  180.0f) err -= 360.0f;
          if (err < -180.0f) err += 360.0f;
          if (fabsf(err) < SEUIL_ARRIVE) {
            // Virage terminé avec précision
            commandeEnCours = CMD_STOP;
            tPauseSeq = millis();
            etatSequence = SEQ_PAUSE_POST_G;
          } else {
            // Nouveau micro-pas
            capDebutPas    = capGlobal;
            virageSousEtat = VIR_TOURNE;
          }
        }
      }
      break;
    }
    case SEQ_PAUSE_POST_G:
      if (millis() - tPauseSeq >= PAUSE_POST_ROT_MS) {  // pause longue : magnéto se stabilise
        demarrerMouvementCourt(DISTANCE_MI_ENTRAXE_STYLO, CMD_RECULER);
        etatSequence = SEQ_POST_VIRAGE_G;
      }
      break;
    case SEQ_POST_VIRAGE_G: {
      noInterrupts(); long d = pasDroit; interrupts();
      if (d >= ticksCible) {
        commandeEnCours = CMD_STOP; tPauseSeq = millis();
        etatSequence = SEQ_PAUSE_2;
      }
      break;
    }
    case SEQ_PAUSE_2:
      if (millis() - tPauseSeq >= PAUSE_SEQ_MS) {
        float dx, dy; capVersVecteur(dx, dy);
        demarrerSegment(dx, dy, SEQ_DIST_2); etatSequence = SEQ_AVANCE_2;
      }
      break;
    case SEQ_AVANCE_2:
      if (alongTrackProgress() >= longueurSegment() ||
          millis() - tDebutSegment > TIMEOUT_SEGMENT_MS) {
        modeTrajectoire = false; commandeEnCours = CMD_STOP;
        tPauseSeq = millis(); etatSequence = SEQ_PAUSE_3;
      }
      break;
    case SEQ_PAUSE_3:
      if (millis() - tPauseSeq >= PAUSE_SEQ_MS) {
        demarrerMouvementCourt(DISTANCE_MI_ENTRAXE_STYLO, CMD_AVANCER);
        etatSequence = SEQ_PRE_VIRAGE_D;
      }
      break;
    case SEQ_PRE_VIRAGE_D: {
      noInterrupts(); long d = pasDroit; interrupts();
      if (d >= ticksCible) {
        commandeEnCours = CMD_STOP; tPauseSeq = millis();
        etatSequence = SEQ_PAUSE_PRE_D;
      }
      break;
    }
    case SEQ_PAUSE_PRE_D:
      if (millis() - tPauseSeq >= PAUSE_SEQ_MS) {
        demarrerTourner(-90.0f);   // -90° = virage droite
        etatSequence = SEQ_TOURNE_D;
      }
      break;
    // ── Virage droite par micro-pas ────────────────────────────────────
    case SEQ_TOURNE_D: {
      float errGlobale = targetCapVirage - capGlobal;
      if (errGlobale >  180.0f) errGlobale -= 360.0f;
      if (errGlobale < -180.0f) errGlobale += 360.0f;

      if (virageSousEtat == VIR_TOURNE) {
        float deltaPas = capGlobal - capDebutPas;
        if (deltaPas >  180.0f) deltaPas -= 360.0f;
        if (deltaPas < -180.0f) deltaPas += 360.0f;

        bool pasFini = fabsf(deltaPas) >= PAS_VIRAGE_DEG
                    || fabsf(errGlobale) < SEUIL_ARRIVE;

        if (pasFini) {
          virageProportionnel_pwr = 0;
          commandeEnCours = CMD_STOP;
          virageSousEtat  = VIR_STABILISE;
          tPasVirage      = millis();
        } else {
          int pwr = constrain((int)(fabsf(errGlobale) * Kp_virage_prop),
                              PWR_VIRAGE_MIN, PWR_VIRAGE_MAX);
          virageProportionnel_pwr = (errGlobale > 0.0f) ? pwr : -pwr;
          commandeEnCours = CMD_VIRAGE_PROP;
        }
      } else {  // VIR_STABILISE
        if (millis() - tPasVirage >= PAUSE_PAS_VIRAGE_MS) {
          float err = targetCapVirage - capGlobal;
          if (err >  180.0f) err -= 360.0f;
          if (err < -180.0f) err += 360.0f;
          if (fabsf(err) < SEUIL_ARRIVE) {
            commandeEnCours = CMD_STOP;
            tPauseSeq = millis();
            etatSequence = SEQ_PAUSE_POST_D;
          } else {
            capDebutPas    = capGlobal;
            virageSousEtat = VIR_TOURNE;
          }
        }
      }
      break;
    }
    case SEQ_PAUSE_POST_D:
      if (millis() - tPauseSeq >= PAUSE_POST_ROT_MS) {  // pause longue : magnéto se stabilise
        demarrerMouvementCourt(DISTANCE_MI_ENTRAXE_STYLO, CMD_RECULER);
        etatSequence = SEQ_POST_VIRAGE_D;
      }
      break;
    case SEQ_POST_VIRAGE_D: {
      noInterrupts(); long d = pasDroit; interrupts();
      if (d >= ticksCible) {
        commandeEnCours = CMD_STOP; tPauseSeq = millis();
        etatSequence = SEQ_PAUSE_4;
      }
      break;
    }
    case SEQ_PAUSE_4:
      if (millis() - tPauseSeq >= PAUSE_SEQ_MS) {
        float dx, dy; capVersVecteur(dx, dy);
        demarrerSegment(dx, dy, SEQ_DIST_3); etatSequence = SEQ_AVANCE_3;
      }
      break;
    case SEQ_AVANCE_3:
      if (alongTrackProgress() >= longueurSegment() ||
          millis() - tDebutSegment > TIMEOUT_SEGMENT_MS) {
        modeTrajectoire = false; commandeEnCours = CMD_STOP;
        etatSequence = SEQ_TERMINEE; sequenceActive = false;
        if (wsClientNum >= 0)
          webSocket.sendTXT((uint8_t)wsClientNum, "{\"t\":\"seq_done\"}");
      }
      break;
    default: break;
  }
}

// ============================================================
// WEBSOCKET — réception des commandes
// ============================================================
void onWebSocketEvent(uint8_t num, WStype_t type,
                      uint8_t* payload, size_t length) {
  switch (type) {

    case WStype_CONNECTED:
      wsClientNum = (int8_t)num;
      break;

    case WStype_DISCONNECTED:
      if ((int8_t)num == wsClientNum) wsClientNum = -1;
      // Sécurité : stopper le robot si le client se déconnecte
      if (!sequenceActive) {
        commandeEnCours = CMD_STOP;
        modeTrajectoire = false;
      }
      break;

    case WStype_TEXT: {
      String msg = String((char*)payload);

      if (msg == "reset_cart") {
        reinitialiserRepereCartesien();
        break;
      }
      if (msg == "seq_start") {
        reinitialiserRepereCartesien();
        errTransvPrev  = 0.0f;
        sequenceActive = true;
        demarrerSegment(1.0f, 0.0f, SEQ_DIST_1);
        etatSequence = SEQ_AVANCE_1;
        break;
      }

      Commande nouvelleCommande = stringToCommande(msg);
      if (sequenceActive) {
        if (nouvelleCommande == CMD_STOP) {
          etatSequence = SEQ_INACTIVE; sequenceActive = false;
          modeTrajectoire = false; commandeEnCours = CMD_STOP;
        }
        // autre commande ignorée pendant la séquence
      } else {
        if (nouvelleCommande != commandeEnCours) {
          noInterrupts(); pasDroit = 0; pasGauche = 0; interrupts();
          ecartPrecedent = 0; correctionDynamique = 0;
          modeTrajectoire = false;
        }
        commandeEnCours = nouvelleCommande;
      }
      break;
    }

    default: break;
  }
}

// ============================================================
// APPLICATION DES COMMANDES MOTEUR
// ============================================================
void appliquerCommande() {
  switch (commandeEnCours) {
    case CMD_AVANCER:
      digitalWrite(IN_1_D, LOW);  digitalWrite(IN_2_D, HIGH);
      digitalWrite(IN_1_G, HIGH); digitalWrite(IN_2_G, LOW);
      ledcWrite(canalDroit,  constrain(PWR_DROIT_AV  - correctionDynamique, 0, 255));
      ledcWrite(canalGauche, constrain(PWR_GAUCHE_AV + correctionDynamique, 0, 255));
      break;
    case CMD_RECULER:
      digitalWrite(IN_1_D, HIGH); digitalWrite(IN_2_D, LOW);
      digitalWrite(IN_1_G, LOW);  digitalWrite(IN_2_G, HIGH);
      ledcWrite(canalDroit,  constrain(PWR_DROIT_AR  - correctionDynamique, 0, 255));
      ledcWrite(canalGauche, constrain(PWR_GAUCHE_AR + correctionDynamique, 0, 255));
      break;
    case CMD_ROTATION_GAUCHE:
      digitalWrite(IN_1_D, LOW);  digitalWrite(IN_2_D, HIGH);
      digitalWrite(IN_1_G, LOW);  digitalWrite(IN_2_G, HIGH);
      ledcWrite(canalDroit,  constrain(PWR_VIRAGE - correctionDynamique, 0, 255));
      ledcWrite(canalGauche, constrain(PWR_VIRAGE + correctionDynamique, 0, 255));
      break;
    case CMD_ROTATION_DROITE:
      digitalWrite(IN_1_D, HIGH); digitalWrite(IN_2_D, LOW);
      digitalWrite(IN_1_G, HIGH); digitalWrite(IN_2_G, LOW);
      ledcWrite(canalDroit,  constrain(PWR_VIRAGE - correctionDynamique, 0, 255));
      ledcWrite(canalGauche, constrain(PWR_VIRAGE + correctionDynamique, 0, 255));
      break;
    case CMD_VAG:
      digitalWrite(IN_1_D, LOW);  digitalWrite(IN_2_D, HIGH);
      digitalWrite(IN_1_G, HIGH); digitalWrite(IN_2_G, LOW);
      ledcWrite(canalDroit,  PWR_DROIT_AV);
      ledcWrite(canalGauche, constrain(PWR_VIR_FAIBLE - correctionDynamique, 0, 255));
      break;
    case CMD_VAD:
      digitalWrite(IN_1_D, LOW);  digitalWrite(IN_2_D, HIGH);
      digitalWrite(IN_1_G, HIGH); digitalWrite(IN_2_G, LOW);
      ledcWrite(canalDroit,  constrain(PWR_VIR_FAIBLE - correctionDynamique, 0, 255));
      ledcWrite(canalGauche, PWR_GAUCHE_AV);
      break;
    case CMD_VEG:
      digitalWrite(IN_1_D, HIGH); digitalWrite(IN_2_D, LOW);
      digitalWrite(IN_1_G, LOW);  digitalWrite(IN_2_G, HIGH);
      ledcWrite(canalDroit,  PWR_DROIT_AR);
      ledcWrite(canalGauche, constrain(PWR_VIR_FAIBLE - correctionDynamique, 0, 255));
      break;
    case CMD_VED:
      digitalWrite(IN_1_D, HIGH); digitalWrite(IN_2_D, LOW);
      digitalWrite(IN_1_G, LOW);  digitalWrite(IN_2_G, HIGH);
      ledcWrite(canalDroit,  constrain(PWR_VIR_FAIBLE - correctionDynamique, 0, 255));
      ledcWrite(canalGauche, PWR_GAUCHE_AR);
      break;
    case CMD_VIRAGE_PROP:
      // Puissance et sens calculés par le contrôleur P toutes les 10 ms
      if (virageProportionnel_pwr > 0) {
        // Rotation gauche : D en avant, G en arrière
        digitalWrite(IN_1_D, LOW);  digitalWrite(IN_2_D, HIGH);
        digitalWrite(IN_1_G, LOW);  digitalWrite(IN_2_G, HIGH);
        ledcWrite(canalDroit,  virageProportionnel_pwr);
        ledcWrite(canalGauche, virageProportionnel_pwr);
      } else if (virageProportionnel_pwr < 0) {
        // Rotation droite : D en arrière, G en avant
        digitalWrite(IN_1_D, HIGH); digitalWrite(IN_2_D, LOW);
        digitalWrite(IN_1_G, HIGH); digitalWrite(IN_2_G, LOW);
        ledcWrite(canalDroit,  -virageProportionnel_pwr);
        ledcWrite(canalGauche, -virageProportionnel_pwr);
      } else {
        ledcWrite(canalDroit, 0); ledcWrite(canalGauche, 0);
      }
      break;
    default:
      ledcWrite(canalDroit, 0); ledcWrite(canalGauche, 0);
      break;
  }
  digitalWrite(LEDU2, commandeEnCours != CMD_STOP ? HIGH : LOW);
}

