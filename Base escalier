// ============================================================
// SETUP & LOOP
// ============================================================
void setup() {
  Serial.begin(115200);
  pinMode(LEDU1, OUTPUT); pinMode(LEDU2, OUTPUT); digitalWrite(LEDU1, HIGH);
  pinMode(IN_1_D, OUTPUT); pinMode(IN_2_D, OUTPUT);
  pinMode(IN_1_G, OUTPUT); pinMode(IN_2_G, OUTPUT);

  ledcSetup(canalDroit,  freq, resolution); ledcAttachPin(EN_D, canalDroit);
  ledcSetup(canalGauche, freq, resolution); ledcAttachPin(EN_G, canalGauche);

  pinMode(ENC_D_CH_A, INPUT_PULLUP); pinMode(ENC_D_CH_B, INPUT_PULLUP);
  pinMode(ENC_G_CH_A, INPUT_PULLUP); pinMode(ENC_G_CH_B, INPUT_PULLUP);
  attachInterrupt(digitalPinToInterrupt(ENC_D_CH_A), ISR_Droit,  RISING);
  attachInterrupt(digitalPinToInterrupt(ENC_G_CH_A), ISR_Gauche, RISING);

  WiFi.softAP(ssid, password);

  // WebServer port 80 : page HTML uniquement
  server.on("/", handleRoot);
  server.begin();

  // WebSocket port 81 : commandes + positions
  webSocket.begin();
  webSocket.onEvent(onWebSocketEvent);

  Wire.begin(SDA_PIN, SCL_PIN); Wire.setClock(400000);
  initLIS3MDL();
  if (myIMU.begin() == 0) { calibrerGyro(); }

  capGlobal = obtenirCapMagnetometre();
  reinitialiserRepereCartesien();
  tDernierKalman    = millis();
  tDerniereVit      = millis();
  tDerniereOdo      = millis();
  tDernierePosPush  = millis();
}

void loop() {
  webSocket.loop();        // traite les événements WebSocket
  server.handleClient();   // sert la page HTML si besoin
  executerFiltreKalman();
  gererSequence();
  appliquerCommande();
  corrigerPD();
  calculerVitesse();
  mettreAJourOdometrie();
  envoyerPositions();      // push coords toutes les 200 ms
  delay(1);
}
