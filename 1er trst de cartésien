// UTILITAIRES I2C
// writeReg : écrit un octet dans un registre
// read16   : lit 2 octets consécutifs
void writeReg(uint8_t addr, uint8_t reg, uint8_t val) {
  Wire.beginTransmission(addr); //un signal de "départ" à addr
  Wire.write(reg); //Envoie le premier octet : l'adresse du registre interne où l'on veut écrire.
  Wire.write(val); //Envoie le second octet : la donnée que l'on veut stocker.
  Wire.endTransmission(); //Signale la fin de la transaction.
}

//le protocole I2C ne transporte que 8 bits à la fois. On doit donc lire deux octets et les "recoller".
int16_t read16(uint8_t addr, uint8_t reg) {
  Wire.beginTransmission(addr); //Début de la communication avec le composant
  Wire.write(reg | 0x80);   // bit 7 à 1 → auto-incrément d'adresse, permet lire registres suivant sans avoir à redonner l'adresse
  Wire.endTransmission(false); // on envoi un restart
  Wire.requestFrom(addr, (uint8_t)2);
  uint8_t lo = Wire.read(); //On lit le premier octet reçu (le poids faible, LSB)
  uint8_t hi = Wire.read();//On lit le deuxième octet reçu (le poids fort, MSB)
  return (int16_t)(hi << 8 | lo); //On "recolle" les morceaux :
  //On décale l'octet de poids fort de 8 crans vers la gauche (il devient les 8 bits du haut).
  //On fusionne avec l'octet de poids faible (les 8 bits du bas).
}

// INIT MAGNÉTOMÈTRE LIS3MDL
// CTRL1 0x70 : gère vitesse  et performace axe X et Y 
// CTRL2 0x00 : pleine échelle ±4 gauss (+ grosse sensibiltée du champ)
// CTRL3 0x00 : mode de mesure continu
// CTRL4 0x0C : ultra-haute performance Z
void initLIS3MDL() {
  writeReg(LIS3MDL_ADDR, LIS3_CTRL1, 0x70);
  writeReg(LIS3MDL_ADDR, LIS3_CTRL2, 0x00);
  writeReg(LIS3MDL_ADDR, LIS3_CTRL3, 0x00);
  writeReg(LIS3MDL_ADDR, LIS3_CTRL4, 0x0C);
  logf("LIS3MDL initialise\n");
}

// CALCUL DE VITESSE 
//
// Toutes les INTERVALLE_VITESSE_MS ms, on lit les ticks
// accumulés depuis la dernière mesure et on calcule :
//
//   ticks/s  = delta_ticks / dt
//   cm/s     = (ticks/s) × CM_PAR_TICK
//   RPM      = (ticks/s) / TICKS_PAR_TOUR × 60

void calculerVitesse() {
  if (millis() - tDerniereVit < INTERVALLE_VITESSE_MS) return;

  float dt = (millis() - tDerniereVit) / 1000.0;
  tDerniereVit = millis();

  noInterrupts();
  long d = pasDroit;
  long g = pasGauche;
  interrupts();

  float ticksParSecD = (d - pasDroitPrev)  / dt;
  float ticksParSecG = (g - pasGauchePrev) / dt;

  pasDroitPrev  = d;
  pasGauchePrev = g;

  // Conversion en cm/s et RPM
  vitesseDcms = ticksParSecD * CM_PAR_TICK;
  vitesseGcms = ticksParSecG * CM_PAR_TICK;
  vitesseDrpm = ticksParSecD / TICKS_PAR_TOUR * 60.0;
  vitesseGrpm = ticksParSecG / TICKS_PAR_TOUR * 60.0;
}

// FONCTION D'ODOMÉTRIE ET DE LOCALISATION DU STYLO (10ms)
// Calcule précisément le micro-déplacement linéaire du centre via la moyenne des roues
// Projeté en X et Y grâce à l'angle du cap moyen mesuré par la boussole.
void mettreAJourOdometrie() {
  if (millis() - tDerniereOdo < 10) return; 
  tDerniereOdo = millis();

  // 1. Lecture sécurisée des encodeurs
  noInterrupts();
  long actuelsD = pasDroit;
  long actuelsG = pasGauche;
  interrupts();

  // 2. Différence de ticks sur l'intervalle de 10ms
  long deltaTicksD = actuelsD - pasDroitOdoPrev;
  long deltaTicksG = actuelsG - pasGaucheOdoPrev;

  pasDroitOdoPrev  = actuelsD;
  pasGaucheOdoPrev = actuelsG;

  // 3. Conversion du déplacement de chaque roue en cm
  float deltaDDroit  = (float)deltaTicksD * CM_PAR_TICK;
  float deltaDGauche = (float)deltaTicksG * CM_PAR_TICK;

  // 4. Distance réelle parcourue par le CENTRE du robot (Moyenne)
  float deltaDCentre = (deltaDDroit + deltaDGauche) / 2.0;

  // 5. Calcul géométrique du cap moyen durant l'intervalle (Annule l'erreur de virage)
  float angleMoyenDeg = (capGlobalPrev + capGlobal) / 2.0;
  capGlobalPrev = capGlobal; // Sauvegarde pour le cycle suivant

  // Conversion en radians pour la trigonométrie
  float capRad = angleMoyenDeg * PI / 180.0;

  // 6. Accumulation pour obtenir les coordonnées (X, Y) ultra-précises du CENTRE du robot
  Centre_Robot_X += deltaDCentre * cos(capRad);
  Centre_Robot_Y += deltaDCentre * sin(capRad);

  // 7. Déduction géométrique de la coordonnée absolue de la pointe du STYLO
  x_stylo = Centre_Robot_X + DISTANCE_MI_ENTRAXE_STYLO * cos(capRad);
  y_stylo = Centre_Robot_Y + DISTANCE_MI_ENTRAXE_STYLO * sin(capRad);
}

// APPLIQUE LA COMMANDE EN COURS AUX MOTEURS
//
// Chaque commande utilise les constantes adaptées
// à son sens de déplacement (AV ou AR) pour que
// la compensation de vitesse soit correcte dans
// les deux directions.
void appliquerCommande() {

  if (commandeEnCours == "avancer") {
    // Sens AVANT : gauche légèrement réduit (1.5% trop rapide)
    digitalWrite(IN_1_D, LOW);  digitalWrite(IN_2_D, HIGH);
    digitalWrite(IN_1_G, HIGH); digitalWrite(IN_2_G, LOW);
    ledcWrite(canalDroit,  PWR_DROIT_AV);
    ledcWrite(canalGauche, PWR_GAUCHE_AV);

  } else if (commandeEnCours == "reculer") {
    // Sens ARRIÈRE : droite légèrement réduit (6.2% trop rapide)
    digitalWrite(IN_1_D, HIGH); digitalWrite(IN_2_D, LOW);
    digitalWrite(IN_1_G, LOW);  digitalWrite(IN_2_G, HIGH);
    ledcWrite(canalDroit,  PWR_DROIT_AR);
    ledcWrite(canalGauche, PWR_GAUCHE_AR);

  } else if (commandeEnCours == "vag") {
    // VIRAGE AVANT GAUCHE : droite fort, gauche réduit (roue intérieure)
    digitalWrite(IN_1_D, LOW);  digitalWrite(IN_2_D, HIGH);
    digitalWrite(IN_1_G, HIGH); digitalWrite(IN_2_G, LOW);
    ledcWrite(canalDroit,  PWR_DROIT_AV);
    ledcWrite(canalGauche, PWR_FAIBLE);

  } else if (commandeEnCours == "vad") {
    // VIRAGE AVANT DROITE : gauche fort, droite réduit (roue intérieure)
    digitalWrite(IN_1_D, LOW);  digitalWrite(IN_2_D, HIGH);
    digitalWrite(IN_1_G, HIGH); digitalWrite(IN_2_G, LOW);
    ledcWrite(canalDroit,  PWR_FAIBLE);
    ledcWrite(canalGauche, PWR_GAUCHE_AV);

  } else if (commandeEnCours == "veg") {
    // VIRAGE ARRIÈRE GAUCHE : droite recule fort, gauche réduit
    digitalWrite(IN_1_D, HIGH); digitalWrite(IN_2_D, LOW);
    digitalWrite(IN_1_G, LOW);  digitalWrite(IN_2_G, HIGH);
    ledcWrite(canalDroit,  PWR_DROIT_AR);
    ledcWrite(canalGauche, PWR_FAIBLE);

  } else if (commandeEnCours == "ved") {
    // VIRAGE ARRIÈRE DROITE : gauche recule fort, droite réduit
    digitalWrite(IN_1_D, HIGH); digitalWrite(IN_2_D, LOW);
    digitalWrite(IN_1_G, LOW);  digitalWrite(IN_2_G, HIGH);
    ledcWrite(canalDroit,  PWR_FAIBLE);
    ledcWrite(canalGauche, PWR_GAUCHE_AR);

  } else if (commandeEnCours == "rotation_gauche") {
    // ROTATION GAUCHE sur place :
    //   droite avance (PWR_DROIT_AV) / gauche recule (PWR_GAUCHE_AR)
    digitalWrite(IN_1_D, LOW);  digitalWrite(IN_2_D, HIGH);
    digitalWrite(IN_1_G, LOW);  digitalWrite(IN_2_G, HIGH);
    ledcWrite(canalDroit,  PWR_DROIT_AV);
    ledcWrite(canalGauche, PWR_GAUCHE_AR);

  } else if (commandeEnCours == "rotation_droite") {
    // ROTATION DROITE sur place :
    //   gauche avance (PWR_GAUCHE_AV) / droite recule (PWR_DROIT_AR)
    digitalWrite(IN_1_D, HIGH); digitalWrite(IN_2_D, LOW);
    digitalWrite(IN_1_G, HIGH); digitalWrite(IN_2_G, LOW);
    ledcWrite(canalDroit,  PWR_DROIT_AR);
    ledcWrite(canalGauche, PWR_GAUCHE_AV);

  } else {
    // STOP : coupe complètement les deux moteurs
    ledcWrite(canalDroit,  0);
    ledcWrite(canalGauche, 0);
  }

  // LED2 allumée si un moteur tourne, éteinte si arrêt
  digitalWrite(LEDU2, commandeEnCours != "stop" ? HIGH : LOW);
}



// Reçoit une commande depuis le navigateur
// Met à jour commandeEnCours
void handleCmd() {
  if (server.hasArg("action")) {
    String nouvelleCommande = server.arg("action");

    // Reset seulement quand on change de mouvement
    if (nouvelleCommande != commandeEnCours) {
      noInterrupts();
      pasDroit  = 0;
      pasGauche = 0;
      interrupts();
      ecartPrecedent = 0;
    }

    commandeEnCours = nouvelleCommande;
    logf("Commande : %s\n", commandeEnCours.c_str());
  }
  server.send(200, "text/plain", "ok");
}

// Retourne le cap calibré en JSON 
// Applique les offsets et scales mesurés lors de la calibration fait dans un autre code
// -ny corrige l'inversion physique de l'axe Y du LIS3MDL
void handleCap() {
  int16_t mx = read16(LIS3MDL_ADDR, LIS3_OUT_X_L); //on lit le registre de x
  int16_t my = read16(LIS3MDL_ADDR, LIS3_OUT_X_L + 2); //on lit le registre de y ( vu que c'est deux octets + loin on fait + 2)

  // Application de la calibration hard iron + soft iron
  float nx = (mx - CALIB_X_OFFSET) / CALIB_X_SCALE; //on soustrait l'offset calculé dans un autre code
  float ny = (my - CALIB_Y_OFFSET) / CALIB_Y_SCALE; // on divise par scale, qui est la différence de si on veut tracer un cercle parfait entre x et y

  // atan2 donne un angle entre -π et +π → on ramène à 0°-360°
  float capRad = atan2(-ny, nx);
  int cap = (int)(capRad * 180.0 / PI);
  if (cap < 0) cap += 360;

  // Mise à jour de la boussole globale lue en arrière-plan
  capGlobal = (float)cap; 

  //envoi de la réponse au web
  server.send(200, "application/json", "{\"cap\":" + String(cap) + "}");
}

// Retourne les vitesses des deux roues en cm/s et RPM (/vitesse)
// Les valeurs sont calculées dans calculerVitesse() dans le loop()
// et simplement lues ici pour les renvoyer au GUI.
void handleVitesse() {
  char json[120];
  snprintf(json, sizeof(json),
    "{\"dcms\":%.1f,\"gcms\":%.1f,\"drpm\":%.1f,\"grpm\":%.1f}",
    vitesseDcms, vitesseGcms, vitesseDrpm, vitesseGrpm);
  server.send(200, "application/json", json);
}

// Retourne les ticks des deux encodeurs (/ticks)
// noInterrupts/interrupts : lecture atomique pour
// éviter une valeur à moitié mise à jour si une
// interruption survient pendant la lecture.
void handleTicks() {
  noInterrupts();
  long d = pasDroit;
  long g = pasGauche;
  interrupts();
  String json = "{\"droite\":" + String(d) +
                ",\"gauche\":" + String(g) + "}";
  server.send(200, "application/json", json);
}

// Remet les deux compteurs à zéro (/ticks/reset)
// Appelé par le bouton "Remettre à zéro" du GUI.
void handleTicksReset() {
  noInterrupts();
  pasDroit  = 0;
  pasGauche = 0;
  interrupts();
  pasDroitPrev  = 0;
  pasGauchePrev = 0;
  pasDroitOdoPrev  = 0;
  pasGaucheOdoPrev = 0;
  logf("Ticks remis a zero\n");
  server.send(200, "text/plain", "ok");
}

void setup() {
  Serial.begin(115200);
  delay(200);

  // LEDs : LED1 allumée dès le démarrage
  pinMode(LEDU1, OUTPUT); pinMode(LEDU2, OUTPUT);
  digitalWrite(LEDU1, HIGH);
  digitalWrite(LEDU2, LOW);

  // Moteurs : pins de direction en sortie + canaux PWM
  pinMode(IN_1_D, OUTPUT); pinMode(IN_2_D, OUTPUT);
  pinMode(IN_1_G, OUTPUT); pinMode(IN_2_G, OUTPUT);
  ledcSetup(canalDroit,  freq, resolution); ledcAttachPin(EN_D, canalDroit);
  ledcSetup(canalGauche, freq, resolution); ledcAttachPin(EN_G, canalGauche);

  // Encodeurs : INPUT_PULLUP évite les fausses lectures ( active une résistance interne aux hypersensibilitées)
  pinMode(ENC_D_CH_A, INPUT_PULLUP);
  pinMode(ENC_G_CH_A, INPUT_PULLUP);
  attachInterrupt(digitalPinToInterrupt(ENC_D_CH_A), ISR_Droit,  RISING);
  attachInterrupt(digitalPinToInterrupt(ENC_G_CH_A), ISR_Gauche, RISING);

  // WiFi démarre
  WiFi.softAP(ssid, password);

  // Telnet : Serial Monitor sans fil
  telnetServer.begin();
  telnetServer.setNoDelay(true);


  // I2C + magnétomètre
  Wire.begin(SDA_PIN, SCL_PIN);
  Wire.setClock(400000);
  initLIS3MDL();

  // Forcer une première lecture de la boussole pour initialiser le cap avant l'odométrie
  handleCap();
  capGlobalPrev = capGlobal;

  tDerniereVit = millis();
  tDerniereOdo = millis();

  // Enregistrement des liens pour le bon fonctionnement du serveur Web
  server.on("/cmd", handleCmd);
  server.on("/cap", handleCap);
  server.on("/vitesse", handleVitesse);
  server.on("/ticks", handleTicks);
  server.on("/ticks/reset", handleTicksReset);
  server.begin();

  logf("Calibration chargee :\n");
  logf("  xOffset=%.1f  yOffset=%.1f\n", CALIB_X_OFFSET, CALIB_Y_OFFSET);
  logf("  xScale=%.1f   yScale=%.1f\n",  CALIB_X_SCALE,  CALIB_Y_SCALE);
  logf("GUI dispo sur : http://192.168.4.1\n");
  logf("Telnet        : socket://192.168.4.1:23\n\n");

  // LED2 clignote une fois pour signaler setup terminé
  digitalWrite(LEDU2, HIGH);
  delay(300);
  digitalWrite(LEDU2, LOW);
}

void loop() {
  server.handleClient();
  ArduinoOTA.handle();
  checkTelnet();
  
  // Lecture continue de la boussole pour alimenter l'odométrie avec les angles réels les plus récents
  handleCap(); 

  appliquerCommande();
  corrigerPD();       // s'exécute toutes les 10ms
  calculerVitesse();  // s'exécute toutes les 200ms
  
  // Calcule la position millimétrée (X, Y) du robot et du stylo en temps réel
  mettreAJourOdometrie(); 
}
