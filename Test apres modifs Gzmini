const uint32_t TIMEOUT_SEQ_MS = 25000;// securite globale

const float KP_A    = 80.0;   // correction d'angle (rad -> pwm)
const float CA_MAX  = 150.0;   // bride la correction d'angle
const float VCRUISE = 150.0;   // vitesse d'avance constante (monter = + de pousse)
