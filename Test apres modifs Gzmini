  <div class="seq-status">Séquence : <b id="seq-etat">inactive</b></div>
  <div class="cap-box">
    <span class="data-label">🧭 CAP gyro (°)</span>
    <span class="data-val cap" id="cap-val">—</span>
  </div>
  <div class="data-box">
    <h2 style="color:#f0f; font-size:0.9rem;">📍 COORDONNÉES (mm)</h2>
    <div class="data-grid">
      <span class="data-label">Robot X</span> <span class="data-val robot" id="rob-x">—</span>
      <span class="data-label">Robot Y</span> <span class="data-val robot" id="rob-y">—</span>
      <span class="data-label">Stylo X</span> <span class="data-val stylo" id="sty-x">—</span>
      <span class="data-label">Stylo Y</span> <span class="data-val stylo" id="sty-y">—</span>
    </div>
  </div>
  <script>
    function send(cmd) { fetch('/cmd?action=' + cmd).catch(() => {}); }
    document.querySelectorAll('.grid .btn').forEach(btn => {
      const cmd = btn.dataset.cmd;
      btn.addEventListener('touchstart', e => { e.preventDefault(); btn.classList.add('pressed'); send(cmd); }, { passive: false });
      btn.addEventListener('touchend', e => { e.preventDefault(); btn.classList.remove('pressed'); send('stop'); });
      btn.addEventListener('mousedown', e => { e.preventDefault(); btn.classList.add('pressed'); send(cmd); });
      btn.addEventListener('mouseup', () => { btn.classList.remove('pressed'); send('stop'); });
    });
    document.getElementById('btn-cart-reset').addEventListener('click', () => { fetch('/cartesian/reset'); });
    document.getElementById('btn-escalier').addEventListener('click', () => { fetch('/sequence/escalier'); });
    setInterval(async () => {
      try {
        const r = await fetch('/pos'); const d = await r.json();
        document.getElementById('cap-val').textContent = d.cap.toFixed(1);
        document.getElementById('rob-x').textContent = d.rx.toFixed(1);
        document.getElementById('rob-y').textContent = d.ry.toFixed(1);
        document.getElementById('sty-x').textContent = d.sx.toFixed(1);
        document.getElementById('sty-y').textContent = d.sy.toFixed(1);
        const e = document.getElementById('seq-etat');
        const b = document.getElementById('btn-escalier');
        if (d.seq) { e.textContent = 'EN COURS (pt ' + (d.seqpt + 1) + '/' + d.seqn + ')'; b.classList.add('running'); }
        else { e.textContent = 'inactive'; b.classList.remove('running'); }
      } catch(e) {}
    }, 150);
  </script>
</body>
</html>
)rawhtml";

void handleRoot() { server.send_P(200, "text/html", PAGE_HTML); }

void handleCmd() {
  if (server.hasArg("action")) {
    sequenceActive = false;     // tout bouton manuel coupe l'autopilote
    definirCommande(server.arg("action"));
  }
  server.send(200, "text/plain", "ok");
}

void handlePositions() {
  float robX, robY, styX, styY;
  if (ECHANGER_AFFICHAGE) {
    robX = Centre_Robot_Y * 10.0;  robY = Centre_Robot_X * 10.0;
    styX = y_stylo        * 10.0;  styY = x_stylo        * 10.0;
  } else {
    robX = Centre_Robot_X * 10.0;  robY = Centre_Robot_Y * 10.0;
    styX = x_stylo        * 10.0;  styY = y_stylo        * 10.0;
  }

  // CAP affiche = cap GYRO (celui qui pilote), en degres [-180,180].
  // VERIFICATIONS :
  //  - pousser le robot tout droit -> Stylo X augmente, Stylo Y ~constant ;
  //  - faire tourner le robot 360 deg REEL -> ce CAP doit afficher ~360 (ou -360).
  //    Si non, ajuster GYRO_SCALE_CORR = 360 / (valeur lue). Si sens inverse,
  //    passer INVERSER_GYRO a true.
  float capDeg = capGyroRad * 180.0 / PI;
  while (capDeg > 180.0)  capDeg -= 360.0;
  while (capDeg < -180.0) capDeg += 360.0;

  char json[220];
  snprintf(json, sizeof(json),
    "{\"rx\":%.2f,\"ry\":%.2f,\"sx\":%.2f,\"sy\":%.2f,\"cap\":%.1f,\"seq\":%d,\"seqpt\":%d,\"seqn\":%d}",
    robX, robY, styX, styY, capDeg, sequenceActive ? 1 : 0, wpIndex, wpCount);
  server.send(200, "application/json", json);
}

void handleCartesianReset() { reinitialiserRepereCartesien(); server.send(200, "text/plain", "ok"); }

void handleSequenceEscalier() { demarrerSequenceEscalier(); server.send(200, "text/plain", "ok"); }

void appliquerCommande() {
  if (commandeEnCours == "avancer") {
    digitalWrite(IN_1_D, LOW);  digitalWrite(IN_2_D, HIGH);
    digitalWrite(IN_1_G, HIGH); digitalWrite(IN_2_G, LOW);
    ledcWrite(canalDroit,  constrain(PWR_DROIT_AV - correctionDynamique, 0, 255));
    ledcWrite(canalGauche, constrain(PWR_GAUCHE_AV + correctionDynamique, 0, 255));
  }
  else if (commandeEnCours == "reculer") {
    digitalWrite(IN_1_D, HIGH); digitalWrite(IN_2_D, LOW);
    digitalWrite(IN_1_G, LOW);  digitalWrite(IN_2_G, HIGH);
    ledcWrite(canalDroit,  constrain(PWR_DROIT_AR - correctionDynamique, 0, 255));
    ledcWrite(canalGauche, constrain(PWR_GAUCHE_AR + correctionDynamique, 0, 255));
  }
  else if (commandeEnCours == "rotation_gauche") {
    digitalWrite(IN_1_D, LOW);  digitalWrite(IN_2_D, HIGH);
    digitalWrite(IN_1_G, LOW);  digitalWrite(IN_2_G, HIGH);
    ledcWrite(canalDroit,  constrain(PWR_VIRAGE - correctionDynamique, 0, 255));
    ledcWrite(canalGauche, constrain(PWR_VIRAGE + correctionDynamique, 0, 255));
  }
  else if (commandeEnCours == "rotation_droite") {
    digitalWrite(IN_1_D, HIGH); digitalWrite(IN_2_D, LOW);
    digitalWrite(IN_1_G, HIGH); digitalWrite(IN_2_G, LOW);
    ledcWrite(canalDroit,  constrain(PWR_VIRAGE - correctionDynamique, 0, 255));
    ledcWrite(canalGauche, constrain(PWR_VIRAGE + correctionDynamique, 0, 255));
  }
  else if (commandeEnCours == "vag") {
    digitalWrite(IN_1_D, LOW);  digitalWrite(IN_2_D, HIGH);
    digitalWrite(IN_1_G, HIGH); digitalWrite(IN_2_G, LOW);
    ledcWrite(canalDroit,  PWR_DROIT_AV);
    ledcWrite(canalGauche, constrain(PWR_VIR_FAIBLE - correctionDynamique, 0, 255));
  }
  else if (commandeEnCours == "vad") {
    digitalWrite(IN_1_D, LOW);  digitalWrite(IN_2_D, HIGH);
    digitalWrite(IN_1_G, HIGH); digitalWrite(IN_2_G, LOW);
    ledcWrite(canalDroit,  constrain(PWR_VIR_FAIBLE - correctionDynamique, 0, 255));
    ledcWrite(canalGauche, PWR_GAUCHE_AV);
  }
  else if (commandeEnCours == "veg") {
    digitalWrite(IN_1_D, HIGH); digitalWrite(IN_2_D, LOW);
    digitalWrite(IN_1_G, LOW);  digitalWrite(IN_2_G, HIGH);
    ledcWrite(canalDroit,  PWR_DROIT_AR);
    ledcWrite(canalGauche, constrain(PWR_VIR_FAIBLE - correctionDynamique, 0, 255));
  }
  else if (commandeEnCours == "ved") {
    digitalWrite(IN_1_D, HIGH); digitalWrite(IN_2_D, LOW);
    digitalWrite(IN_1_G, LOW);  digitalWrite(IN_2_G, HIGH);
    ledcWrite(canalDroit,  constrain(PWR_VIR_FAIBLE - correctionDynamique, 0, 255));
    ledcWrite(canalGauche, PWR_GAUCHE_AR);
  }
  else {
    ledcWrite(canalDroit,  0); ledcWrite(canalGauche, 0);
  }
  digitalWrite(LEDU2, commandeEnCours != "stop" ? HIGH : LOW);
}

void setup() {
  Serial.begin(115200);
  pinMode(LEDU1, OUTPUT); pinMode(LEDU2, OUTPUT); digitalWrite(LEDU1, HIGH);
  pinMode(IN_1_D, OUTPUT); pinMode(IN_2_D, OUTPUT);
  pinMode(IN_1_G, OUTPUT); pinMode(IN_2_G, OUTPUT);
  ledcSetup(canalDroit,  freq, resolution); ledcAttachPin(EN_D, canalDroit);
  ledcSetup(canalGauche, freq, resolution); ledcAttachPin(EN_G, canalGauche);

  // Encodeurs : interruption legere voie A (front montant) pour pasDroit/pasGauche.
  pinMode(ENC_D_CH_A, INPUT_PULLUP); pinMode(ENC_G_CH_A, INPUT_PULLUP);
  attachInterrupt(digitalPinToInterrupt(ENC_D_CH_A), ISR_Droit,  RISING);
  attachInterrupt(digitalPinToInterrupt(ENC_G_CH_A), ISR_Gauche, RISING);

  WiFi.softAP(ssid, password);
  server.on("/", handleRoot);
  server.on("/cmd", handleCmd);
  server.on("/pos", handlePositions);
  server.on("/cartesian/reset", handleCartesianReset);
  server.on("/sequence/escalier", handleSequenceEscalier);
  server.begin();

  Wire.begin(SDA_PIN, SCL_PIN); Wire.setClock(400000);
  initLIS3MDL();

  myIMU.settings.gyroRange      = 245;   // doit correspondre a GYRO_SENS_MDPS_LSB (8.75)
  myIMU.settings.gyroSampleRate = 416;
  myIMU.settings.gyroBandWidth  = 200;
  if (myIMU.begin() == 0) { calibrerGyro(); }

  capGlobal = obtenirCapMagnetometre();
  reinitialiserRepereCartesien();
  tDernierKalman = millis(); tDerniereVit = millis();
  tDerniereOdo = millis();   tDernierGyro = millis();
}

void loop() {
  server.handleClient();
  executerFiltreKalman();     // magneto/Kalman : seulement hors sequence (affichage)
  calculerVitesse();
  mettreAJourOdometrie();     // cap gyro + pose (toujours)

  if (sequenceActive) {
    gererSequenceEscalier();
  } else {
    appliquerCommande();
    corrigerPD();
  }
}
