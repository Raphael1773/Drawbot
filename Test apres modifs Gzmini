void writeReg(uint8_t addr, uint8_t reg, uint8_t val) {
  Wire.beginTransmission(addr); Wire.write(reg); Wire.write(val); Wire.endTransmission();
}

int16_t read16(uint8_t addr, uint8_t reg) {
  Wire.beginTransmission(addr); Wire.write(reg | 0x80); Wire.endTransmission(false);
  Wire.requestFrom(addr, (uint8_t)2);
  return (int16_t)(Wire.read() | (Wire.read() << 8));
}

void initLIS3MDL() {
  writeReg(LIS3MDL_ADDR, LIS3_CTRL1, 0x7E);
  writeReg(LIS3MDL_ADDR, LIS3_CTRL2, 0x00);
  writeReg(LIS3MDL_ADDR, LIS3_CTRL3, 0x00);
  writeReg(LIS3MDL_ADDR, LIS3_CTRL4, 0x0C);
}

// Estimation du biais gyro (robot IMMOBILE). Appelee au boot ET au lancement
// de la sequence (le robot est pose et immobile a ce moment-la).
void calibrerGyro() {
  long somme = 0;
  int nbEchantillons = 1000; // Plus de points pour stabiliser le biais
  Serial.println("Calibration Gyro... NE PAS BOUGER");
  for (int i = 0; i < nbEchantillons; i++) { 
    somme += myIMU.readRawGyroZ(); 
    delay(2); 
  }
  gyroBiasZ = (float)somme / (float)nbEchantillons;
  Serial.print("Biais calculé : "); Serial.println(gyroBiasZ);
}

float obtenirCapMagnetometre() {
  int16_t mx = read16(LIS3MDL_ADDR, LIS3_OUT_X_L);
  int16_t my = read16(LIS3MDL_ADDR, LIS3_OUT_X_L + 2);
  float nx = (mx - CALIB_X_OFFSET) / CALIB_X_SCALE;
  float ny = (my - CALIB_Y_OFFSET) / CALIB_Y_SCALE;
  float cap = atan2(-ny, nx) * 180.0 / PI;
  if (cap < 0) cap += 360.0;
  if (INVERSER_CAP) cap = 360.0 - cap;
  return cap;
}

// Kalman magneto/gyro : conserve UNIQUEMENT pour l'affichage hors sequence.
// Desactive pendant la sequence (le magneto pollue serait nuisible + charge I2C).
void executerFiltreKalman() {
  if (sequenceActive) return;
  uint32_t maintenant = millis();
  float dt = (maintenant - tDernierKalman) / 1000.0f;
  if (dt < 0.02f) return;          // ralenti a ~50 Hz pour ne pas surcharger
  tDernierKalman = maintenant;

  float gyroCorrige = myIMU.readRawGyroZ() - gyroBiasZ;
  float w = gyroCorrige * GYRO_SENS_MDPS_LSB / 1000.0f;
  if (INVERSER_GYRO) w = -w;
  capGlobal = fKalman.update(obtenirCapMagnetometre(), w, dt);
}

// Lecture + integration du cap GYRO (avec verifications). dt en secondes.
void majCapGyro(float dt) {
  float raw = (float)myIMU.readRawGyroZ() - gyroBiasZ;
  float dps = raw * GYRO_SENS_MDPS_LSB / 1000.0f;     // deg/s
  if (fabs(dps) > GYRO_MAX_DPS)      dps = 0.0f;      // rejet pic aberrant
  if (fabs(dps) < GYRO_DEADBAND_DPS) dps = 0.0f;      // anti-derive au repos
  dps *= GYRO_SCALE_CORR;
  if (INVERSER_GYRO) dps = -dps;
  capGyroRad += dps * (float)PI / 180.0f * dt;
}

void reinitialiserRepereCartesien() {
  noInterrupts();
  pasDroit = 0; pasGauche = 0;
  interrupts();

  capGyroRad = 0.0;                 // cap gyro : 0 = oriente vers +X

  float capActuelBrut = obtenirCapMagnetometre();
  fKalman.angle = capActuelBrut;
  fKalman.bias = 0.0f;
  capGlobal = capActuelBrut;
  capInitialAuReset = capActuelBrut;
  capGlobalPrev = capGlobal;

  pasDroitPrev = 0; pasGauchePrev = 0;
  odoPasDprev = 0;  odoPasGprev = 0;

  Centre_Robot_X = -DISTANCE_MI_ENTRAXE_STYLO;
  Centre_Robot_Y = 0.0;
  x_stylo = 0.0; y_stylo = 0.0;
}

void definirCommande(const String& c) {
  if (c != commandeEnCours) {
    noInterrupts(); pasDroit = 0; pasGauche = 0; interrupts();
    ecartPrecedent = 0; correctionDynamique = 0;
  }
  commandeEnCours = c;
}

void moteurDroite(float v) {
  if (v >= 0) { digitalWrite(IN_1_D, LOW);  digitalWrite(IN_2_D, HIGH); }
  else        { digitalWrite(IN_1_D, HIGH); digitalWrite(IN_2_D, LOW);  }
  ledcWrite(canalDroit, constrain((int)fabs(v), 0, 255));
}
void moteurGauche(float v) {
  if (v >= 0) { digitalWrite(IN_1_G, HIGH); digitalWrite(IN_2_G, LOW);  }
  else        { digitalWrite(IN_1_G, LOW);  digitalWrite(IN_2_G, HIGH); }
  ledcWrite(canalGauche, constrain((int)fabs(v), 0, 255));
}
void arreterMoteurs() {
  ledcWrite(canalDroit, 0); ledcWrite(canalGauche, 0);
}

float normRad(float a) {
  while (a >  PI) a -= 2 * PI;
  while (a < -PI) a += 2 * PI;
  return a;
}

void construireWaypoints() {
  wpCount = 0;
  for (int s = 0; s < NB_COINS - 1; s++) {
    float ax = COIN_X_CM[s],     ay = COIN_Y_CM[s];
    float bx = COIN_X_CM[s + 1], by = COIN_Y_CM[s + 1];
    if (ECHANGER_CIBLES) { float t; t = ax; ax = ay; ay = t; t = bx; bx = by; by = t; }
    float seg = sqrt((bx - ax) * (bx - ax) + (by - ay) * (by - ay));
    int n = (int)(seg / PAS_WP_CM);
    if (n < 1) n = 1;
    for (int i = 1; i <= n && wpCount < MAX_WP; i++) {
      float t = (float)i / (float)n;
      wpX[wpCount] = ax + (bx - ax) * t;
      wpY[wpCount] = ay + (by - ay) * t;
      wpCoin[wpCount] = (i == n);
      wpCount++;
    }
  }
}

void demarrerSequenceEscalier() {
  arreterMoteurs();
  calibrerGyro();                 // re-estime le biais gyro (robot immobile au lancement)
  reinitialiserRepereCartesien();
  construireWaypoints();
  wpIndex = 0;
  tDebutSeq = millis();
  tDerniereSeqCorr = millis();
  tDernierGyro = millis();
  sequenceActive = (wpCount > 0);
}

void arreterSequence() {
  sequenceActive = false;
  arreterMoteurs();
  definirCommande("stop");
}

// Poursuite referencee STYLO + lookahead, avance a vitesse constante.
// Braquage sur le cap GYRO (capGyroRad). On ne pivote JAMAIS sur place.
void gererSequenceEscalier() {
  if (!sequenceActive) return;

  if (millis() - tDebutSeq > TIMEOUT_SEQ_MS) { arreterSequence(); return; }

  // 1. Validation de la progression par le STYLO
  float distAuPoint = hypot(wpX[wpIndex] - x_stylo, wpY[wpIndex] - y_stylo);
  
  // Si on est à moins de 1cm (10mm) du point, on passe au suivant
  if (distAuPoint < ARRIVE_CM) {
    if (wpIndex < wpCount - 1) wpIndex++;
    else { arreterSequence(); return; }
  }

  if (millis() - tDerniereSeqCorr < 10) return;
  tDerniereSeqCorr = millis();

  // 2. Visée depuis le CENTRE (pour éviter le balancement de 12.7cm)
  int la = wpIndex + 8; // Lookahead de 4cm pour anticiper le virage
  if (la > wpCount - 1) la = wpCount - 1;

  float dx = wpX[la] - Centre_Robot_X;
  float dy = wpY[la] - Centre_Robot_Y;
  
  float consigneAngle = atan2(dy, dx);
  float errAngle = normRad(consigneAngle - capGyroRad);

  // 3. Correction d'angle
  float corrAngle = constrain(KP_A * errAngle, -CA_MAX, CA_MAX);
  
  // Ralentissement en virage pour plus de précision
  float vVoulue = (abs(errAngle) > 0.15) ? VCRUISE * 0.8 : VCRUISE;

  moteurGauche(constrain(vVoulue - corrAngle, -VMAX_SEQ, VMAX_SEQ));
  moteurDroite(constrain(vVoulue + corrAngle, -VMAX_SEQ, VMAX_SEQ));
}

void corrigerPD() {
  if (commandeEnCours == "stop") { correctionDynamique = 0; return; }
  if (millis() - tDerniereCorr < 10) return;
  tDerniereCorr = millis();

  noInterrupts(); long tD = pasDroit; long tG = pasGauche; interrupts();

  long ecart = 0;
  float kp_actuel = Kp;
  float kd_actuel = Kd;

  if (commandeEnCours == "avancer" || commandeEnCours == "reculer") {
    ecart = tD - tG; kp_actuel = Kp; kd_actuel = Kd;
  }
  else if (commandeEnCours == "rotation_gauche" || commandeEnCours == "rotation_droite") {
    ecart = abs(tD) - abs(tG); kp_actuel = Kp_rotation; kd_actuel = Kd_rotation;
  }
  else if (commandeEnCours == "vag") { ecart = tG - (long)(tD * RATIO_VIRAGE); }
  else if (commandeEnCours == "vad") { ecart = tD - (long)(tG * RATIO_VIRAGE); }
  else if (commandeEnCours == "veg") { ecart = abs(tG) - (long)(abs(tD) * RATIO_VIRAGE); }
  else if (commandeEnCours == "ved") { ecart = abs(tD) - (long)(abs(tG) * RATIO_VIRAGE); }

  correctionDynamique = (int)((ecart * kp_actuel) + ((ecart - ecartPrecedent) * kd_actuel));
  ecartPrecedent = ecart;
}

void calculerVitesse() {
  if (millis() - tDerniereVit < INTERVALLE_VITESSE_MS) return;
  float dt = (millis() - tDerniereVit) / 1000.0; tDerniereVit = millis();
  noInterrupts(); long d = pasDroit; long g = pasGauche; interrupts();
  vitesseDcms = ((d - pasDroitPrev) / dt) * CM_PAR_TICK;
  vitesseGcms = ((g - pasGauchePrev) / dt) * CM_PAR_TICK;
  pasDroitPrev  = d; pasGauchePrev = g;
}

// Odometrie : cap = GYRO integre ; distance = encodeurs voie A. ~100 Hz.
void mettreAJourOdometrie() {
  uint32_t now = millis();
  if (now - tDerniereOdo < 10) return;
  float dt = (now - tDerniereOdo) / 1000.0f;
  tDerniereOdo = now;

  // 1) Cap : integration gyro (lecture ralentie a 100 Hz)
  majCapGyro(dt);

  // 2) Distance : deltas des compteurs voie A (magnitude = avance)
  noInterrupts(); long pd = pasDroit; long pg = pasGauche; interrupts();
  long dPd = pd - odoPasDprev; long dPg = pg - odoPasGprev;
  odoPasDprev = pd; odoPasGprev = pg;

  float distD = (float)dPd * CM_PAR_TICK;
  float distG = (float)dPg * CM_PAR_TICK;
  float deltaDCentre = (distD + distG) / 2.0;

  // 3) Integration de la pose avec le cap gyro
  Centre_Robot_X += deltaDCentre * cos(capGyroRad);
  Centre_Robot_Y += deltaDCentre * sin(capGyroRad);

  x_stylo = Centre_Robot_X + DISTANCE_MI_ENTRAXE_STYLO * cos(capGyroRad);
  y_stylo = Centre_Robot_Y + DISTANCE_MI_ENTRAXE_STYLO * sin(capGyroRad);
}

