// ============================================================================
//   DEPLACEMENT  —  allerAuPoint : bloque jusqu'a ce que le stylo atteigne un point
// ============================================================================

// Asservit en boucle jusqu'a ce que le stylo soit sur (consignex, consigney), puis arrete.
// Asservit en boucle jusqu'a ce que le stylo soit sur (consignex, consigney), puis arrete.
int allerAuPoint(int consignex, int consigney) {
  // Cap COMMANDE (direction visee) capture AVANT de bouger
  float capCommande = normaliserAngle(atan2(consigney - robotY, consignex - robotX));
  long tempsdarret = millis();                       // horodatage pour la condition d'arret
  while (millis() - tempsdarret < tempsdarretfin) {  // tant qu'on n'est pas reste assez longtemps sur la cible
    Serial.println("Moving...");                     // debug

    calculerPositionStylo();                         // met a jour la position estimee du stylo

    asservirVersPoint(consignex, consigney);         // une iteration de l'asservissement
    digitalWrite(LEDU2, estDansArcDeDisque(consignex,consigney));  // LED2 : point dans la zone proche

    if (!(abs(posstyloX - consignex) < mindistancedupoint && abs(posstyloY - consigney) < mindistancedupoint)) {  // si pas encore arrive
      tempsdarret = millis();                        // ... on relance le chrono
      digitalWrite(LEDU1, LOW);                      // LED1 eteinte (pas arrive)
    }
    else{                                            // sinon (dans la tolerance)
      digitalWrite(LEDU1, HIGH);                     // LED1 allumee (arrive)
    }
    delayMicroseconds(10);                           // petite pause de boucle
  }

  analogWrite(IN_1_G, 0);                            // stoppe la roue gauche
  analogWrite(IN_2_G, 0);                            // ...
  analogWrite(IN_1_D, 0);                            // stoppe la roue droite
  analogWrite(IN_2_D, 0);                            // ...

  // --- Teleplot : UN seul echantillon, une fois le point atteint ---
// --- Teleplot : un seul echantillon, une fois le point atteint ---
  calculerPositionStylo();

  // Graphe 1 : ell_mes (ordonnee) EN FONCTION DE ell_th (abscisse), en cm
  float ell_th  = sqrt((float)consignex*consignex + (float)consigney*consigney) / 10.0;
  float ell_mes = sqrt(posstyloX*posstyloX + posstyloY*posstyloY) / 10.0;
  teleplotXY("ell", ell_th, ell_mes);

  // Graphe 2 : theta_mes (ordonnee) EN FONCTION DE theta_th (abscisse), en degres
  float theta_th  = capCommande * RAD_TO_DEG;
  float theta_mes = normaliserAngle(anglerobot) * RAD_TO_DEG;
  teleplotXY("theta", theta_th, theta_mes);

  // Graphe 3 : cap (ordonnee) EN FONCTION DU TEMPS + la consigne (bande grise)
  teleplotT("cap",          theta_mes);
  teleplotT("cap_consigne", theta_th);
  return 0;                                          // termine
}


