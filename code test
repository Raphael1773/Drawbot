// Calibration hard iron du magnetometre : fait tourner le robot et releve
// les min/max de mx et my pendant ~12 s. A lancer une fois, robot loin du metal.
void calibrerMagnetometre(){
  float mxMin = 99999, mxMax = -99999;
  float myMin = 99999, myMax = -99999;

  long debut = millis();
  // fait tourner le robot sur place pendant la mesure
  commanderMoteurGauche(-PWM_MIN);
  commanderMoteurDroit(PWM_MIN);

  while (millis() - debut < 12000) {     // 12 s de rotation
    lis3mdl.read();
    float mx = lis3mdl.x;
    float my = lis3mdl.y;
    if (mx < mxMin) mxMin = mx;
    if (mx > mxMax) mxMax = mx;
    if (my < myMin) myMin = my;
    if (my > myMax) myMax = my;
    delay(20);
  }
  commanderMoteurGauche(0);
  commanderMoteurDroit(0);

  // centre de l'ellipse = offset hard iron
  float offsetX = (mxMax + mxMin) / 2.0;
  float offsetY = (myMax + myMin) / 2.0;

  Serial.println("=== CALIBRATION MAGNETO ===");
  Serial.print("mxMin="); Serial.print(mxMin); Serial.print(" mxMax="); Serial.println(mxMax);
  Serial.print("myMin="); Serial.print(myMin); Serial.print(" myMax="); Serial.println(myMax);
  Serial.print("offsetX="); Serial.println(offsetX);
  Serial.print("offsetY="); Serial.println(offsetY);
  Serial.print("echelleX="); Serial.println((mxMax-mxMin)/2.0);
  Serial.print("echelleY="); Serial.println((myMax-myMin)/2.0);
}

void AllerAuNord(){
  const float tolerance = 0.20;          // ~11 deg (plus large)
  const float offsetNord = -210.0 * PI / 180.0;  // = -230 deg
  long debut = millis();
  while (millis() - debut < 8000) {
    calculerPositionStylo();
    float cap = normaliserAngle(lireAngleNord() + offsetNord);

    Serial.print("cap (deg) : ");        // <-- debug, pour voir ce qui se passe
    Serial.println(cap * 180.0 / PI);

    if (fabs(cap) < tolerance) break;    // dans la zone -> on sort

    if (cap > 0) {
      commanderMoteurGauche(-PWM_MIN);
      commanderMoteurDroit(PWM_MIN);
    } else {
      commanderMoteurGauche(PWM_MIN);
      commanderMoteurDroit(-PWM_MIN);
    }
    delay(40);                            // un peu plus lent (40 au lieu de 20)
  }
  commanderMoteurGauche(0);
  commanderMoteurDroit(0);
}

void tracerBoussole(float rayon, float angle){
  float cx = posstyloX;
  float cy = posstyloY;
  float angleDepart = anglerobot;       // <-- part dans la direction ACTUELLE du robot (= Nord apres AllerAuNord)
  const float inc = PI / 4;

  for (int i = 0; i < 8; i++) {
    float a = angleDepart + i * inc;    // branches a partir du cap courant
    float r = (i % 2 == 0) ? rayon : rayon * 0.6;
    float bx = cx + r * cos(a);
    float by = cy + r * sin(a);
    tracerSegment(cx, cy, bx, by);
    tracerSegment(bx, by, cx, cy);
  }
}
// Version instrumentee de tracerBoussole : trace la rose ET envoie a Teleplot
// la longueur moyenne mesuree (L_mes vs L_th) et l'erreur d'orientation au Nord.
void tracerBoussoleTeleplot(float rayon, float angle){
  float centreX = posstyloX;   // centre = position du stylo a l'appel
  float centreY = posstyloY;

  // --- Erreur d'orientation : cap commande vs cap mesure par la boussole ---
  float capNord = lireAngleNord();                       // angle vers le Nord (rad)
  float erreurAngle = normaliserAngle(capNord - angle);  // ecart au cap de depart
  teleplot("theta_0",      angle * RAD_TO_DEG);          // angle de depart (deg)
  teleplot("theta_erreur", erreurAngle * RAD_TO_DEG);    // erreur d'orientation (deg)

  // --- Trace les 8 branches + mesure la longueur reellement obtenue ---
  float sommeLongueurs = 0;
  int   nbBranches = 0;
  const float angleIncrement = PI / 4;

  for (int i = 0; i < 8; i++) {
    float angleBranch = angle + i * angleIncrement;
    float rBranche = (i % 2 == 0) ? rayon : rayon * 0.6;  // longue ou courte

    float x = centreX + rBranche * cos(angleBranch);
    float y = centreY + rBranche * sin(angleBranch);
    tracerSegment(centreX, centreY, x, y);

    calculerPositionStylo();   // position reelle de l'extremite atteinte
    float lMes = sqrt(pow(posstyloX - centreX, 2) + pow(posstyloY - centreY, 2));
    sommeLongueurs += lMes;
    nbBranches++;
  }

  // --- Longueur moyenne mesuree vs longueur desiree ---
  float longueurMoyenne = sommeLongueurs / nbBranches;
  teleplot("L_th",  rayon / 10.0);            // longueur desiree (cm)
  teleplot("L_mes", longueurMoyenne / 10.0);  // longueur mesuree (cm)
}

