// Trace un arc de cercle (centre, rayon, de angleDebut a angleFin).
void tracerCercle(float centreX, float centreY, float rayon, float angleDebut, float angleFin) {
  int nbpoints = abs((angleFin - angleDebut) * rayon / diffmmparpoint);  // nb de points selon la longueur d'arc

  for (int i = 0; i <= nbpoints; i++) {              // pour chaque point de l'arc
    float angle = angleDebut + (angleFin - angleDebut) * i / nbpoints;  // angle courant
    float x = centreX + rayon * cos(angle);          // position X sur le cercle
    float y = centreY + rayon * sin(angle);          // position Y sur le cercle
    allerAuPoint(x, y);                              // rejoint ce point
  }
}

// Version instrumentee de tracerCercle : trace le cercle ET envoie a Teleplot
// deux points X-Y : (r_th, r_mes) et (rayon, erreur de fermeture).
// Lance plusieurs cercles de rayons differents pour former un nuage de points.
void tracerCercleTeleplot(float centreX, float centreY, float rayon, float angleDebut, float angleFin) {
  int nb = abs((angleFin - angleDebut) * rayon / diffmmparpoint);
  if (nb < 1) nb = 1;

  float sommeRayons = 0;        // pour la moyenne des rayons mesures
  int   nbMesures   = 0;
  float premierX = 0, premierY = 0;   // 1er point reellement atteint
  float dernierX = 0, dernierY = 0;   // dernier point reellement atteint

  for (int i = 0; i <= nb; i++) {
    float angle = angleDebut + (angleFin - angleDebut) * i / nb;
    float x = centreX + rayon * cos(angle);
    float y = centreY + rayon * sin(angle);
    allerAuPoint(x, y);

    calculerPositionStylo();    // position reelle du stylo apres deplacement

    // rayon mesure = distance du stylo au centre du cercle
    float rMes = sqrt(pow(posstyloX - centreX, 2) + pow(posstyloY - centreY, 2));
    sommeRayons += rMes;
    nbMesures++;

    if (i == 0) { premierX = posstyloX; premierY = posstyloY; }  // memorise le depart
    dernierX = posstyloX; dernierY = posstyloY;                  // reste le dernier
  }

  // --- grandeurs finales (un point par cercle) ---
  float rayonMoyen = sommeRayons / nbMesures;                              // mm
  float fermeture  = sqrt(pow(dernierX - premierX, 2) + pow(dernierY - premierY, 2));  // mm

  // --- Graphe X-Y 1 : r_mes (ordonnee) en fonction de r_th (abscisse) ---
  teleplotXY("rayon_xy", rayon / 10.0, rayonMoyen / 10.0);   // en cm

  // --- Graphe X-Y 2 : erreur de fermeture (ordonnee) en fonction du rayon (abscisse) ---
  teleplotXY("fermeture_xy", rayon / 10.0, fermeture / 10.0);  // en cm

  // --- relevé serie (pour tracer aussi dans Excel si besoin) ---
  Serial.print("r_th=");      Serial.print(rayon / 10.0);
  Serial.print("  r_mes=");   Serial.print(rayonMoyen / 10.0);
  Serial.print("  fermeture=");Serial.println(fermeture / 10.0);
}

// Rosace INSCRITE dans le cercle : 4 cercles secondaires de rayon moitie,
// centres poses a rayon/2 du centre. Toujours 4 petales.
void tracerRosace(float cx, float cy, float rayon, int nbPetales) {
  nbPetales = 4;                                   // consigne : toujours 4 petales

  float rPetale = rayon / 2.0;                      // rayon des cercles secondaires (moitie)

  for (int i = 0; i < nbPetales; i++) {
    float angle = 2.0 * PI * i / nbPetales;         // position du i-eme centre
    float centreSecX = cx + rPetale * cos(angle);   // centre pose a rayon/2 du centre...
    float centreSecY = cy + rPetale * sin(angle);   // ...donc le petale touche le bord
    tracerCercle(centreSecX, centreSecY, rPetale, 0, 6.28);  // cercle secondaire de rayon moitie
  }
}

// Cercle + rosace inscrite (4 petales) : trace d'abord le cercle, puis la rosace dedans.
void cercleRosace(float cx, float cy, float rayon){
  tracerCercle(cx, cy, rayon, 0, 6.28);   // cercle principal complet
  tracerRosace(cx, cy, rayon, 4);          // rosace inscrite, 4 petales
}

