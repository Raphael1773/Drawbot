// Lit le moniteur SERIE et met a jour les coefficients PID ("1 Kp Ki Kd Setpoint").
void reglerPidParSerie() {
  if (Serial.available() > 0) {
    String input = Serial.readStringUntil('\n');
    input.trim();
    char mode = input.charAt(0);
    input = input.substring(1);

    float newKp, newKi, newKd, newSetpoint;
    int parsed = sscanf(input.c_str(), "%f %f %f %f", &newKp, &newKi, &newKd, &newSetpoint);

    if (parsed == 4) {
      if (mode == '1') {
        KpAngle = newKp; KiAngle = newKi; KdAngle = newKd; Setpoint = newSetpoint;
        Serial.println("Coefficients PID angle mis a jour.");
      } else if (mode == '0') {
        KpDistance = newKp; KiDistance = newKi; KdDistance = newKd; Setpoint = newSetpoint;
        Serial.println("Coefficients PID distance mis a jour.");
      } else if (mode == '2') {
        variablewifi = true;
      } else {
        Serial.println("Erreur : 1er caractere = '1' (angle) ou '0' (distance).");
      }
    } else {
      Serial.println("Format : '1 Kp Ki Kd Setpoint' ou '0 Kp Ki Kd Setpoint'");
    }
  }
}

