// Fleche pointant vers le NORD : le robot s'oriente d'abord (AllerAuNord),
// puis trace une fleche droit devant lui (dans la direction anglerobot).
void sequenceFleche(){
  float cx = posstyloX;                 // base de la fleche = position courante
  float cy = posstyloY;
  float cap = anglerobot;               // direction = cap actuel (= Nord apres AllerAuNord)

  const float longueur = 100.0;         // longueur de la hampe
  const float taillePointe = 30.0;      // longueur des barbes
  const float largeurPointe = 15.0;     // demi-ecart des barbes

  // vecteur direction (avant) et perpendiculaire (cote)
  float dx = cos(cap),  dy = sin(cap);
  float px = -sin(cap), py = cos(cap);

  // pointe de la fleche (au bout de la hampe)
  float boutX = cx + longueur * dx;
  float boutY = cy + longueur * dy;

  // les deux coins des barbes (en retrait de la pointe, ecartes de part et d'autre)
  float barbe1X = cx + (longueur - taillePointe) * dx + largeurPointe * px;
  float barbe1Y = cy + (longueur - taillePointe) * dy + largeurPointe * py;
  float barbe2X = cx + (longueur - taillePointe) * dx - largeurPointe * px;
  float barbe2Y = cy + (longueur - taillePointe) * dy - largeurPointe * py;

  // --- trace ---
  tracerSegment(cx, cy, boutX, boutY);        // hampe : base -> pointe
  tracerSegment(boutX, boutY, barbe1X, barbe1Y);  // pointe -> barbe 1
  tracerSegment(boutX, boutY, barbe2X, barbe2Y);  // pointe -> barbe 2
}

