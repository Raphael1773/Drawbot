float anglerobot = 0;          // orientation estimee du robot (radians)
long int encGprec = 0;         // ancienne valeur encodeur gauche (usage interne)
long int encDprec = 0;         // ancienne valeur encodeur droit (usage interne)
int lastEncodedG = 0;          // dernier etat (2 bits) des voies de l'encodeur gauche
int lastEncodedD = 0;          // dernier etat (2 bits) des voies de l'encodeur droit

// Interruption sur l'encodeur GAUCHE : decode la quadrature et incremente/decremente encG.
void interruptionEncodeurGaucheA() {
  int MSB = digitalRead(ENC_G_CH_A);        // lit la voie A (bit de poids fort)
  int LSB = digitalRead(ENC_G_CH_B);        // lit la voie B (bit de poids faible)
  int encoded = (MSB << 1) | LSB;           // combine les deux voies en un code 2 bits
  int sum = (lastEncodedG << 2) | encoded;  // concatene ancien et nouvel etat (4 bits)

  if (sum == 0b1101 || sum == 0b0100 || sum == 0b0010 || sum == 0b1011) encG++;  // sens avant -> +1 (corrige : fix encodeur gauche)
  if (sum == 0b1110 || sum == 0b0111 || sum == 0b0001 || sum == 0b1000) encG--;  // sens arriere -> -1

  lastEncodedG = encoded;                   // memorise l'etat pour la prochaine interruption
}

// Les deux voies declenchent le meme traitement (resolution x4).
void interruptionEncodeurGaucheB() {
  interruptionEncodeurGaucheA();            // reutilise le decodage ci-dessus
}

// Interruption sur l'encodeur DROIT : meme principe, signe oppose (cablage miroir).
void interruptionEncodeurDroitA() {
  int MSB = digitalRead(ENC_D_CH_A);        // lit la voie A
  int LSB = digitalRead(ENC_D_CH_B);        // lit la voie B
  int encoded = (MSB << 1) | LSB;           // code 2 bits
  int sum = (lastEncodedD << 2) | encoded;  // ancien + nouvel etat

  if (sum == 0b1101 || sum == 0b0100 || sum == 0b0010 || sum == 0b1011) encD--;  // sens avant -> -1 (roue droite miroir)
  if (sum == 0b1110 || sum == 0b0111 || sum == 0b0001 || sum == 0b1000) encD++;  // sens arriere -> +1

  lastEncodedD = encoded;                   // memorise l'etat
}

// Idem cote droit pour la voie B.
void interruptionEncodeurDroitB() {
  interruptionEncodeurDroitA();             // reutilise le decodage
}

