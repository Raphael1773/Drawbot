// Boucle finale infinie : fait clignoter les deux LED (signale "fini").
void clignoterSansFin(){
  digitalWrite(LEDU1, LOW);                          // une LED eteinte
  digitalWrite(LEDU2, HIGH);                         // l'autre allumee
  while(1) {                                         // boucle sans fin
    delay(200);                                      // attend 200 ms
    digitalWrite(LEDU1, !digitalRead(LEDU1));        // inverse LED1
    digitalWrite(LEDU2, !digitalRead(LEDU2));        // inverse LED2
  }
}

// Allume les deux LED utilisateur.
