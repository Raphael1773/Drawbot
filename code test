// Boucle principale : attend qu'une sequence soit demandee par la page web, l'execute,
// puis revient attendre la suivante (le serveur tourne en parallele sur le coeur 0).
void loop() {
  if (sequenceADemarrer != 0) {                      // une sequence a ete demandee depuis la page
    int s = sequenceADemarrer;                       // recupere son identifiant
    sequenceADemarrer = 0;                           // remet le drapeau a zero
    sequenceEnCours = true;                          // signale "trace en cours" (affiche sur la page)

    switch (s) {                                     // selon la sequence demandee
      case 1:
        udp.begin(TELEPLOT_PORT);   // ouvre le socket UDP
        teleplotActif = true;       // autorise l'envoi
        sequenceEscalier();
        teleplotActif = false;      // coupe l'envoi a la fin
        break;
      case 2:
        AllerAuNord();          // 1) le robot se met face au Nord
        sequenceFleche();       // 2) puis trace la fleche droit devant
        break;
      case 3:
        udp.begin(TELEPLOT_PORT);
        teleplotActif = true;
        tracerCercleTeleplot(figX, figY, figRayon, figAngleDebut, figAngleFin);
        teleplotActif = false;
        break;                                      // cercle simple (plus de rosace ici)
      case 4: tracerSegment(figX, figY, figX2, figY2); break;
      case 5: mrGameAndWatch(); break;
      case 6:
        AllerAuNord();                // 1) le robot se met face au Nord
        tracerBoussole(figRayon, figAngleDebut);  // 2) puis il dessine la rose
        break;
      case 8: carresconcentriques(); break;
      case 9: cercleRosace(figX, figY, figRayon); break;   // cercle + rosace
      case 10: calibrerMagnetometre(); break;              // calibration magneto
    }

    sequenceEnCours = false;                         // trace termine
  }
  delay(10);                                         // petite pause de boucle
}
