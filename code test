  else if (name == "maxpidangle")           maxpidangle = (int)v;
  else if (name == "maxanglediff")          maxanglediff = v;
  else if (name == "mindistancedupoint")    mindistancedupoint = v;
  else if (name == "diffmmparpoint")        diffmmparpoint = v;
  else if (name == "rayoncercle")           rayoncercle = v;
  else if (name == "angleFin")              angleFin = v;
  else if (name == "debugMode")             debugMode = (v > 0);
  else                                      ok = false;

  if (ok) server.send(200, "text/plain", name + " = " + server.arg("value"));
