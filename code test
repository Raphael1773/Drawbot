int encGavant2 = 0;            // encodeur gauche au dernier calcul d'odometrie
int encDavant2 = 0;            // encodeur droit au dernier calcul d'odometrie
float distGavant2 = 0;         // distance gauche au dernier calcul
float distDavant2 = 0;         // distance droite au dernier calcul
float robotXavant = 0;         // ancienne position X (usage interne)
float robotYavant = 0;         // ancienne position Y (usage interne)
float anciendistG = 0;         // distance gauche au pas precedent
float anciendistD = 0;         // distance droite au pas precedent
float anciendist = 0;          // distance moyenne au pas precedent

// Met a jour l'angle du robot et les distances de roues a partir des encodeurs.
void calculerAngleEtDistanceRoues(){
  const float ecartRoues = 80.0;                       // entraxe entre les deux roues (mm)
  const float facteurAngle = (ecartRoues / MMPARPAS);  // conversion (difference de pas) -> radians

  distG = encG * MMPARPAS;                  // distance totale roue gauche (mm)
  distD = encD * MMPARPAS;                  // distance totale roue droite (mm)

  float deltaEncG = encG - encGavant2;      // pas gauche depuis le dernier calcul
  float deltaEncD = encD - encDavant2;      // pas droit depuis le dernier calcul
  float deltadistG = distG - distGavant2;   // variation de distance gauche (mm)
  float deltadistD = distD - distDavant2;   // variation de distance droite (mm)

  anglerobot += (deltaEncD - deltaEncG) / facteurAngle;  // rotation = difference des deux roues
  anglerobot = normaliserAngle(anglerobot); // garde l'angle dans [-PI, PI]

  encGavant2 = encG;                        // memorise pour le prochain calcul
  encDavant2 = encD;                        // ...
  distGavant2 = distG;                      // ...
  distDavant2 = distD;                      // ...
}

// Met a jour la position (X, Y) du centre du robot par integration du deplacement.
void calculerPositionRobot(){
  calculerAngleEtDistanceRoues();           // d'abord l'angle et les distances
  float nouvelleDistG = distG - anciendistG;// avance gauche depuis le dernier appel
  float nouvelleDistD = distD - anciendistD;// avance droite depuis le dernier appel
  anciendistG = distG;                      // memorise
  anciendistD = distD;                      // memorise

  robotX += (nouvelleDistG + nouvelleDistD) / 2 * cos(anglerobot);  // avance moyenne projetee sur X
  robotY += (nouvelleDistG + nouvelleDistD) / 2 * sin(anglerobot);  // avance moyenne projetee sur Y
}

// Calcule la position de la pointe du stylo (decalee de DISTANCESTYLO devant le centre).
void calculerPositionStylo(){
  calculerPositionRobot();                  // met d'abord a jour la position du centre
  posstyloX = robotX + DISTANCESTYLO * cos(anglerobot);  // stylo = centre + offset selon l'orientation
  posstyloY = robotY + DISTANCESTYLO * sin(anglerobot);  // idem en Y
}

// ============================================================================
//   CAPTEURS  —  gyroscope (filtre de Kalman sur le roulis) et magnetometre
// ============================================================================

float kalmanAngleRoll = 0.0;            // estimation Kalman de l'angle de roulis
float kalmanUncertaintyAngleRoll = 4.0; // incertitude associee a cette estimation

const float gyroMeasurementErrorVariance = 4.0 * 4.0;          // variance d'erreur du gyroscope
const float accelerometerMeasurementErrorVariance = 3.0 * 3.0; // variance d'erreur de l'accelerometre

float Ax, Ay, Az;              // accelerations lues (3 axes)
float Gx, Gy, Gz;              // vitesses angulaires lues (3 axes)
float roll = 0.00;             // angle de roulis courant (degres)
float gyroRollRate = 0.0;      // vitesse de roulis (non utilise partout)
float complementaryRoll = 0.0; // variante filtre complementaire (non utilise)
unsigned long lastRollUpdate = 0;  // horodatage du dernier calcul (us)
float gyroOffsetX = 0.0;       // biais mesure du gyroscope sur X
bool isGyroCalibrated = false; // vrai une fois la calibration faite

const float ALPHA = 0.9;       // coefficient de filtre complementaire (si utilise)

// Mesure le biais du gyroscope a l'arret (a appeler robot immobile).
void calibrerGyroscope() {
  if (isGyroCalibrated) return;             // ne calibre qu'une seule fois

  Serial.println("Calibration du gyroscope pour Roll...");  // message d'info
  float sumX = 0.0;                         // accumulateur des mesures
  int samples = 200;                        // nombre d'echantillons

  for (int i = 0; i < samples; i++) {       // boucle d'acquisition
    if (IMU.gyroscopeAvailable()) {         // si une nouvelle mesure est dispo
      IMU.readGyroscope(Gx, Gy, Gz);        // lit les 3 axes
      sumX += Gx;                           // cumule l'axe X
      delay(10);                            // attend un peu entre deux mesures
    }
  }

  gyroOffsetX = sumX / samples;             // biais = moyenne des mesures a l'arret
  Serial.print("Offset du gyroscope X: ");  // affiche le biais trouve
  Serial.println(gyroOffsetX);              // ...
  isGyroCalibrated = true;                  // marque la calibration comme faite
}

// Renvoie l'angle de roulis filtre (Kalman), en fusionnant accelerometre et gyroscope.
float lireAngleGyroscope() {
  if (!isGyroCalibrated) {                  // si pas encore calibre
    calibrerGyroscope();                    // ... calibre d'abord
  }

  unsigned long now = micros();             // temps courant (us)
  float dt = (now - lastRollUpdate) / 1000000.0f;  // intervalle depuis le dernier calcul (s)

  if (dt > 0.1f || lastRollUpdate == 0) {   // premier appel ou intervalle anormalement long
    dt = 0.01f;                             // ... on force un pas raisonnable
  }
  lastRollUpdate = now;                     // memorise l'horodatage

  if (IMU.accelerationAvailable()) {        // si l'accelerometre a une mesure
    IMU.readAcceleration(Ax, Ay, Az);       // ... la lire
  }
  if (IMU.gyroscopeAvailable()) {           // si le gyroscope a une mesure
    IMU.readGyroscope(Gx, Gy, Gz);          // ... la lire
  }

  float correctedGx = Gx - gyroOffsetX;     // retire le biais du gyroscope

  float accelRoll = atan2(Ay, Az) * RAD_TO_DEG;  // roulis deduit de l'accelerometre (degres)

  float predictedAngleRoll = kalmanAngleRoll + dt * correctedGx;  // prediction : angle + integration gyro
  float predictedUncertaintyAngleRoll = kalmanUncertaintyAngleRoll + dt * dt * gyroMeasurementErrorVariance;  // incertitude predite

  float kalmanGain = predictedUncertaintyAngleRoll / (predictedUncertaintyAngleRoll + accelerometerMeasurementErrorVariance);  // gain de Kalman
  kalmanAngleRoll = predictedAngleRoll + kalmanGain * (accelRoll - predictedAngleRoll);  // correction par l'accelerometre
  kalmanUncertaintyAngleRoll = (1.0f - kalmanGain) * predictedUncertaintyAngleRoll;      // mise a jour de l'incertitude

  roll = kalmanAngleRoll;                   // angle de roulis retenu
  return roll;                              // renvoie l'angle filtre
}

float lireAngleNord(){
  lis3mdl.read();

  // valeurs de calibration relevees sur CE robot
  const float offsetX = -2195.5, offsetY = 665.0;     // hard iron (centre de l'ellipse)
  const float echelleX = 2960.5, echelleY = 3076.0;   // soft iron (demi-axes)

  float mx = (lis3mdl.x - offsetX) / echelleX;        // recentre et remet a l'echelle
  float my = (lis3mdl.y - offsetY) / echelleY;

  float angle = atan2(my, mx);
  return normaliserAngle(angle);
}


