// Envoie une variable a Teleplot : format "nom:valeur\n" (les ":" en option = horodatage auto)
void teleplot(const char* nom, float valeur){
  if(!teleplotActif) return;
  char buf[48];
  snprintf(buf, sizeof(buf), "%s:%.3f\n", nom, valeur);
  udp.beginPacket(teleplotIP, TELEPLOT_PORT);
  udp.write((const uint8_t*)buf, strlen(buf));
  udp.endPacket();
}

// Variante avec horodatage explicite (millis) : "nom:temps:valeur|t\n"
void teleplotT(const char* nom, float valeur){
  if(!teleplotActif) return;
  char buf[64];
  snprintf(buf, sizeof(buf), "%s:%lu:%.3f|t\n", nom, (unsigned long)millis(), valeur);
  udp.beginPacket(teleplotIP, TELEPLOT_PORT);
  udp.write((const uint8_t*)buf, strlen(buf));
  udp.endPacket();
}

// >>> COLLE teleplotXY ICI <
void teleplotXY(const char* nom, float x, float y){
  if(!teleplotActif) return;
  char buf[64];
  snprintf(buf, sizeof(buf), "%s:%.3f:%.3f|xy\n", nom, x, y);
