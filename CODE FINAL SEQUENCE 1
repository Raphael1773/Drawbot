  } else {                                           // sens arriere
    analogWrite(IN_2_G, -outputgauche);              // ...
    analogWrite(IN_1_G, 0);                          // ...
  }
}

// Amene la roue DROITE a une consigne (en pas/10) via un PID de vitesse.
void deplacerRoueDroitePid(int consigne) {
