// Sequence : une fleche remplie (pointe hachuree).
void sequenceFleche(){
  tracerSegment(0,0,100, 0);                         // hampe de la fleche
  tracerSegment(100, 0,70,-15);                      // barbe inferieure
  tracerSegment(70,-15,70, 15);                      // base de la pointe
  tracerSegment(70, 15,100, 0);                      // barbe superieure

  for (int i = 0; i < 15; i++) {                     // remplissage de la pointe par hachures
    tracerSegment(100,0 , 70, -15 + i);              // hachure (bas vers pointe)
    tracerSegment( 70, -15 + i,100, 0);              // retour
    tracerSegment(100,0,70, 15 - i);                 // hachure (haut vers pointe)
    tracerSegment(70, 15 - i,100, 0);                // retour
  }
}

