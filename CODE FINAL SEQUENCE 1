int encGavant2 = 0;            // encodeur gauche au dernier calcul d'odometrie
int encDavant2 = 0;            // encodeur droit au dernier calcul d'odometrie
float distGavant2 = 0;         // distance gauche au dernier calcul
float distDavant2 = 0;         // distance droite au dernier calcul
float robotXavant = 0;         // ancienne position X (usage interne)
float robotYavant = 0;         // ancienne position Y (usage interne)
float anciendistG = 0;         // distance gauche au pas precedent
float anciendistD = 0;         // distance droite au pas precedent
float anciendist = 0;          // distance moyenne au pas precedent

// Met a jour l'angle du robot et les distances de roues a partir des encodeurs.
void calculerAngleEtDistanceRoues(){
  const float ecartRoues = 80.0;                       // entraxe entre les deux roues (mm)
  const float facteurAngle = (ecartRoues / MMPARPAS);  // conversion (difference de pas) -> radians

  distG = encG * MMPARPAS;                  // distance totale roue gauche (mm)
  distD = encD * MMPARPAS;                  // distance totale roue droite (mm)

  float deltaEncG = encG - encGavant2;      // pas gauche depuis le dernier calcul
  float deltaEncD = encD - encDavant2;      // pas droit depuis le dernier calcul
  float deltadistG = distG - distGavant2;   // variation de distance gauche (mm)
  float deltadistD = distD - distDavant2;   // variation de distance droite (mm)

  anglerobot += (deltaEncD - deltaEncG) / facteurAngle;  // rotation = difference des deux roues
  anglerobot = normaliserAngle(anglerobot); // garde l'angle dans [-PI, PI]

  encGavant2 = encG;                        // memorise pour le prochain calcul
  encDavant2 = encD;                        // ...
  distGavant2 = distG;                      // ...
  distDavant2 = distD;                      // ...
}

// Met a jour la position (X, Y) du centre du robot par integration du deplacement.
void calculerPositionRobot(){
  calculerAngleEtDistanceRoues();           // d'abord l'angle et les distances
  float nouvelleDistG = distG - anciendistG;// avance gauche depuis le dernier appel
  float nouvelleDistD = distD - anciendistD;// avance droite depuis le dernier appel
  anciendistG = distG;                      // memorise
  anciendistD = distD;                      // memorise

  robotX += (nouvelleDistG + nouvelleDistD) / 2 * cos(anglerobot);  // avance moyenne projetee sur X
  robotY += (nouvelleDistG + nouvelleDistD) / 2 * sin(anglerobot);  // avance moyenne projetee sur Y
}

// Calcule la position de la pointe du stylo (decalee de DISTANCESTYLO devant le centre).
void calculerPositionStylo(){
  calculerPositionRobot();                  // met d'abord a jour la position du centre
  posstyloX = robotX + DISTANCESTYLO * cos(anglerobot);  // stylo = centre + offset selon l'orientation
  posstyloY = robotY + DISTANCESTYLO * sin(anglerobot);  // idem en Y
}


// ============================================================================
//   CAPTEURS  —  gyroscope (filtre de Kalman sur le roulis) et magnetometre
// ============================================================================

float kalmanAngleRoll = 0.0;            // estimation Kalman de l'angle de roulis
float kalmanUncertaintyAngleRoll = 4.0; // incertitude associee a cette estimation

const float gyroMeasurementErrorVariance = 4.0 * 4.0;          // variance d'erreur du gyroscope
const float accelerometerMeasurementErrorVariance = 3.0 * 3.0; // variance d'erreur de l'accelerometre

float Ax, Ay, Az;              // accelerations lues (3 axes)
float Gx, Gy, Gz;              // vitesses angulaires lues (3 axes)
float roll = 0.00;             // angle de roulis courant (degres)
float gyroRollRate = 0.0;      // vitesse de roulis (non utilise partout)
float complementaryRoll = 0.0; // variante filtre complementaire (non utilise)
unsigned long lastRollUpdate = 0;  // horodatage du dernier calcul (us)
float gyroOffsetX = 0.0;       // biais mesure du gyroscope sur X
bool isGyroCalibrated = false; // vrai une fois la calibration faite

const float ALPHA = 0.9;       // coefficient de filtre complementaire (si utilise)

// Mesure le biais du gyroscope a l'arret (a appeler robot immobile).
void calibrerGyroscope() {
  if (isGyroCalibrated) return;             // ne calibre qu'une seule fois

  Serial.println("Calibration du gyroscope pour Roll...");  // message d'info
  float sumX = 0.0;                         // accumulateur des mesures
  int samples = 200;                        // nombre d'echantillons

  for (int i = 0; i < samples; i++) {       // boucle d'acquisition
    if (IMU.gyroscopeAvailable()) {         // si une nouvelle mesure est dispo
      IMU.readGyroscope(Gx, Gy, Gz);        // lit les 3 axes
      sumX += Gx;                           // cumule l'axe X
      delay(10);                            // attend un peu entre deux mesures
    }
  }

  gyroOffsetX = sumX / samples;             // biais = moyenne des mesures a l'arret
  Serial.print("Offset du gyroscope X: ");  // affiche le biais trouve
  Serial.println(gyroOffsetX);              // ...
  isGyroCalibrated = true;                  // marque la calibration comme faite
}

// Renvoie l'angle de roulis filtre (Kalman), en fusionnant accelerometre et gyroscope.
float lireAngleGyroscope() {
  if (!isGyroCalibrated) {                  // si pas encore calibre
    calibrerGyroscope();                    // ... calibre d'abord
  }

  unsigned long now = micros();             // temps courant (us)
  float dt = (now - lastRollUpdate) / 1000000.0f;  // intervalle depuis le dernier calcul (s)

  if (dt > 0.1f || lastRollUpdate == 0) {   // premier appel ou intervalle anormalement long
    dt = 0.01f;                             // ... on force un pas raisonnable
  }
  lastRollUpdate = now;                     // memorise l'horodatage

  if (IMU.accelerationAvailable()) {        // si l'accelerometre a une mesure
    IMU.readAcceleration(Ax, Ay, Az);       // ... la lire
  }
  if (IMU.gyroscopeAvailable()) {           // si le gyroscope a une mesure
    IMU.readGyroscope(Gx, Gy, Gz);          // ... la lire
  }

  float correctedGx = Gx - gyroOffsetX;     // retire le biais du gyroscope

  float accelRoll = atan2(Ay, Az) * RAD_TO_DEG;  // roulis deduit de l'accelerometre (degres)

  float predictedAngleRoll = kalmanAngleRoll + dt * correctedGx;  // prediction : angle + integration gyro
  float predictedUncertaintyAngleRoll = kalmanUncertaintyAngleRoll + dt * dt * gyroMeasurementErrorVariance;  // incertitude predite

  float kalmanGain = predictedUncertaintyAngleRoll / (predictedUncertaintyAngleRoll + accelerometerMeasurementErrorVariance);  // gain de Kalman
  kalmanAngleRoll = predictedAngleRoll + kalmanGain * (accelRoll - predictedAngleRoll);  // correction par l'accelerometre
  kalmanUncertaintyAngleRoll = (1.0f - kalmanGain) * predictedUncertaintyAngleRoll;      // mise a jour de l'incertitude

  roll = kalmanAngleRoll;                   // angle de roulis retenu
  return roll;                              // renvoie l'angle filtre
}

// Renvoie l'angle vers le nord magnetique (radians) a partir du magnetometre.
int lireAngleNord(){
  lis3mdl.read();                           // lit le magnetometre

  float mx = lis3mdl.x;                     // composante X du champ
  float my = lis3mdl.y;                     // composante Y du champ

  float anglebousole = atan2(my, mx);       // angle de la boussole
  if (anglebousole < -PI) {                 // recale dans [-PI, PI]
    anglebousole += 2*PI;                   // ...
  }
  if (anglebousole > PI) {                  // ...
    anglebousole -= 2*PI;                   // ...
  }
  return anglebousole;                      // renvoie l'angle (tronque en int)
}


// ============================================================================
//   ASSERVISSEMENT PID  —  regulateurs distance/angle et pilotage vers un point
// ============================================================================

float sommeErreursnormal = 0;       // somme des erreurs de distance (terme integral)
float erreurPrecedentenormal = 0;   // erreur de distance precedente (terme derive)

// PID de DISTANCE : renvoie une commande a partir de l'ecart (consigne - mesure).
int pidDistance(float Longeur, float consigne_distance) {
  float erreur = consigne_distance - Longeur;       // ecart a annuler

  float termeP = KpDistance * erreur;               // terme proportionnel

  sommeErreursnormal += erreur;                      // accumule l'erreur (integrale)
  sommeErreursnormal = constrain(sommeErreursnormal, -maxerreurDistance, maxerreurDistance);  // anti-emballement
  float termeI = KiDistance * sommeErreursnormal;    // terme integral

  float termeD = KdDistance * (erreur - erreurPrecedentenormal);  // terme derive
  erreurPrecedentenormal = erreur;                   // memorise pour la prochaine fois

  return (termeP + termeI + termeD);                 // somme des trois termes
}

float sommeErreursAngle = 0;        // somme des erreurs d'angle (terme integral)
float erreurPrecedenteAngle = 0;    // erreur d'angle precedente (terme derive)

// PID d'ANGLE : renvoie une correction de rotation a partir de (cible - actuel).
int pidAngle(float angleActuel, float angleCible) {
  float erreur = normaliserAngle(angleCible - angleActuel);  // ecart angulaire ramene dans [-PI, PI]

  float termeP = KpAngle * erreur;                  // terme proportionnel

  sommeErreursAngle += erreur;                       // integrale de l'erreur
  sommeErreursAngle = constrain(sommeErreursAngle, -maxerreurAngle, maxerreurAngle);  // anti-emballement
  float termeI = KiAngle * sommeErreursAngle;        // terme integral

  float termeD = KdAngle * (erreur - erreurPrecedenteAngle);  // terme derive
  erreurPrecedenteAngle = erreur;                    // memorise

  return constrain(termeP + termeI + termeD, -maxpidangle, maxpidangle);  // borne la sortie (autorite max)
}

// Oriente le robot vers un cap donne (n'agit que sur la roue gauche ici, usage debug).
void asservirAngle(float angleCible) {
  angleCible = normaliserAngle(angleCible);          // recale la cible

  float angleActuel = normaliserAngle(anglerobot);   // angle courant recale

  float correctionAngle = pidAngle(angleActuel, angleCible);  // correction PID
  Serial.print("angleActuel : ");                    // debug
  Serial.print(angleActuel);                         // ...
  Serial.print("   angleCible : ");                  // ...
  Serial.print(angleCible);                          // ...
  Serial.print("   correctionAngle : ");             // ...
  Serial.println(correctionAngle);                   // ...

  float vitesseGauche = -correctionAngle;            // roue gauche en sens oppose
  float vitesseDroite = +correctionAngle;            // roue droite dans le sens
  vitesseGauche = constrain(vitesseGauche, -255, 255);  // borne PWM
  vitesseDroite = constrain(vitesseDroite, -255, 255);  // borne PWM
  if (vitesseGauche > 0) {                           // applique a la roue gauche
    analogWrite(IN_1_G, vitesseGauche);              // avant
    analogWrite(IN_2_G, 0);                          // ...
  } else {                                           // ...
    analogWrite(IN_2_G, -vitesseGauche);             // arriere
    analogWrite(IN_1_G, 0);                          // ...
  }
}

// Coeur de l'asservissement : amene la POINTE DU STYLO vers le point (consignex, consigney).
void asservirVersPoint(int consignex, int consigney) {
  float consigne_distance = sqrt(pow(consignex - robotX, 2) + pow(consigney - robotY, 2)) - DISTANCESTYLO;  // distance restante (corrigee de l'offset stylo)
  float consigne_angle = atan2(consigney - robotY, consignex - robotX);  // cap a viser vers le point
  float angleActuel = anglerobot;                    // cap courant

  consigne_angle = normaliserAngle(consigne_angle);  // recale la cible
  angleActuel = normaliserAngle(angleActuel);        // recale l'actuel

  float correctionAngle = pidAngle(angleActuel, consigne_angle);  // correction de rotation
  constrain(correctionAngle, -maxvitessemoteurangle, maxvitessemoteurangle);  // (borne sans effet : resultat non reutilise)

  bool derriererobot = false;                        // vrai si le point est trop "de cote" pour avancer
  bool disque = estDansArcDeDisque(consignex,consigney);  // le point est-il dans la zone proche/avant
  float angleDiff = normaliserAngle(consigne_angle - angleActuel);  // ecart de cap
  if (abs(angleDiff) > maxanglediff) {               // si le cap n'est pas encore bon
    derriererobot = true;                            // ... on ne fait d'abord que tourner
  }
  if (derriererobot) {                               // tant qu'on doit tourner
    consigne_distance = 0;                           // ... pas d'avance
  }

  float correctionDistance = pidDistance(0, consigne_distance);  // correction d'avance

  if (derriererobot && !disque) {                    // si on tourne et que le point n'est pas dans le disque
    correctionDistance = 0;                          // ... on bloque l'avance
  }

  if (debugMode){                                    // (emplacement reserve a des affichages de debug)

  }

  delay(4);                                          // petite pause de stabilisation de la boucle

  float vitesseGauche = correctionDistance - correctionAngle;  // melange avance - rotation
  float vitesseDroite = correctionDistance + correctionAngle;  // melange avance + rotation

  commanderMoteurGauche(vitesseGauche);              // applique a la roue gauche
  commanderMoteurDroit(vitesseDroite);               // applique a la roue droite
}

// Avance en ligne droite sur une distance (axe X) tout en maintenant un cap.
void avancerToutDroit(int distance,float angleconsigne) {
  float correctionAngle = pidAngle(anglerobot, angleconsigne);  // correction de cap
  float correctionDistance = pidDistance(robotX, -distance);    // correction d'avance (sur X)
  Serial.print("correctionAngle : ");                // debug
  Serial.print(correctionAngle);                     // ...
  Serial.print("   correctionDistance : ");          // ...
  Serial.println(correctionDistance);                // ...

  float vitesseGauche = correctionDistance - correctionAngle;  // melange
  float vitesseDroite = correctionDistance + correctionAngle;  // melange
  vitesseGauche = constrain(vitesseGauche, -255, 255);  // borne PWM
  vitesseDroite = constrain(vitesseDroite, -255, 255);  // borne PWM
  if (vitesseGauche > 0) {                           // roue gauche
    analogWrite(IN_1_G, vitesseGauche);              // avant
    analogWrite(IN_2_G, 0);                          // ...
  } else {                                           // ...
    analogWrite(IN_2_G, -vitesseGauche);             // arriere
    analogWrite(IN_1_G, 0);                          // ...
  }
  if (vitesseDroite > 0) {                           // roue droite
    analogWrite(IN_2_D, vitesseDroite);              // avant
    analogWrite(IN_1_D, 0);                          // ...
  } else {                                           // ...
    analogWrite(IN_1_D, -vitesseDroite);             // arriere
    analogWrite(IN_2_D, 0);                          // ...
  }
}


// ============================================================================
//   CALCULS & TRAJECTOIRES  —  geometrie et decoupage des formes en points
// ============================================================================

// Ramene n'importe quel angle dans l'intervalle [-PI, PI].
float normaliserAngle(float angle) {
  while (angle > PI) {                               // tant que trop grand
    angle -= 2 * PI;                                 // ... retire un tour
  }
  while (angle < -PI) {                              // tant que trop petit
    angle += 2 * PI;                                 // ... ajoute un tour
  }
  return angle;                                      // angle recale
}

// Renvoie vrai si le point vise est proche et a peu pres devant (zone "atteignable directement").
bool estDansArcDeDisque(float consigneX, float consigneY) {
  float distanceRobot = sqrt(pow(robotX - consigneX, 2) + pow(robotY - consigneY, 2));  // distance au point
  float angleconsigne = atan2(consigneY - robotY, consigneX - robotX);  // cap vers le point
  float anglediff = normaliserAngle(angleconsigne - anglerobot);  // ecart de cap

  if (distanceRobot <= DISTANCESTYLO && abs(anglediff) < 0.4) {  // proche ET a peu pres devant
    return true;                                     // ... dans la zone
  }
  return false;                                      // sinon non
}

// Trace un segment droit en l'echantillonnant en petits points de diffmmparpoint mm.
void tracerSegment(float debutx, float debuty, float finx, float finy) {
  float distance = sqrt(pow(finx - debutx, 2) + pow(finy - debuty, 2));  // longueur du segment

  float distanceentrepoints = diffmmparpoint;        // pas d'echantillonnage (mm)
  int nbpoints = distance / distanceentrepoints;     // nombre de points intermediaires

  time_t end = millis() + 15000;                     // garde-fou : 15 s max par segment
  for (int i = 0; i <= nbpoints; i++) {              // pour chaque point du segment
    float x = debutx + (finx - debutx) * i / nbpoints;  // interpolation lineaire en X
    float y = debuty + (finy - debuty) * i / nbpoints;  // interpolation lineaire en Y
    if (millis()>end){                               // si on depasse le temps limite
      break;                                         // ... on abandonne le segment
    }
    allerAuPoint(x, y);                              // rejoint ce point
  }
}

// Trace un arc de cercle (centre, rayon, de angleDebut a angleFin).
void tracerCercle(float centreX, float centreY, float rayon, float angleDebut, float angleFin) {
  int nbpoints = abs((angleFin - angleDebut) * rayon / diffmmparpoint);  // nb de points selon la longueur d'arc

  for (int i = 0; i <= nbpoints; i++) {              // pour chaque point de l'arc
    float angle = angleDebut + (angleFin - angleDebut) * i / nbpoints;  // angle courant
    float x = centreX + rayon * cos(angle);          // position X sur le cercle
    float y = centreY + rayon * sin(angle);          // position Y sur le cercle
    allerAuPoint(x, y);                              // rejoint ce point
  }
}

// Trace une rosace (courbe en petales, r = rayon * cos(n*angle)).
void tracerRosace(float centreX, float centreY, float rayon) {
  int nbpoints = rayon * 2 * PI * 20 / diffmmparpoint;  // densite de points

  const float n = 5;                                 // nombre de petales (parametre de la rosace)
  for (int i = 0; i <= nbpoints; i++) {              // pour chaque point
    float angle = i * 2 * PI / nbpoints;             // angle courant (un tour complet)
    float ro = rayon * cos(n * angle);               // rayon module par cos(n*angle)
    float x = centreX + ro * cos(angle);             // position X
    float y = centreY + ro * sin(angle);             // position Y
    allerAuPoint(x, y);                              // rejoint ce point
  }
}

// Trace un coeur (courbe parametrique en coordonnees polaires).
void tracerCoeur(float centreX, float centreY, float hauteurentrelesdeuxpics) {
  int nbpoints = 100;                                // nombre de points fixe

  for (int i = 0; i <= nbpoints; i++) {              // pour chaque point
    float angle = i * PI / nbpoints;                 // angle de 0 a PI
    float ro = pow(abs(tan(angle)), abs(1/tan(angle)));  // rayon (formule du coeur)
    float x = centreX + ro * cos(angle) * hauteurentrelesdeuxpics;  // position X mise a l'echelle
    float y = centreY + ro * sin(angle) * hauteurentrelesdeuxpics;  // position Y mise a l'echelle
    allerAuPoint(x, y);                              // rejoint ce point
  }
}

// Trace la figure "beuteu" (courbe polaire fantaisie).
void tracerBeuteu(float centreX, float centreY, float taille) {
  int nbpoints = taille * 2 * PI * 20 / diffmmparpoint;  // densite de points

  for (int i = 0; i <= nbpoints; i++) {              // pour chaque point
    float angle = i * 2 * PI / nbpoints;             // angle (un tour)
    float ro = 1.7 - sin(3 * angle) + pow((1 + sin(angle)) / 2, 5) + (cos(4 * angle)) / 2;  // rayon (formule fantaisie)
    float x = centreX + ro * cos(angle) * taille;    // position X
    float y = centreY + ro * sin(angle) * taille;    // position Y
    allerAuPoint(x, y);                              // rejoint ce point
  }
}

// Trace un triangle formant un "N" a partir d'un coin (x, y).
void tracerN(float x, float y){
  float x1 = x;                                      // coin de depart
  float y1 = y;                                      // ...
  float x2 = x + 20;                                 // deuxieme point (en bas a droite)
  float y2 = y - 40;                                 // ...
  float x3 = x + 20;                                 // troisieme point (en haut a droite)
  float y3 = y;                                      // ...

  tracerSegment(x1, y1, x2, y2);                     // cote 1
  tracerSegment(x2, y2, x3, y3);                     // cote 2
  tracerSegment(x3, y3, x1, y1);                     // cote 3 (fermeture)
}

// Trace une rose des vents a 8 branches autour de la position courante du stylo.
void tracerBoussole(float rayon,float angle){
  const float rayonduCercle1 = rayon;                // grand rayon
  const float centrecercle1X = posstyloX;            // centre = position stylo
  const float centrecercle1Y = posstyloY;            // ...
  const float rayonduCercle2 = rayon;                // rayon des branches principales
  const float centreX = posstyloX + rayonduCercle1 * cos(angle);  // centre decale (branche principale)
  const float centreY = posstyloY + rayonduCercle1 * sin(angle);  // ...
  const float rayonduCercle3 = rayon * 0.6;          // rayon des branches secondaires
  const float rayonduCercle4 = rayon * 0.3;          // petit rayon

  float avantX = posstyloX;                          // point de depart des traits
  float avantY = posstyloY;                          // ...

  const float angleIncrement = PI / 4;               // 45 deg entre branches (8 branches)
  for (int i = 0; i < 8; i++) {                      // pour chaque branche
    float angleBranch = angle + i * angleIncrement;  // angle de cette branche

    if (i % 2 == 0) {                                // branches paires (principales)
      float x1 = centreX + rayonduCercle2 * cos(angleBranch);  // extremite calculee
      float y1 = centreY + rayonduCercle2 * sin(angleBranch);  // ...
      float x2 = posstyloX + rayonduCercle1 * cos(angleBranch);  // (valeurs intermediaires)
      float y2 = posstyloY + rayonduCercle1 * sin(angleBranch);  // ...

      tracerSegment(avantX, avantY, x1, y1);         // trace la branche
    }
    else {                                           // branches impaires (secondaires)
      float x1 = centreX + rayonduCercle3 * cos(angleBranch);  // extremite calculee
      float y1 = centreY + rayonduCercle3 * sin(angleBranch);  // ...
      float x2 = posstyloX + rayonduCercle4 * cos(angleBranch);  // ...
      float y2 = posstyloY + rayonduCercle4 * sin(angleBranch);  // ...

      tracerSegment(avantX, avantY, x1, y1);         // trace la branche
    }
  }
}


// ============================================================================
//   DEPLACEMENT  —  allerAuPoint : bloque jusqu'a ce que le stylo atteigne un point
// ============================================================================

// Asservit en boucle jusqu'a ce que le stylo soit sur (consignex, consigney), puis arrete.
int allerAuPoint(int consignex, int consigney) {
  long tempsdarret = millis();                       // horodatage pour la condition d'arret
  while (millis() - tempsdarret < tempsdarretfin) {  // tant qu'on n'est pas reste assez longtemps sur la cible
    Serial.println("Moving...");                     // debug

    calculerPositionStylo();                         // met a jour la position estimee du stylo

    asservirVersPoint(consignex, consigney);         // une iteration de l'asservissement
    digitalWrite(LEDU2, estDansArcDeDisque(consignex,consigney));  // LED2 : point dans la zone proche

    if (!(abs(posstyloX - consignex) < mindistancedupoint && abs(posstyloY - consigney) < mindistancedupoint)) {  // si pas encore arrive
      tempsdarret = millis();                        // ... on relance le chrono
      digitalWrite(LEDU1, LOW);                      // LED1 eteinte (pas arrive)
    }
    else{                                            // sinon (dans la tolerance)
      digitalWrite(LEDU1, HIGH);                     // LED1 allumee (arrive)
    }
    delayMicroseconds(10);                           // petite pause de boucle
  }

  analogWrite(IN_1_G, 0);                            // stoppe la roue gauche
  analogWrite(IN_2_G, 0);                            // ...
  analogWrite(IN_1_D, 0);                            // stoppe la roue droite
  analogWrite(IN_2_D, 0);                            // ...

  return 0;                                          // termine
}


