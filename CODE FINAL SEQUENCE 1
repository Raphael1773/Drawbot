// Interprete une commande Bluetooth "<numero> <valeur>" et modifie le parametre correspondant.
void traiterCommandeBluetooth() {
  if (SerialBT.available()) {                        // si une commande arrive
    String commande = SerialBT.readStringUntil('\n');// lit la ligne
    commande.trim();                                 // nettoie

    int indexEspace = commande.indexOf(' ');         // cherche l'espace
    if (indexEspace > 0) {                           // forme "<num> <valeur>"
      int numParam = commande.substring(0, indexEspace).toInt();   // numero du parametre
      float valeur = commande.substring(indexEspace + 1).toFloat();// valeur

      switch (numParam) {                            // selon le parametre
        case 1:                                      // KpDistance
          KpDistance = valeur;                       // applique
          SerialBT.println("KpDistance mis à jour à " + String(valeur));  // accuse
          break;
        case 2:                                      // KiDistance
          KiDistance = valeur;                       // applique
          SerialBT.println("KiDistance mis à jour à " + String(valeur));  // accuse
          break;
        case 3:                                      // KdDistance
          KdDistance = valeur;                       // applique
          SerialBT.println("KdDistance mis à jour à " + String(valeur));  // accuse
          break;
        case 4:                                      // KpAngle
          KpAngle = valeur;                          // applique
          SerialBT.println("KpAngle mis à jour à " + String(valeur));     // accuse
          break;
        case 5:                                      // KiAngle
          KiAngle = valeur;                          // applique
          SerialBT.println("KiAngle mis à jour à " + String(valeur));     // accuse
          break;
        case 6:                                      // KdAngle
          KdAngle = valeur;                          // applique
          SerialBT.println("KdAngle mis à jour à " + String(valeur));     // accuse
          break;
        case 7:                                      // maxerreurAngle
          maxerreurAngle = (int)valeur;              // applique (entier)
          SerialBT.println("maxerreurAngle mis à jour à " + String((int)valeur));  // accuse
          break;
        case 8:                                      // maxerreurDistance
          maxerreurDistance = (int)valeur;           // applique
          SerialBT.println("maxerreurDistance mis à jour à " + String((int)valeur));  // accuse
          break;
        case 9:                                      // maxvitessemoteurangle
          maxvitessemoteurangle = (int)valeur;       // applique
          SerialBT.println("maxvitessemoteurangle mis à jour à " + String((int)valeur));  // accuse
          break;
        case 10:                                     // tempsdarretfin
          tempsdarretfin = (int)valeur;              // applique
          SerialBT.println("tempsdarretfin mis à jour à " + String((int)valeur));  // accuse
          break;
        case 11:                                     // maxpidangle
          maxpidangle = (int)valeur;                 // applique
          SerialBT.println("maxpidangle mis à jour à " + String((int)valeur));  // accuse
          break;
        case 12:                                     // maxanglediff
          maxanglediff = valeur;                     // applique
          SerialBT.println("maxanglediff mis à jour à " + String(valeur));  // accuse
          break;
        case 13:                                     // mindistancedupoint
          mindistancedupoint = valeur;               // applique
          SerialBT.println("mindistancedupoint mis à jour à " + String(valeur));  // accuse
          break;
        case 14:                                     // diffmmparpoint
          diffmmparpoint = valeur;                   // applique
          SerialBT.println("diffmmparpoint mis à jour à " + String(valeur));  // accuse
          break;
        case 15:                                     // rayoncercle
          rayoncercle = valeur;                      // applique
          SerialBT.println("rayoncercle mis à jour à " + String(valeur));  // accuse
          break;
        case 16:                                     // angleFin
          angleFin = valeur;                         // applique
          SerialBT.println("angleFin mis à jour à " + String(valeur));  // accuse
          break;
        case 17:                                     // debugMode
          debugMode = valeur > 0;                    // active/desactive le debug
          SerialBT.println("Mode debug " + String(debugMode ? "activé" : "désactivé"));  // accuse
          break;
        case 99:                                     // demarrage de la sequence
          variablewifibouton = true;                 // ... met le drapeau a true
          SerialBT.println("Démarrage de la séquence !");  // accuse
          break;
        default:                                     // numero inconnu
          SerialBT.println("Numéro de paramètre inconnu");  // message
      }
    } else if (commande == "aide" || commande == "?") {  // demande d'aide
      afficherListeParametres();                     // ... affiche la liste
    } else if (commande == "statut") {               // demande de statut
      afficherParametresActuels();                   // ... affiche les valeurs
    }
    else {                                           // commande non reconnue
      SerialBT.println("Format de commande invalide. Utilisez '<numéro> <valeur>' (ex: '1 0.5')");  // aide
      SerialBT.println("Ou tapez 'aide' pour la liste des paramètres, 'statut' pour les valeurs actuelles");  // aide
    }
  }
}


