double outputgauche = 0;                             // sortie du PID de roue gauche
double outputdroite = 0;                             // sortie du PID de roue droite

// Amene la roue GAUCHE a une consigne (en pas/10) via un PID de vitesse.
void deplacerRoueGauchePid(int consigne) {
  outputgauche = calculerPidGauche(encG/10, consigne);  // calcule la commande
