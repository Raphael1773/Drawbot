// Demande au correspondant Bluetooth d'envoyer des points (envoie "STP").
void demanderReceptionCoordonnees() {
  recubluetooth = RIEN;                              // remet le type de figure a "rien"
  stpenvoi = STPENENVOI;                             // marque l'envoi en cours
  SerialBT.flush();                                  // vide le tampon
  SerialBT.println();                                // ligne vide
  SerialBT.println("STP");                           // commande "STP"
  Serial.println("Demande de coordonnées envoyée");  // debug
  if (stpenvoi == STPPASFINI) {                      // si l'envoi precedent a echoue
    Serial.println("Pas bien envoyé");               // ... on reessaie
    SerialBT.flush();                                // ...
    SerialBT.println();                              // ...
    SerialBT.println("STP");                         // ...
  }
  stpenvoi = STPENVOIFINI;                           // marque l'envoi termine
}

float bluetoothX = 0;                                // X recu par Bluetooth
float bluetoothY = 0;                                // Y recu
float bluetoothX2 = 0;                               // X2 recu (pour un trait)
float bluetoothY2 = 0;                               // Y2 recu
float bluetoothRayon = 0;                            // rayon recu (cercle/rosace)
float bluetoothAngleDebut = 0;                       // angle de debut recu (cercle)
float bluetoothAngleFin = 0;                         // angle de fin recu (cercle)
int recubluetooth = 0;                               // type de figure recue (POS/TRAIT/CERCLE/...)

// Lit une trame Bluetooth et remplit les variables selon le type (P:/T:/C:/R:).
void recevoirCoordonnees() {
  if (SerialBT.available()) {                        // si une trame est dispo
    String data = SerialBT.readStringUntil('\n');    // lit la ligne
    Serial.println("Données reçues : " + data);      // debug

    if (data.startsWith("P:")) {                     // ----- une POSITION -----
      recubluetooth = POS;                           // type = position

      int indexEspace = data.indexOf(' ');           // cherche l'espace separateur
      if (indexEspace != -1) {                       // si trouve
        String xString = data.substring(2, indexEspace);  // sous-chaine X
        String yString = data.substring(indexEspace + 1);  // sous-chaine Y
        float x = xString.toFloat();                 // convertit X
        float y = yString.toFloat();                 // convertit Y
        Serial.println("Coordonnées reçues : " + String(x) + ", " + String(y));  // debug
        SerialBT.println("MERCI");                   // acquittement
        Serial.println("MERCI envoye");              // debug
        bluetoothX = x;                              // stocke X
        bluetoothY = y;                              // stocke Y
      }
      else {                                         // pas d'espace -> invalide
        Serial.println("Données non valides pour les coordonnées");  // debug
        SerialBT.println("ERR");                     // erreur
      }
    }
    else if (data.startsWith("T:")){                 // ----- un TRAIT (2 points) -----
      recubluetooth = TRAIT;                         // type = trait

      int indexEspace1 = data.indexOf(' ', 2);       // 1er espace
      int indexEspace2 = data.indexOf(' ', indexEspace1 + 1);  // 2e espace
      int indexEspace3 = data.indexOf(' ', indexEspace2 + 1);  // 3e espace
      if (indexEspace1 != -1 && indexEspace2 != -1 && indexEspace3 != -1) {  // si 3 espaces
        String xString = data.substring(2, indexEspace1);              // X
        String yString = data.substring(indexEspace1 + 1, indexEspace2);   // Y
        String x2String = data.substring(indexEspace2 + 1, indexEspace3);  // X2
        String y2String = data.substring(indexEspace3 + 1);            // Y2
        float x = xString.toFloat();                 // convertit X
        float y = yString.toFloat();                 // convertit Y
        float x2 = x2String.toFloat();               // convertit X2
        float y2 = y2String.toFloat();               // convertit Y2
        Serial.println("Coordonnées reçues : " + String(x) + ", " + String(y) + ", " + String(x2) + ", " + String(y2));  // debug
        SerialBT.println("MERCI");                   // acquittement
        Serial.println("MERCI envoye");              // debug
        bluetoothX = x;                              // stocke
        bluetoothY = y;                              // ...
        bluetoothX2 = x2;                            // ...
        bluetoothY2 = y2;                            // ...
      }
      else{                                          // format invalide
        Serial.println("Données non valides pour le trait");  // debug
        SerialBT.println("ERR");                     // erreur
      }
    }
    else if (data.startsWith("C:")){                 // ----- un CERCLE (5 parametres) -----
      recubluetooth = CERCLE;                        // type = cercle

      int indexEspace1 = data.indexOf(' ', 2);       // espaces separateurs...
      int indexEspace2 = data.indexOf(' ', indexEspace1 + 1);  // ...
      int indexEspace3 = data.indexOf(' ', indexEspace2 + 1);  // ...
      int indexEspace4 = data.indexOf(' ', indexEspace3 + 1);  // ...
      if (indexEspace1 != -1 && indexEspace2 != -1 && indexEspace3 != -1 && indexEspace4 != -1) {  // si 4 espaces
        String xString = data.substring(2, indexEspace1);                  // X
        String yString = data.substring(indexEspace1 + 1, indexEspace2);   // Y
        String rayonString = data.substring(indexEspace2 + 1, indexEspace3);       // rayon
        String angleDebutString = data.substring(indexEspace3 + 1, indexEspace4);  // angle debut
        String angleFinString = data.substring(indexEspace4 + 1);          // angle fin
        float x = xString.toFloat();                 // conversions...
        float y = yString.toFloat();                 // ...
        float rayon = rayonString.toFloat();         // ...
        float angleDebut = angleDebutString.toFloat();  // ...
        float angleFin = angleFinString.toFloat();   // ...
        Serial.println("Coordonnées reçues : " + String(x) + ", " + String(y) + ", " + String(rayon) + ", " + String(angleDebut) + ", " + String(angleFin));  // debug
        SerialBT.println("MERCI");                   // acquittement
        Serial.println("MERCI envoye");              // debug

        bluetoothX = x;                              // stocke
        bluetoothY = y;                              // ...
        bluetoothRayon = rayon;                      // ...
        bluetoothAngleDebut = angleDebut;            // ...
        bluetoothAngleFin = angleFin;                // ...
      }
      else{                                          // format invalide
        Serial.println("Données non valides pour le cercle");  // debug
        SerialBT.println("ERR");                     // erreur
      }
    }
    else if (data.startsWith("R:")){                 // ----- une ROSACE (3 parametres) -----
      recubluetooth = ROSACE;                        // type = rosace

      int indexEspace1 = data.indexOf(' ', 2);       // espaces...
      int indexEspace2 = data.indexOf(' ', indexEspace1 + 1);  // ...
      if (indexEspace1 != -1 && indexEspace2 != -1) {  // si 2 espaces
        String xString = data.substring(2, indexEspace1);              // X
        String yString = data.substring(indexEspace1 + 1, indexEspace2);   // Y
        String rayonString = data.substring(indexEspace2 + 1);         // rayon
        float x = xString.toFloat();                 // conversions...
        float y = yString.toFloat();                 // ...
        float rayon = rayonString.toFloat();         // ...
        Serial.println("Coordonnées reçues : " + String(x) + ", " + String(y) + ", " + String(rayon));  // debug
        SerialBT.println("MERCI");                   // acquittement
        Serial.println("MERCI envoye");              // debug

        bluetoothX = x;                              // stocke
        bluetoothY = y;                              // ...
        bluetoothRayon = rayon;                      // ...
      }
      else{                                          // format invalide
        Serial.println("Données non valides pour la rosace");  // debug
        SerialBT.println("ERR");                     // erreur
      }
    }
    else{                                            // entete inconnue
      Serial.println("Données non valides");         // debug
      SerialBT.println("ERR");                       // erreur
    }
  }
}

time_t lastRequestTime = 0;                          // horodatage de la derniere demande de points

// Boucle d'execution Bluetooth : selon la figure recue, lance le trace correspondant.
void executerCommande() {
  switch (recubluetooth) {                           // selon le type recu
    case RIEN:{                                      // rien recu
      recevoirCoordonnees();                         // ... on tente de recevoir

      time_t currentTime = millis();                 // temps courant
      if (currentTime - lastRequestTime > 1000) {    // toutes les secondes
        demanderReceptionCoordonnees();              // ... on redemande des points
        lastRequestTime = currentTime;               // ...
      }
      break;}
    case POS:                                        // une position
      Serial.println("Faire la trajectoire avec les coordonnées reçues");  // debug
      allerAuPoint(bluetoothX, bluetoothY);          // rejoint le point
      demanderReceptionCoordonnees();                // redemande
      break;
    case TRAIT:                                      // un trait
      Serial.println("Faire le trait avec les coordonnées reçues");  // debug
      tracerSegment(bluetoothX, bluetoothY, bluetoothX2, bluetoothY2);  // trace le trait
      demanderReceptionCoordonnees();                // redemande
      break;
    case CERCLE:                                     // un cercle
      Serial.println("Faire le cercle avec les coordonnées reçues");  // debug
      tracerCercle(bluetoothX, bluetoothY, bluetoothRayon, bluetoothAngleDebut, bluetoothAngleFin);  // trace
      demanderReceptionCoordonnees();                // redemande
      break;
    case ROSACE:                                     // une rosace
      Serial.println("Faire la rosace avec les coordonnées reçues");  // debug
      tracerRosace(bluetoothX, bluetoothY, bluetoothRayon);  // trace
      demanderReceptionCoordonnees();                // redemande
      break;
    default:                                         // cas non gere
      demanderReceptionCoordonnees();                // redemande
      delay(1000);                                   // attend
      recevoirCoordonnees();                         // tente de recevoir
      break;
  }
}

