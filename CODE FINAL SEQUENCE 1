// Initialise le magnetometre LIS3MDL (mode ultra haute resolution, 300 Hz).
void initMagnetometre() {
  Serial.println("Adafruit LIS3MDL test!");          // message
  if (!lis3mdl.begin_I2C(0x1E)) {                    // tente l'init I2C a l'adresse 0x1E
    Serial.println("Failed to find LIS3MDL chip");   // echec
    while (1) { delay(10); }                         // ... bloque ici
  }
  Serial.println("LIS3MDL Found!");                  // succes
  lis3mdl.setPerformanceMode(LIS3MDL_ULTRAHIGHMODE); // mode haute resolution
  lis3mdl.setOperationMode(LIS3MDL_CONTINUOUSMODE);  // mesure continue
  lis3mdl.setDataRate(LIS3MDL_DATARATE_300_HZ);      // 300 Hz
  lis3mdl.setRange(LIS3MDL_RANGE_4_GAUSS);           // plage +/-4 gauss
}

