double outputangle= 0;                               // sortie du PID d'angle (gyro)

float rayoncercle = 50;                              // rayon de cercle par defaut (reglable Bluetooth)
float angleFin = 3*PI+0.2;                           // angle de fin par defaut (reglable Bluetooth)

double Kp=2.0, Ki=0.12, Kd=0.0;                      // coefficients du PID de roue (vitesse)

float sommeErreurs = 0;                              // somme d'erreurs generique (non utilise partout)
float erreurPrecedente = 0;                          // erreur precedente generique

// PID de vitesse de la roue GAUCHE (coefficients Kp/Ki/Kd communs aux deux roues).
int calculerPidGauche(int input, int consigne) {
  static float sommeErreursgauche = 0;               // integrale (conservee entre appels)
  static float erreurPrecedentegauche = 0;           // erreur precedente

  float erreur = consigne - input;                   // ecart

  float termeP = Kp * erreur;                         // terme proportionnel

  sommeErreursgauche += erreur;                       // integrale
  float termeI = Ki * sommeErreursgauche;             // terme integral

  float termeD = Kd * (erreur - erreurPrecedentegauche);  // terme derive
  erreurPrecedentegauche = erreur;                    // memorise

  return termeP + termeI + termeD;                    // commande
}

// PID de vitesse de la roue DROITE.
int calculerPidDroit(int input, int consigne) {
  static float sommeErreursdroite = 0;               // integrale
  static float erreurPrecedentedroite = 0;           // erreur precedente

  float erreur = consigne - input;                   // ecart

  float termeP = Kp * erreur;                         // proportionnel

  sommeErreursdroite += erreur;                       // integrale
  float termeI = Ki * sommeErreursdroite;             // integral

  float termeD = Kd * (erreur - erreurPrecedentedroite);  // derive
  erreurPrecedentedroite = erreur;                    // memorise

  return termeP + termeI + termeD;                    // commande
}

// PID d'orientation base sur l'angle du GYROSCOPE (coefficients KpGyro/KiGyro/KdGyro).
int calculerPidGyro(float angleActuel, float angleCible) {
  static float sommeErreursGyro = 0;                 // integrale
  static float erreurPrecedenteGyro = 0;             // erreur precedente

  float erreur = angleCible - angleActuel;           // ecart angulaire

  float termeP = KpGyro * erreur;                     // proportionnel

  sommeErreursGyro += erreur;                          // integrale
  sommeErreursGyro = constrain(sommeErreursGyro, -2000, 2000);  // anti-emballement
  float termeI = KiGyro * sommeErreursGyro;            // integral

  float termeD = KdGyro * (erreur - erreurPrecedenteGyro);  // derive
  erreurPrecedenteGyro = erreur;                       // memorise
  Serial.print("erreur : ");                           // debug
  Serial.print(erreur);                                // ...
  Serial.print("   termeP : ");                        // ...
  Serial.print(termeP);                                // ...
  Serial.print("   termeI : ");                        // ...
  Serial.print(termeI);                                // ...
  Serial.print("   termeD : ");                        // ...
  Serial.println(termeD);                              // ...

  return termeP + termeI + termeD;                     // commande
}

// Maintient un cap donne en pilotant les deux roues via le PID gyroscopique.
void asservirAngleSeul(float anglecible){
  float correctionAngle = calculerPidGyro(lireAngleGyroscope(), anglecible);  // correction

  float vitesseGauche = -correctionAngle;            // les deux roues dans le meme sens (rotation sur place)
  float vitesseDroite = -correctionAngle;            // ...
  vitesseGauche = constrain(vitesseGauche, -255, 255);  // borne
  vitesseDroite = constrain(vitesseDroite, -255, 255);  // borne
  if (vitesseGauche > 0) {                           // roue gauche
    analogWrite(IN_1_G, vitesseGauche);              // avant
    analogWrite(IN_2_G, 0);                          // ...
  } else {                                           // ...
    analogWrite(IN_2_G, -vitesseGauche);             // arriere
    analogWrite(IN_1_G, 0);                          // ...
  }
  if (vitesseDroite > 0) {                           // roue droite
    analogWrite(IN_2_D, vitesseDroite);              // avant
    analogWrite(IN_1_D, 0);                          // ...
  } else {                                           // ...
    analogWrite(IN_1_D, -vitesseDroite);             // arriere
    analogWrite(IN_2_D, 0);                          // ...
  }
}

// Securite anti-bascule : si le robot penche trop, coupe les moteurs ; sinon maintient le cap.
void tenirDebout(float angleconsigne) {
  if (abs(lireAngleGyroscope() - angleconsigne) > 45) {  // si l'inclinaison depasse 45 deg
    analogWrite(IN_1_G, 0);                          // coupe roue gauche
    analogWrite(IN_2_G, 0);                          // ...
    analogWrite(IN_1_D, 0);                          // coupe roue droite
    analogWrite(IN_2_D, 0);                          // ...
    Serial.println("robot trop penché, arret commanderMoteur");  // message
    delay(200);                                      // pause
    return;                                          // ...
  }
  asservirAngleSeul(angleconsigne);                  // sinon, maintient le cap
}

int vitesseici = 150;                                // vitesse fixe pour allerAPosition

// Rejoint une position (x, y) par un pilotage simple roue par roue (sans PID fin).
void allerAPosition(float x, float y) {
  while(abs(posstyloX - x) > 50 || abs(posstyloY - y) > 50) {  // tant qu'on est loin (tolerance 50 mm)
    Serial.print("posstyloX : ");                    // debug
    Serial.print(posstyloX);                         // ...
    Serial.print(" posstyloY : ");                   // ...
    Serial.println(posstyloY);                       // ...
    if (posstyloX < x) {                             // si trop a gauche en X
      commanderMoteur(SENS_AVANT, vitesseici, MOTEUR_GAUCHE);   // roue gauche avant
    } else if (posstyloX > x) {                      // si trop a droite
      commanderMoteur(SENS_ARRIERE, vitesseici, MOTEUR_GAUCHE); // roue gauche arriere
    } else {                                         // sinon
      commanderMoteur(SENS_AVANT, 0, MOTEUR_GAUCHE); // roue gauche stop
    }
    if (posstyloY < y) {                             // idem en Y avec la roue droite
      commanderMoteur(SENS_AVANT, vitesseici, MOTEUR_DROIT);    // ...
    } else if (posstyloY > y) {                      // ...
      commanderMoteur(SENS_ARRIERE, vitesseici, MOTEUR_DROIT);  // ...
    } else {                                         // ...
      commanderMoteur(SENS_AVANT, 0, MOTEUR_DROIT);  // ...
    }
    delay(10);                                       // laisse bouger
    commanderMoteur(SENS_AVANT, 0, MOTEUR_GAUCHE);   // stop gauche
    commanderMoteur(SENS_AVANT, 0, MOTEUR_DROIT);    // stop droit
    delay(10);                                       // pause
  }
}

