// Envoie la position courante du stylo via Bluetooth (format "P: x y").
void envoyerCoordonnees() {
  calculerPositionStylo();                           // met a jour la position
  if (stpenvoi == STPENENVOI) {                      // si un envoi est deja en cours
    Serial.println("Envoi des coordonnées annulé");  // ... on annule
