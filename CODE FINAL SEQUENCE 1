// Commande generique d'un moteur par sens + vitesse + numero (1 = droit, sinon gauche).
void commanderMoteur(int sens, int vitessemot, int numeroMoteur) {
  if (numeroMoteur == 1) {                  // si on pilote le moteur droit
    if (sens == SENS_AVANT) {               // sens avant demande
      analogWrite(IN_1_D, 0);                // IN1 droite a 0
      analogWrite(IN_2_D, vitessemot);       // IN2 droite a la vitesse -> avance
    } else {                                // sinon sens arriere
      analogWrite(IN_1_D, vitessemot);       // IN1 droite a la vitesse -> recule
      analogWrite(IN_2_D, 0);                // IN2 droite a 0
    }
  } else {                                  // sinon on pilote le moteur gauche
    if (sens == SENS_AVANT) {               // sens avant demande
      analogWrite(IN_1_G, vitessemot);       // IN1 gauche a la vitesse -> avance
      analogWrite(IN_2_G, 0);                // IN2 gauche a 0
    } else {                                // sinon sens arriere
      analogWrite(IN_1_G, 0);                // IN1 gauche a 0
      analogWrite(IN_2_G, vitessemot);       // IN2 gauche a la vitesse -> recule
    }
  }
}

// Pilote le moteur GAUCHE avec une vitesse signee (+ = avant, - = arriere, plage utile +/-255).
void commanderMoteurGauche(int vitesse) {
  if (vitesse > 255) vitesse = 255;                        // plafonne a +255 (PWM 8 bits)
  else if (vitesse < -255) vitesse = -255;                 // plancher a -255
  if (vitesse > 0 && vitesse < PWM_MIN) vitesse = PWM_MIN;  // force le minimum si commande avant trop faible
  else if (vitesse < 0 && vitesse > -PWM_MIN) vitesse = -PWM_MIN;  // idem en arriere

  if (vitesse > 0) {                        // vitesse positive -> marche avant
    analogWrite(IN_1_G, vitesse);            // IN1 gauche recoit le PWM
    analogWrite(IN_2_G, 0);                  // IN2 gauche a 0
  } else {                                  // vitesse negative (ou nulle) -> marche arriere
    analogWrite(IN_1_G, 0);                  // IN1 gauche a 0
    analogWrite(IN_2_G, -vitesse);           // IN2 gauche recoit la valeur absolue
  }
}

// Pilote le moteur DROIT avec une vitesse signee (les broches IN1/IN2 sont inversees vs gauche).
void commanderMoteurDroit(int vitesse) {
  if (vitesse > 255) vitesse = 255;                        // plafonne a +255
  else if (vitesse < -255) vitesse = -255;                 // plancher a -255
  if (vitesse > 0 && vitesse < PWM_MIN) vitesse = PWM_MIN;  // force le minimum si commande avant trop faible
  else if (vitesse < 0 && vitesse > -PWM_MIN) vitesse = -PWM_MIN;  // idem en arriere

  if (vitesse > 0) {                        // vitesse positive -> marche avant
    analogWrite(IN_1_D, 0);                  // IN1 droite a 0
    analogWrite(IN_2_D, vitesse);            // IN2 droite recoit le PWM
  } else {                                  // vitesse negative (ou nulle) -> marche arriere
    analogWrite(IN_1_D, -vitesse);           // IN1 droite recoit la valeur absolue
    analogWrite(IN_2_D, 0);                  // IN2 droite a 0
  }
}


