// Lit le moniteur SERIE et met a jour les coefficients PID (format "1 Kp Ki Kd Setpoint").
void reglerPidParSerie() {
  if (Serial.available() > 0) {                      // si une ligne est dispo
    String input = Serial.readStringUntil('\n');     // lit la ligne
    input.trim();                                    // enleve espaces/retours

    char mode = input.charAt(0);                     // 1er caractere = mode (1 angle / 0 distance)
    input = input.substring(1);                      // le reste = les valeurs

    float newKp, newKi, newKd, newSetpoint;          // valeurs lues
    int parsed = sscanf(input.c_str(), "%f %f %f %f", &newKp, &newKi, &newKd, &newSetpoint);  // parse 4 nombres

    if (parsed == 4) {                               // si les 4 valeurs sont presentes
      if (mode == '1') {                             // mode angle
        KpAngle = newKp;                             // applique
        KiAngle = newKi;                             // ...
        KdAngle = newKd;                             // ...
        Setpoint = newSetpoint;                      // ...

        Serial.println("Coefficients PID pour l'angle mis à jour :");  // accuse de reception
        Serial.print("KpAngle = ");                  // ...
        Serial.println(KpAngle);                     // ...
        Serial.print("KiAngle = ");                  // ...
        Serial.println(KiAngle);                     // ...
        Serial.print("KdAngle = ");                  // ...
        Serial.println(KdAngle);                     // ...
        Serial.print("Setpoint = ");                 // ...
        Serial.println(Setpoint);                    // ...
      } else if (mode == '0') {                      // mode distance
        KpDistance = newKp;                          // applique
        KiDistance = newKi;                          // ...
        KdDistance = newKd;                          // ...
        Setpoint = newSetpoint;                      // ...

        Serial.println("Coefficients PID pour la distance mis à jour :");  // accuse de reception
        Serial.print("KpDistance = ");               // ...
        Serial.println(KpDistance);                  // ...
        Serial.print("KiDistance = ");               // ...
        Serial.println(KiDistance);                  // ...
        Serial.print("KdDistance = ");               // ...
        Serial.println(KdDistance);                  // ...
        Serial.print("Setpoint = ");                 // ...
        Serial.println(Setpoint);                    // ...
      }
      else if (mode == '2') {                        // mode 2 : demande de demarrage
        variablewifi = true;                         // ...
      }else {                                        // mode inconnu
        Serial.println("Erreur : Le premier caractère doit être '1' (angle) ou '0' (distance).");  // message
      }
    } else {                                         // mauvais format
      Serial.println("Erreur : Entrez les valeurs sous la forme '1 Kp Ki Kd Setpoint' ou '0 Kp Ki Kd Setpoint'");  // aide
    }
  }
}

