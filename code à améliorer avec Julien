const float CALIB_X_OFFSET = -2045.0;
const float CALIB_Y_OFFSET =   654.0;
const float CALIB_X_SCALE  =  1857.0;
const float CALIB_Y_SCALE  =  1922.0;

// Sensibilite gyro : DOIT correspondre a la plage configuree dans setup().
// 4.375(+-125) / 8.75(+-245) / 17.5(+-500) / 70(+-2000)  en mdps/LSB
const float GYRO_SENS_MDPS_LSB = 8.75f;

// Configuration PID d'origine
uint32_t tDerniereCorr = 0;
const float Kp = 0.8;
const float Kd = 0.3;

const float Kp_rotation = 0.3;
const float Kd_rotation = 0.1;

long ecartPrecedent  = 0;
int correctionDynamique = 0;

// =====================================================================
//  SEQUENCE AUTONOME "ESCALIER"
//      (0,0) -> (150,0) -> (150,200) -> (350,200)   (coordonnees en mm)
//  Cibles a atteindre depuis (0,0) : (150,0) puis (150,200) puis (350,200).
// =====================================================================

const int   NB_POINTS_ESCALIER = 3;
const float CIBLE_X_MM[NB_POINTS_ESCALIER] = { 150.0, 150.0, 350.0 };
const float CIBLE_Y_MM[NB_POINTS_ESCALIER] = {   0.0, 200.0, 200.0 };

const float SEUIL_DISTANCE_CM   = 0.7;    // point atteint sous 7 mm
const float SEUIL_ANGLE_ENTREE  = 0.10;   // rad (~6 deg)
const float SEUIL_ANGLE_SORTIE  = 0.30;   // rad (~17 deg)

const bool  INVERSER_SENS_ROTATION = false;

enum PhaseSequence { SEQ_INACTIVE, SEQ_ROTATION, SEQ_AVANCE };
PhaseSequence phaseSequence = SEQ_INACTIVE;
bool  sequenceActive = false;
int   indexPointEscalier = 0;

void writeReg(uint8_t addr, uint8_t reg, uint8_t val) {
  Wire.beginTransmission(addr); Wire.write(reg); Wire.write(val); Wire.endTransmission();
}

int16_t read16(uint8_t addr, uint8_t reg) {
  Wire.beginTransmission(addr); Wire.write(reg | 0x80); Wire.endTransmission(false);
  Wire.requestFrom(addr, (uint8_t)2);
  return (int16_t)(Wire.read() | (Wire.read() << 8));
}

void initLIS3MDL() {
  writeReg(LIS3MDL_ADDR, LIS3_CTRL1, 0x7E);
  writeReg(LIS3MDL_ADDR, LIS3_CTRL2, 0x00);
  writeReg(LIS3MDL_ADDR, LIS3_CTRL3, 0x00);
  writeReg(LIS3MDL_ADDR, LIS3_CTRL4, 0x0C);
}

void calibrerGyro() {
  long somme = 0;
  for (int i = 0; i < 300; i++) { somme += myIMU.readRawGyroZ(); delay(4); }
  gyroBiasZ = (float)somme / 300.0;
}

float obtenirCapMagnetometre() {
  int16_t mx = read16(LIS3MDL_ADDR, LIS3_OUT_X_L);
  int16_t my = read16(LIS3MDL_ADDR, LIS3_OUT_X_L + 2);
  float nx = (mx - CALIB_X_OFFSET) / CALIB_X_SCALE;
  float ny = (my - CALIB_Y_OFFSET) / CALIB_Y_SCALE;
  float cap = atan2(-ny, nx) * 180.0 / PI;
  if (cap < 0) cap += 360.0;
  if (INVERSER_CAP) cap = 360.0 - cap;
  return cap;
}

void executerFiltreKalman() {
  uint32_t maintenant = millis();
  float dt = (maintenant - tDernierKalman) / 1000.0f;
  if (dt < 0.005f) return;
  tDernierKalman = maintenant;

  float gyroCorrige = myIMU.readRawGyroZ() - gyroBiasZ;
  float vitesseAngulaireZ = gyroCorrige * GYRO_SENS_MDPS_LSB / 1000.0f;
  if (INVERSER_GYRO) vitesseAngulaireZ = -vitesseAngulaireZ;
  capGlobal = fKalman.update(obtenirCapMagnetometre(), vitesseAngulaireZ, dt);
}

void reinitialiserRepereCartesien() {
  noInterrupts();
  pasDroit = 0; pasGauche = 0;
  ticksOdoDroit = 0; ticksOdoGauche = 0;
  interrupts();

  pasDroitPrev = 0; pasGauchePrev = 0;
  pasDroitOdoPrev = 0; pasGaucheOdoPrev = 0;

  capInitialAuReset = capGlobal;

  Centre_Robot_X = -DISTANCE_MI_ENTRAXE_STYLO;
  Centre_Robot_Y = 0.0;

  x_stylo = 0.0;
  y_stylo = 0.0;

  capGlobalPrev = capGlobal;
}

void definirCommande(const String& c) {
  if (c != commandeEnCours) {
    noInterrupts(); pasDroit = 0; pasGauche = 0; interrupts();
    ecartPrecedent = 0; correctionDynamique = 0;
  }
  commandeEnCours = c;
}

void demarrerSequenceEscalier() {
  reinitialiserRepereCartesien();
  indexPointEscalier = 0;
  phaseSequence = SEQ_ROTATION;
  sequenceActive = true;
}

void arreterSequence() {
  sequenceActive = false;
  phaseSequence = SEQ_INACTIVE;
  definirCommande("stop");
}

void gererSequenceEscalier() {
  if (!sequenceActive) return;

  // Cible courante en cm. Echange X/Y optionnel (dessin physique transpose).
  float cibleX, cibleY;
  if (ECHANGER_CIBLES) {
    cibleX = CIBLE_Y_MM[indexPointEscalier] / 10.0;
    cibleY = CIBLE_X_MM[indexPointEscalier] / 10.0;
  } else {
    cibleX = CIBLE_X_MM[indexPointEscalier] / 10.0;
    cibleY = CIBLE_Y_MM[indexPointEscalier] / 10.0;
  }

  float dx = cibleX - x_stylo;
  float dy = cibleY - y_stylo;
  float distance = sqrt(dx * dx + dy * dy);

  if (distance < SEUIL_DISTANCE_CM) {
    indexPointEscalier++;
    if (indexPointEscalier >= NB_POINTS_ESCALIER) {
      arreterSequence();
      return;
    }
    phaseSequence = SEQ_ROTATION;
    definirCommande("stop");
    return;
  }

  float capVoulu  = atan2(dy, dx);
  float capActuel = (capGlobal - capInitialAuReset) * PI / 180.0;

  float erreurAngle = capVoulu - capActuel;
  while (erreurAngle >  PI) erreurAngle -= 2 * PI;
  while (erreurAngle < -PI) erreurAngle += 2 * PI;

  if (phaseSequence == SEQ_ROTATION) {
    if (fabs(erreurAngle) < SEUIL_ANGLE_ENTREE) phaseSequence = SEQ_AVANCE;
  } else {
    if (fabs(erreurAngle) > SEUIL_ANGLE_SORTIE) phaseSequence = SEQ_ROTATION;
  }

  if (phaseSequence == SEQ_ROTATION) {
    bool tournerGauche = (erreurAngle > 0.0);
    if (INVERSER_SENS_ROTATION) tournerGauche = !tournerGauche;
    definirCommande(tournerGauche ? "rotation_gauche" : "rotation_droite");
  } else {
    definirCommande("avancer");
  }
}

void corrigerPD() {
  if (commandeEnCours == "stop") { correctionDynamique = 0; return; }
  if (millis() - tDerniereCorr < 10) return;
  tDerniereCorr = millis();

  noInterrupts(); long tD = pasDroit; long tG = pasGauche; interrupts();

  long ecart = 0;
  float kp_actuel = Kp;
  float kd_actuel = Kd;

  if (commandeEnCours == "avancer" || commandeEnCours == "reculer") {
    ecart = tD - tG;
    kp_actuel = Kp;
    kd_actuel = Kd;
  }
  else if (commandeEnCours == "rotation_gauche" || commandeEnCours == "rotation_droite") {
    ecart = abs(tD) - abs(tG);
    kp_actuel = Kp_rotation;
    kd_actuel = Kd_rotation;
  }
  else if (commandeEnCours == "vag") {
    ecart = tG - (long)(tD * RATIO_VIRAGE);
  }
  else if (commandeEnCours == "vad") {
    ecart = tD - (long)(tG * RATIO_VIRAGE);
  }
  else if (commandeEnCours == "veg") {
    ecart = abs(tG) - (long)(abs(tD) * RATIO_VIRAGE);
  }
  else if (commandeEnCours == "ved") {
    ecart = abs(tD) - (long)(abs(tG) * RATIO_VIRAGE);
  }

  correctionDynamique = (int)((ecart * kp_actuel) + ((ecart - ecartPrecedent) * kd_actuel));
  ecartPrecedent = ecart;
}

void calculerVitesse() {
  if (millis() - tDerniereVit < INTERVALLE_VITESSE_MS) return;
  float dt = (millis() - tDerniereVit) / 1000.0; tDerniereVit = millis();
  noInterrupts(); long d = pasDroit; long g = pasGauche; interrupts();
  vitesseDcms = ((d - pasDroitPrev) / dt) * CM_PAR_TICK;
  vitesseGcms = ((g - pasGauchePrev) / dt) * CM_PAR_TICK;
  pasDroitPrev  = d; pasGauchePrev = g;
}

void mettreAJourOdometrie() {
  if (millis() - tDerniereOdo < 10) return;
  tDerniereOdo = millis();

  noInterrupts(); 
  long actuelsD = ticksOdoDroit; 
  long actuelsG = ticksOdoGauche; 

  interrupts();

  long deltaTicksD = actuelsD - pasDroitOdoPrev; 
  long deltaTicksG = actuelsG - pasGaucheOdoPrev;

  pasDroitOdoPrev  = actuelsD; 
  pasGaucheOdoPrev = actuelsG;

  // ROBOT A L'ARRET : on fige la pose. Sinon le bruit/derive du cap fait
  // "bouger" le stylo (amplifie par l'offset stylo de 127 mm) alors qu'il
  // est immobile. On garde les references a jour pour ne pas sauter au depart.
  if (commandeEnCours == "stop") {
    capGlobalPrev = capGlobal;
    return;
  }

  float distD = (float)deltaTicksD * CM_PAR_TICK;
  float distG = (float)deltaTicksG * CM_PAR_TICK;
  // Signe porte par les ticks SIGNES : en rotation pure distD ~= -distG -> somme ~ 0.
  float deltaDCentre = (distD + distG) / 2.0;

  // Moyenne d'angle sans saut au passage 360 -> 0
  float delta = capGlobal - capGlobalPrev;
  if (delta >  180.0) delta -= 360.0;
  if (delta < -180.0) delta += 360.0;
  float angleMoyenDeg = capGlobalPrev + delta / 2.0;
  capGlobalPrev = capGlobal;

  float capVirtuelDeg = angleMoyenDeg - capInitialAuReset;
  float capRad = capVirtuelDeg * PI / 180.0;

  // Calcul interne INCHANGE (ne pas permuter cos/sin ici : l'offset stylo
  // et le sens de rotation y sont cales). L'echange X/Y se fait a l'affichage.
  Centre_Robot_X += deltaDCentre * cos(capRad);
  Centre_Robot_Y += deltaDCentre * sin(capRad);

  x_stylo = Centre_Robot_X + DISTANCE_MI_ENTRAXE_STYLO * cos(capRad);
  y_stylo = Centre_Robot_Y + DISTANCE_MI_ENTRAXE_STYLO * sin(capRad);
}

