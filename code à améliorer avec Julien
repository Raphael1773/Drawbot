// NB : si une roue compte a l'envers (la position part dans le mauvais sens
// quand le robot avance tout droit), inverser le --/++ de CETTE roue uniquement.
void IRAM_ATTR ISR_Droit() {
  pasDroit++;
  if (digitalRead(ENC_D_CH_B)) ticksOdoDroit--;
  else                         ticksOdoDroit++;
}
void IRAM_ATTR ISR_Gauche() {
  pasGauche++;
  if (digitalRead(ENC_G_CH_B)) ticksOdoGauche--;
  else                         ticksOdoGauche++;
}

