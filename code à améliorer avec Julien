#include <Arduino.h>
#include <ArduinoOTA.h>
#include <WiFi.h>
#include <WiFiServer.h>
#include <WebServer.h>
#include <Wire.h>
#include <SparkFunLSM6DS3.h> 

// --- CONFIGURATION MATÉRIELLE ---
#define EN_D 23
#define EN_G  4
#define IN_1_D 19
#define IN_2_D 18
#define IN_1_G 17
#define IN_2_G 16
#define ENC_G_CH_A 32
#define ENC_D_CH_A 27

// --- CONSTANTES PHYSIQUES ---
const float DISTANCE_STYLO_CM = 12.70; 
const float TICKS_PAR_TOUR = 1050.0;
const float DIAM_ROUE_CM = 9.0;
const float CM_PAR_TICK = (PI * DIAM_ROUE_CM) / TICKS_PAR_TOUR; 

// --- VARIABLES ODOMÉTRIE & FILTRAGE ---
volatile long pasDroit = 0, pasGauche = 0;
long pasDroitPrev = 0, pasGauchePrev = 0;

float Centre_Robot_X = -DISTANCE_STYLO_CM; 
float Centre_Robot_Y = 0.0;
float capGlobal = 0.0; 
float capInitial = 0.0;
float x_stylo = 0.0, y_stylo = 0.0;
float x_s_f = 0.0, y_s_f = 0.0; 
const float ALPHA = 0.15; 

// --- VARIABLES PID ---
const int PWR_BASE = 180;
const int PWR_MIN = 150; 
const float DEADBAND = 0.3; 

float Kp_ligne = 14.0; 
float Kd_ligne = 5.0;
float Kp_cap_suivi = 1.5; 
float erreurLatPrev = 0;

float Kp_rot = 3.5; 

// --- ÉTAT DU ROBOT ---
String commandeEnCours = "stop";
bool modeAuto = false;
int etapeSeq = 0;
uint32_t tDerniereOdo = 0;

LSM6DS3 myIMU(I2C_MODE, 0x6B);
WebServer server(80);

void IRAM_ATTR ISR_Droit()  { pasDroit++; }
void IRAM_ATTR ISR_Gauche() { pasGauche++; }

void piloterMoteurs(int pG, int pD, bool avG, bool avD) {
  digitalWrite(IN_1_G, avG ? HIGH : LOW); digitalWrite(IN_2_G, avG ? LOW : HIGH);
  digitalWrite(IN_1_D, avD ? LOW : HIGH); digitalWrite(IN_2_D, avD ? HIGH : LOW);
  ledcWrite(0, constrain(abs(pD), 0, 255));
  ledcWrite(1, constrain(abs(pG), 0, 255));
}

void mettreAJourOdometrie() {
  uint32_t maintenant = millis();
  float dt = (maintenant - tDerniereOdo) / 1000.0;
  if (dt < 0.01) return;
  tDerniereOdo = maintenant;

  float gyroZ = myIMU.readFloatGyroZ();
  if (abs(gyroZ) > 0.5) capGlobal += gyroZ * dt;

  noInterrupts(); long d = pasDroit; long g = pasGauche; interrupts();
  float dD = (float)(d - pasDroitPrev) * CM_PAR_TICK;
  float dG = (float)(g - pasGauchePrev) * CM_PAR_TICK;
  pasDroitPrev = d; pasGauchePrev = g;

  float deltaDist = (dD + dG) / 2.0;
  float capRad = (capGlobal - capInitial) * PI / 180.0;

  Centre_Robot_X += deltaDist * cos(capRad);
  Centre_Robot_Y += deltaDist * sin(capRad);

  x_stylo = Centre_Robot_X + DISTANCE_STYLO_CM * cos(capRad);
  y_stylo = Centre_Robot_Y + DISTANCE_STYLO_CM * sin(capRad);

  x_s_f = (ALPHA * x_stylo) + (1.0 - ALPHA) * x_s_f;
  y_s_f = (ALPHA * y_stylo) + (1.0 - ALPHA) * y_s_f;
}

void suivreLigne(float cibleLat, float cibleCap, bool axeX) {
  float erreurLat = axeX ? (cibleLat - x_s_f) : (cibleLat - y_s_f);
  if (abs(erreurLat) < DEADBAND) erreurLat = 0;

  float erreurCap = cibleCap - capGlobal;
  while(erreurCap > 180) erreurCap -= 360; while(erreurCap < -180) erreurCap += 360;

  float correction = (erreurLat * Kp_ligne) + ((erreurLat - erreurLatPrev) * Kd_ligne) + (erreurCap * Kp_cap_suivi);
  erreurLatPrev = erreurLat;

  int pG = constrain(PWR_BASE + (int)correction, PWR_MIN, 240);
  int pD = constrain(PWR_BASE - (int)correction, PWR_MIN, 240);
  piloterMoteurs(pG, pD, true, true);
}

bool tournerSurPlace(float angleCible) {
  float erreur = angleCible - capGlobal;
  while(erreur > 180) erreur -= 360; while(erreur < -180) erreur += 360;
  if (abs(erreur) < 1.5) { piloterMoteurs(0,0,1,1); return true; }
  int pwr = constrain(abs(erreur * Kp_rot) + PWR_MIN, PWR_MIN, 210);
  if (erreur > 0) piloterMoteurs(pwr, pwr, false, true); 
  else piloterMoteurs(pwr, pwr, true, false); 
  return false;
}

// --- MACHINE À ÉTATS CORRIGÉE (AVEC ACCOLADES) ---
void gererSequence1() {
  if (!modeAuto) return;

  switch(etapeSeq) {
    case 0: {
      suivreLigne(0.0, capInitial, false); 
      if (x_s_f >= 20.0) { etapeSeq = 1; erreurLatPrev = 0; delay(300); }
      break;
    }
    case 1: {
      if (tournerSurPlace(capInitial + 90.0)) { etapeSeq = 2; erreurLatPrev = 0; delay(300); }
      break;
    }
    case 2: {
      float errX = 20.0 - x_s_f;
      int corr = (int)(errX * Kp_ligne);
      piloterMoteurs(PWR_BASE - corr, PWR_BASE + corr, true, true);
      if (y_s_f >= 10.0) { etapeSeq = 3; delay(300); }
      break;
    }
    case 3: {
      if (tournerSurPlace(capInitial)) { etapeSeq = 4; erreurLatPrev = 0; delay(300); }
      break;
    }
    case 4: {
      suivreLigne(10.0, capInitial, false);
      if (x_s_f >= 60.0) { modeAuto = false; commandeEnCours = "stop"; }
      break;
    }
  }
}

void handleRoot() {
  String html = "<html><head><meta charset='UTF-8'><meta name='viewport' content='width=device-width,initial-scale=1'><style>";
  html += "body{background:#111;color:#fff;text-align:center;font-family:sans-serif;} .btn{padding:20px;margin:5px;width:90px;font-size:1.2rem;border-radius:10px;border:none;background:#333;color:white;}";
  html += ".spec{width:290px;background:#058;} .stop{background:#811;width:290px;}";
  html += ".data{background:#222;padding:15px;margin:20px;border-radius:10px;display:inline-block;text-align:left;font-family:monospace;}";
  html += "</style></head><body><h1>DRAW GOAT v2</h1>";
  html += "<div><button class='btn' onmousedown='s(\"avancer\")' onmouseup='s(\"stop\")'>⬆</button></div>";
  html += "<div><button class='btn' onmousedown='s(\"rotation_gauche\")' onmouseup='s(\"stop\")'>↺</button><button class='btn' onmousedown='s(\"rotation_droite\")' onmouseup='s(\"stop\")'>↻</button></div>";
  html += "<div><button class='btn stop' onclick='s(\"stop\")'>STOP</button></div>";
  html += "<div><button class='btn spec' onclick='s(\"sequence1\")'>🚀 LANCER SÉQUENCE ESCALIER</button></div>";
  html += "<div><button class='btn spec' style='background:#444' onclick='fetch(\"/reset\")'>🎯 RESET REPÈRE</button></div>";
  html += "<div class='data'>X Stylo: <span id='x'>0</span> mm<br>Y Stylo: <span id='y'>0</span> mm<br>Cap: <span id='c'>0</span>°</div>";
  html += "<script>function s(a){fetch('/cmd?a='+a);} setInterval(async()=>{const r=await fetch('/pos');const d=await r.json();";
  html += "document.getElementById('x').innerText=(d.x*10).toFixed(0);document.getElementById('y').innerText=(d.y*10).toFixed(0);";
  html += "document.getElementById('c').innerText=d.c.toFixed(1);},200);</script></body></html>";
  server.send(200, "text/html", html);
}

void setup() {
  Serial.begin(115200);
  pinMode(IN_1_D, OUTPUT); pinMode(IN_2_D, OUTPUT);
  pinMode(IN_1_G, OUTPUT); pinMode(IN_2_G, OUTPUT);
  ledcSetup(0, 5000, 8); ledcAttachPin(EN_D, 0);
  ledcSetup(1, 5000, 8); ledcAttachPin(EN_G, 1);
  attachInterrupt(ENC_D_CH_A, ISR_Droit, RISING);
  attachInterrupt(ENC_G_CH_A, ISR_Gauche, RISING);

  WiFi.softAP("Draw_GOAT_V2", "12345678");
  server.on("/", handleRoot);
  server.on("/cmd", [](){
    String a = server.arg("a");
    if(a == "sequence1") { modeAuto = true; etapeSeq = 0; }
    else { modeAuto = false; commandeEnCours = a; }
    server.send(200);
  });
  server.on("/pos", [](){
    String j = "{\"x\":"+String(x_s_f)+",\"y\":"+String(y_s_f)+",\"c\":"+String(capGlobal)+"}";
    server.send(200, "application/json", j);
  });
  server.on("/reset", [](){
    Centre_Robot_X = -DISTANCE_STYLO_CM; Centre_Robot_Y = 0;
    capInitial = capGlobal; x_s_f = 0; y_s_f = 0;
    server.send(200);
  });
  server.begin();
  Wire.begin(21, 22);
  myIMU.begin();
  tDerniereOdo = millis();
}

void loop() {
  server.handleClient();
  mettreAJourOdometrie();

  if (modeAuto) {
    gererSequence1();
  } else {
    if(commandeEnCours == "avancer") piloterMoteurs(200, 200, true, true);
    else if(commandeEnCours == "rotation_gauche") piloterMoteurs(180, 180, false, true);
    else if(commandeEnCours == "rotation_droite") piloterMoteurs(180, 180, true, false);
    else if(commandeEnCours == "stop") piloterMoteurs(0, 0, true, true);
  }
}
