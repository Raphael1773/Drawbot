// Calibration magnétomètre
float dynamic_X_OFFSET = -2237.0; float dynamic_Y_OFFSET = 1026.5;
float dynamic_X_SCALE  =  1169.0; float dynamic_Y_SCALE  = 1285.5;

// *** CORRECTION 3 : déclarations avancées pour que mettreAJourOdometrie puisse les utiliser ***
long ticksOdoDroitPrev  = 0;
long ticksOdoGauchePrev = 0;

// --- DÉCLARATIONS ANTICIPÉES ---
void executerFiltreKalman();
void mettreAJourOdometrie();
void stopMoteurs();

// --- FONCTIONS MOTEURS BAS NIVEAU ---
void stopMoteurs() {
  ledcWrite(canalDroit, 0);
  ledcWrite(canalGauche, 0);
  digitalWrite(IN_1_D, LOW); digitalWrite(IN_2_D, LOW);
  digitalWrite(IN_1_G, LOW); digitalWrite(IN_2_G, LOW);
}

// --- FONCTIONS NAVIGATION ---

void transitionVirageSerre(float angleVouluRelatif) {
  float cibleCap = capInitialAuReset + angleVouluRelatif;
  while (cibleCap <    0) cibleCap += 360;
  while (cibleCap >= 360) cibleCap -= 360;

  bool gauche = angleVouluRelatif > (capGlobal - capInitialAuReset);

  while (abs(capGlobal - cibleCap) > 4.0) {
    executerFiltreKalman();
    mettreAJourOdometrie();

    if (gauche) {
      digitalWrite(IN_1_D, LOW);  digitalWrite(IN_2_D, HIGH); // Droite AV
      digitalWrite(IN_1_G, LOW);  digitalWrite(IN_2_G, HIGH); // Gauche AR
      ledcWrite(canalDroit,  PWR_ROT_SERRE);
      ledcWrite(canalGauche, PWR_ROT_SERRE / 2);
    } else {
      digitalWrite(IN_1_D, HIGH); digitalWrite(IN_2_D, LOW);  // Droite AR
      digitalWrite(IN_1_G, HIGH); digitalWrite(IN_2_G, LOW);  // Gauche AV
      ledcWrite(canalDroit,  PWR_ROT_SERRE / 2);
      ledcWrite(canalGauche, PWR_ROT_SERRE);
    }
    delay(10);
  }
  stopMoteurs();
}

void suivreLignePrecision(float xB, float yB, int pwrBase) {
  float dist = 100.0;
  while (dist > 1.0) {
    executerFiltreKalman();
    mettreAJourOdometrie();

    float dx = xB - x_stylo;
    float dy = yB - y_stylo;
    dist = sqrt(dx * dx + dy * dy);

    float capCible = atan2(dy, dx) * 180.0 / PI;
    float erreurCap = capCible - (capGlobal - capInitialAuReset);

    while (erreurCap >  180) erreurCap -= 360;
    while (erreurCap < -180) erreurCap += 360;

    int correction = (int)(erreurCap * K_P_CAP);

    digitalWrite(IN_1_D, LOW);  digitalWrite(IN_2_D, HIGH);
    digitalWrite(IN_1_G, HIGH); digitalWrite(IN_2_G, LOW);
    ledcWrite(canalDroit,  constrain(pwrBase - correction, 0, 255));
    ledcWrite(canalGauche, constrain(pwrBase + correction, 0, 255));

    if (commandeEnCours == "stop") return;
    delay(10);
  }
  stopMoteurs();
}

void executerSequenceEscalier() {
  Serial.println("Lancement Escalier...");

  // Segment 1 : 20 cm en avant (X)
  suivreLignePrecision(20.0, 0.0, 180);

  // Virage 1 : 90° à gauche
  transitionVirageSerre(90.0);

  // Segment 2 : 10 cm vers le haut (Y)
  suivreLignePrecision(20.0, 10.0, 150);

  // Virage 2 : 90° à droite (retour cap 0°)
  transitionVirageSerre(0.0);

  // Segment 3 : 40 cm en avant (X)
  suivreLignePrecision(60.0, 10.0, 180);

  commandeEnCours = "stop";
  stopMoteurs();
  Serial.println("Séquence terminée.");
}

// --- LOGIQUE CAPTEURS ---

void writeReg(uint8_t addr, uint8_t reg, uint8_t val) {
  Wire.beginTransmission(addr); Wire.write(reg); Wire.write(val); Wire.endTransmission();
}

int16_t read16(uint8_t addr, uint8_t reg) {
  Wire.beginTransmission(addr); Wire.write(reg | 0x80); Wire.endTransmission(false);
  Wire.requestFrom(addr, (uint8_t)2);
  return (int16_t)(Wire.read() | (Wire.read() << 8));
}

void initLIS3MDL() {
  writeReg(LIS3MDL_ADDR, LIS3_CTRL1, 0x7E);
  writeReg(LIS3MDL_ADDR, LIS3_CTRL2, 0x00);
  writeReg(LIS3MDL_ADDR, LIS3_CTRL3, 0x00);
  writeReg(LIS3MDL_ADDR, LIS3_CTRL4, 0x0C);
}

void calibrerGyro() {
  long somme = 0;
  for (int i = 0; i < 300; i++) { somme += myIMU.readRawGyroZ(); delay(4); }
  gyroBiasZ = (float)somme / 300.0;
}

float obtenirCapMagnetometre() {
  int16_t mx = read16(LIS3MDL_ADDR, 0x28);
  int16_t my = read16(LIS3MDL_ADDR, 0x2A);
  float nx = (mx - dynamic_X_OFFSET) / dynamic_X_SCALE;
  float ny = (my - dynamic_Y_OFFSET) / dynamic_Y_SCALE;
  float cap = atan2(-ny, nx) * 180.0 / PI;
  if (cap < 0) cap += 360.0;
  return cap;
}

void executerFiltreKalman() {
  uint32_t maintenant = millis();
  float dt = (maintenant - tDernierKalman) / 1000.0f;
  if (dt < 0.005f) return;
  tDernierKalman = maintenant;
  float gyroCorrige = myIMU.readRawGyroZ() - gyroBiasZ;
  float vitesseAngulaireZ = gyroCorrige * 4.375f / 1000.0f;
  capGlobal = fKalman.update(obtenirCapMagnetometre(), vitesseAngulaireZ, dt);
}

void reinitialiserRepereCartesien() {
  noInterrupts();
  pasDroit = 0; pasGauche = 0;
  ticksOdoDroit = 0; ticksOdoGauche = 0;
  ticksOdoDroitPrev = 0; ticksOdoGauchePrev = 0;
  interrupts();
  capInitialAuReset = capGlobal;
  Centre_Robot_X = -DISTANCE_MI_ENTRAXE_STYLO;
  Centre_Robot_Y = 0.0;
  x_stylo = 0.0;
  y_stylo = 0.0;
  capGlobalPrev = capGlobal;
}

void mettreAJourOdometrie() {
  if (millis() - tDerniereOdo < 10) return;
  tDerniereOdo = millis();

  noInterrupts();
  long actuelsD = ticksOdoDroit;
  long actuelsG = ticksOdoGauche;
  interrupts();

  long dTicksD = actuelsD - ticksOdoDroitPrev;
  long dTicksG = actuelsG - ticksOdoGauchePrev;
  ticksOdoDroitPrev  = actuelsD;
  ticksOdoGauchePrev = actuelsG;

  float distD = (float)dTicksD * CM_PAR_TICK;
  float distG = (float)dTicksG * CM_PAR_TICK;
  float deltaDCentre = (distD + distG) / 2.0;

  float capRad = (capGlobal - capInitialAuReset) * PI / 180.0;
  Centre_Robot_X += deltaDCentre * cos(capRad);
  Centre_Robot_Y += deltaDCentre * sin(capRad);
  x_stylo = Centre_Robot_X + DISTANCE_MI_ENTRAXE_STYLO * cos(capRad);
  y_stylo = Centre_Robot_Y + DISTANCE_MI_ENTRAXE_STYLO * sin(capRad);
}

