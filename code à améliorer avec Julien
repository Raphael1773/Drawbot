void handleCmd() {
  if (server.hasArg("action")) {
    String action = server.arg("action");
    if (action == "sequence1") sequence1Active = true;
    else { sequence1Active = false; commandeEnCours = action; }
  }
  server.send(200, "text/plain", "ok");
}

// *** CORRECTION 4 : "char json;" remplacé par "char json[128]" (buffer d'un seul octet → dépassement mémoire) ***
void handlePositions() {
  char json[128];
  snprintf(json, sizeof(json),
    "{\"rx\":%.2f,\"ry\":%.2f,\"sx\":%.2f,\"sy\":%.2f,\"cap\":%.2f}",
    Centre_Robot_X * 10.0, Centre_Robot_Y * 10.0,
    x_stylo * 10.0,        y_stylo * 10.0,
    capGlobal - capInitialAuReset);
  server.send(200, "application/json", json);
}

// --- SETUP ET LOOP ---

void setup() {
  Serial.begin(115200);
  pinMode(LEDU1, OUTPUT); pinMode(LEDU2, OUTPUT);
  pinMode(IN_1_D, OUTPUT); pinMode(IN_2_D, OUTPUT);
  pinMode(IN_1_G, OUTPUT); pinMode(IN_2_G, OUTPUT);

  ledcSetup(canalDroit,  freq, resolution); ledcAttachPin(EN_D, canalDroit);
  ledcSetup(canalGauche, freq, resolution); ledcAttachPin(EN_G, canalGauche);

  pinMode(ENC_D_CH_A, INPUT_PULLUP);
  attachInterrupt(digitalPinToInterrupt(ENC_D_CH_A), ISR_Droit,  RISING);
  pinMode(ENC_G_CH_A, INPUT_PULLUP);
  attachInterrupt(digitalPinToInterrupt(ENC_G_CH_A), ISR_Gauche, RISING);

  WiFi.softAP(ssid, password);
  server.on("/",               [](){ server.send_P(200, "text/html", PAGE_HTML); });
  server.on("/cmd",            handleCmd);
  server.on("/pos",            handlePositions);
  server.on("/cartesian/reset",[](){ reinitialiserRepereCartesien(); server.send(200, "text/plain", "ok"); });
  server.begin();

  Wire.begin(SDA_PIN, SCL_PIN);
  initLIS3MDL();
  if (myIMU.begin() == 0) calibrerGyro();

  reinitialiserRepereCartesien();
}

void loop() {
  server.handleClient();
  executerFiltreKalman();
  mettreAJourOdometrie();

  if (sequence1Active) {
    executerSequenceEscalier();
    sequence1Active = false;
  } else {
    if (commandeEnCours == "avancer") {
      digitalWrite(IN_1_D, LOW);  digitalWrite(IN_2_D, HIGH);
      digitalWrite(IN_1_G, HIGH); digitalWrite(IN_2_G, LOW);
      ledcWrite(canalDroit, PWR_DROIT_AV); ledcWrite(canalGauche, PWR_GAUCHE_AV);
    }
    else if (commandeEnCours == "reculer") {
      digitalWrite(IN_1_D, HIGH); digitalWrite(IN_2_D, LOW);
      digitalWrite(IN_1_G, LOW);  digitalWrite(IN_2_G, HIGH);
      ledcWrite(canalDroit, PWR_DROIT_AR); ledcWrite(canalGauche, PWR_GAUCHE_AR);
    }
    else if (commandeEnCours == "rotation_droite") {
      digitalWrite(IN_1_D, HIGH); digitalWrite(IN_2_D, LOW);
      digitalWrite(IN_1_G, HIGH); digitalWrite(IN_2_G, LOW);
      ledcWrite(canalDroit, PWR_VIRAGE); ledcWrite(canalGauche, PWR_VIRAGE);
    }
    else if (commandeEnCours == "rotation_gauche") {
      digitalWrite(IN_1_D, LOW);  digitalWrite(IN_2_D, HIGH);
      digitalWrite(IN_1_G, LOW);  digitalWrite(IN_2_G, HIGH);
      ledcWrite(canalDroit, PWR_VIRAGE); ledcWrite(canalGauche, PWR_VIRAGE);
    }
    else if (commandeEnCours == "stop") {
      stopMoteurs();
    }
  }
}
