void writeReg(uint8_t addr, uint8_t reg, uint8_t val) {
  Wire.beginTransmission(addr); Wire.write(reg); Wire.write(val); Wire.endTransmission(); 
}

int16_t read16(uint8_t addr, uint8_t reg) {
  Wire.beginTransmission(addr); 
  Wire.write(reg | 0x80); 
  if (Wire.endTransmission(false) != 0) return 0;
  Wire.requestFrom(addr, (uint8_t)2);
  if (Wire.available() < 2) return 0;
  return (int16_t)(Wire.read() | (Wire.read() << 8)); 
}

void initLIS3MDL() {
  writeReg(LIS3MDL_ADDR, LIS3_CTRL1, 0x7E); 
  writeReg(LIS3MDL_ADDR, LIS3_CTRL2, 0x00); 
  writeReg(LIS3MDL_ADDR, LIS3_CTRL3, 0x00); 
  writeReg(LIS3MDL_ADDR, LIS3_CTRL4, 0x0C); 
}

void calibrerGyro() {
  long somme = 0;
  for (int i = 0; i < 300; i++) { somme += myIMU.readRawGyroZ(); delay(4); }
  gyroBiasZ = (float)somme / 300.0;
}

float obtenirCapBrut(int16_t mx, int16_t my, float &nx_out, float &ny_out) {
  nx_out = (mx - dynamic_X_OFFSET) / dynamic_X_SCALE;
  ny_out = (my - dynamic_Y_OFFSET) / dynamic_Y_SCALE;
  float cap = atan2(-ny_out, nx_out) * 180.0 / PI;
  if (cap < 0) cap += 360.0;
  return cap;
}

void webSocketEvent(uint8_t num, WStype_t type, uint8_t * payload, size_t length) {
  if (type == WStype_TEXT) {
    String message = String((char*)payload);
    if (message == "START_CALIB" && etatActuel == REPOS) {
      // Déclenche le début de la machine à états
      webSocket.broadcastTXT("STARTING_ROTATION");
      x_min = 32767; x_max = -32768;
      y_min = 32767; y_max = -32768;
      clignoCompteur = 0;
      chronoEtape = millis();
      etatActuel = CLIGNOTEMENT;
    }
  }
}

void setup() {
  Serial.begin(115200);

  pinMode(LEDU1, OUTPUT); pinMode(LEDU2, OUTPUT); 
  pinMode(IN_1_D, OUTPUT); pinMode(IN_2_D, OUTPUT);
  pinMode(IN_1_G, OUTPUT); pinMode(IN_2_G, OUTPUT);
  ledcSetup(0, 5000, 8); ledcAttachPin(EN_D, 0);
  ledcSetup(1, 5000, 8); ledcAttachPin(EN_G, 1);

  Wire.begin(SDA_PIN, SCL_PIN); Wire.setClock(400000); 
  initLIS3MDL();
  myIMU.begin();
  calibrerGyro();

  WiFi.softAP(ssid, password);
  server.on("/", []() { server.send_P(200, "text/html", PAGE_DIAG); });
  server.begin();
  
  webSocket.begin();
  webSocket.onEvent(webSocketEvent); 

  int16_t mx = read16(LIS3MDL_ADDR, LIS3_OUT_X_L);
  int16_t my = read16(LIS3MDL_ADDR, LIS3_OUT_Y_L);
  float dummyX, dummyY;
  capGlobal = obtenirCapBrut(mx, my, dummyX, dummyY);
  fKalman.angle = capGlobal;
  
  tDernierKalman = millis();
  tDernierEnvoiWeb = millis();
}

void loop() {
  // Ces deux fonctions s'exécutent désormais en boucle continue sans AUCUN obstacle
  server.handleClient();
  webSocket.loop();

  uint32_t maintenant = millis();

  // =========================================================================
  // GESTION NON-BLOQUANTE DE LA SEQUENCE DE CALIBRATION (Machine à États)
  // =========================================================================
  switch (etatActuel) {
    
    case CLIGNOTEMENT:
      // Fait clignoter les LED toutes les 375ms sans bloquer le code
      if (maintenant - chronoEtape >= 375) {
        chronoEtape = maintenant;
        digitalWrite(LEDU1, !digitalRead(LEDU1));
        digitalWrite(LEDU2, !digitalRead(LEDU2));
        clignoCompteur++;
        
        if (clignoCompteur >= 4) { // Fin des 1.5 secondes de sécurité
          digitalWrite(LEDU1, HIGH); digitalWrite(LEDU2, HIGH);
          
          // Allumage moteurs à 200 de puissance
          digitalWrite(IN_1_D, LOW);  digitalWrite(IN_2_D, HIGH); 
          digitalWrite(IN_1_G, LOW);  digitalWrite(IN_2_G, HIGH); 
          ledcWrite(0, 200); 
          ledcWrite(1, 200); 
          
          chronoEtape = maintenant; // Reset chrono pour mesurer la rotation
          etatActuel = ROTATION_MESURE;
        }
      }
      break;

    case ROTATION_MESURE:
      // Lit le capteur en continu au fil de l'eau
      int16_t mx_raw, my_raw;
      mx_raw = read16(LIS3MDL_ADDR, LIS3_OUT_X_L);
      my_raw = read16(LIS3MDL_ADDR, LIS3_OUT_Y_L);

      if (mx_raw < x_min) x_min = mx_raw;
      if (mx_raw > x_max) x_max = mx_raw;
      if (my_raw < y_min) y_min = my_raw;
      if (my_raw > y_max) y_max = my_raw;

      // Arrêt automatique après 4000ms (4 secondes)
      if (maintenant - chronoEtape >= 4000) {
        ledcWrite(0, 0); ledcWrite(1, 0); // Stop moteurs immédiatement
        digitalWrite(LEDU2, LOW);

        // Calcul des constantes réelles finales
        dynamic_X_OFFSET = (float)(x_max + x_min) / 2.0f;
        dynamic_Y_OFFSET = (float)(y_max + y_min) / 2.0f;
        dynamic_X_SCALE  = (float)(x_max - x_min) / 2.0f;
        dynamic_Y_SCALE  = (float)(y_max - y_min) / 2.0f;

        webSocket.broadcastTXT("ENDING_ROTATION");
        etatActuel = REPOS; // Retour à l'état d'attente initial
      }
      break;

    case REPOS:
    default:
      break;
  }

  // =========================================================================
  // FILTRE DE KALMAN & CAP (S'exécute normalement en tâche de fond)
  // =========================================================================
  float dt = (maintenant - tDernierKalman) / 1000.0f;
  int16_t mx = read16(LIS3MDL_ADDR, LIS3_OUT_X_L);
  int16_t my = read16(LIS3MDL_ADDR, LIS3_OUT_Y_L);
  float nX = 0, nY = 0;
  float capBrut = obtenirCapBrut(mx, my, nX, nY);

  if (dt >= 0.005f) {
    tDernierKalman = maintenant;
    float gyroCorrige = myIMU.readRawGyroZ() - gyroBiasZ;
    float vitesseAngulaireZ = gyroCorrige * 4.375f / 1000.0f; 
    capGlobal = fKalman.update(capBrut, vitesseAngulaireZ, dt);
  }

  // Envoi des paquets à l'écran toutes les 250ms
  if (maintenant - tDernierEnvoiWeb > 250) {
    tDernierEnvoiWeb = maintenant;
    
    char paquet[250];
    snprintf(paquet, sizeof(paquet), 
      "<span class='cal'>[CALIB ACTUELLE] X_OFF: %.1f | Y_OFF: %.1f | X_SCA: %.1f | Y_SCA: %.1f</span><br>"
      "BRUT: %d,%d | NORM: <span class='val'>%.2f,%.2f</span> | Cap Brut: %.1f° | Kalman: <span class='cap'>%.1f°</span>", 
      dynamic_X_OFFSET, dynamic_Y_OFFSET, dynamic_X_SCALE, dynamic_Y_SCALE,
      mx, my, nX, nY, capBrut, capGlobal);
      
    webSocket.broadcastTXT(paquet); 
    Serial.println(paquet);
  }
}
