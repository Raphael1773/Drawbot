#include <WiFi.h>
#include <Wire.h>
#include <WebServer.h>
#include <WebSocketsServer.h> 
#include <SparkFunLSM6DS3.h> 

#define LEDU1 25
#define LEDU2 26

#define EN_D 23
#define EN_G   4

#define IN_1_D 19
#define IN_2_D 18
#define IN_1_G 17
#define IN_2_G 16

#define SDA_PIN 21
#define SCL_PIN 22

#define LIS3MDL_ADDR 0x1E  
#define LSM6DS3_ADDR 0x6B  

#define LIS3_CTRL1   0x20
#define LIS3_CTRL2   0x21
#define LIS3_CTRL3   0x22
#define LIS3_CTRL4   0x23

#define LIS3_OUT_X_L 0x28
#define LIS3_OUT_Y_L 0x2A

LSM6DS3 myIMU(I2C_MODE, LSM6DS3_ADDR);

