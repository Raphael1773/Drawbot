// === calculpidavecposstylo de Julien (visee CENTRE, PID complet, turn-first) ===
// Tout en MM. cap = capGyroRad. Pose centre/stylo en mm (pose interne *10).
void pidVersPoint(float cx_mm, float cy_mm, float px_mm, float py_mm,
                  float consignex, float consigney) {
  // consigne_distance = dist(centre, cible) - DISTANCESTYLO
  float consigne_distance = sqrt((consignex-cx_mm)*(consignex-cx_mm)
                               + (consigney-cy_mm)*(consigney-cy_mm)) - DISTANCESTYLO;
  float consigne_angle = atan2(consigney - cy_mm, consignex - cx_mm);
  float angleActuel    = capGyroRad;

  // PID ANGLE (P+I+D)
  float errA = normRad(consigne_angle - angleActuel);
  sErrAngle += errA; sErrAngle = constrain(sErrAngle, -MAXERR_ANGLE, MAXERR_ANGLE);
  float correctionAngle = KpAngle*errA + KiAngle*sErrAngle + KdAngle*(errA - ePrevAngle);
  ePrevAngle = errA;
  correctionAngle = constrain(correctionAngle, -MAXPID_ANGLE, MAXPID_ANGLE);
  if (INVERSER_SENS_ROTATION) correctionAngle = -correctionAngle;

  // turn-first : si l'angle est trop grand, on n'avance pas (consigne_dist = 0)
  bool derriere = (fabs(errA) > MAXANGLEDIFF);
  if (derriere) consigne_distance = 0;

  // PID DISTANCE (P+I+D), consigne = 0, input = -consigne_distance -> erreur = consigne_distance
  float correctionDistance;
  if (derriere) { correctionDistance = 0; sErrDist = 0; ePrevDist = 0; }
  else {
    float errD = consigne_distance;     // PIDdistance(0, consigne_distance) -> erreur = consigne_distance
    sErrDist += errD; sErrDist = constrain(sErrDist, -MAXERR_DIST, MAXERR_DIST);
    correctionDistance = KpDist*errD + KiDist*sErrDist + KdDist*(errD - ePrevDist);
    ePrevDist = errD;
  }

  float vG = correctionDistance - correctionAngle;
  float vD = correctionDistance + correctionAngle;
  vG = constrain(vG, -VMAX_MOTEUR, VMAX_MOTEUR);
  vD = constrain(vD, -VMAX_MOTEUR, VMAX_MOTEUR);
  const float PWM_MIN_DEMARRAGE = 110.0;   // a ajuster selon ta zone morte
  if (vG > 1 && vG < PWM_MIN_DEMARRAGE) vG = PWM_MIN_DEMARRAGE;
  if (vG < -1 && vG > -PWM_MIN_DEMARRAGE) vG = -PWM_MIN_DEMARRAGE;
  if (vD > 1 && vD < PWM_MIN_DEMARRAGE) vD = PWM_MIN_DEMARRAGE;
  if (vD < -1 && vD > -PWM_MIN_DEMARRAGE) vD = -PWM_MIN_DEMARRAGE;
  vGseq = vG; vDseq = vD;
  Serial.printf("errA=%.2f corrA=%.1f corrD=%.1f vG=%.1f vD=%.1f\n",
                errA, correctionAngle, correctionDistance, vG, vD);
  dbgErrA = errA; dbgCorrA = correctionAngle; dbgCorrD = correctionDistance;
  moteurGauche(vG);
  moteurDroite(vD);
}

// vasla non-bloquant : pilote vers wp[wpIndex] jusqu'a rester dans la boite
// +-MINDISTPOINT pendant TEMPSDARRETFIN, ou timeout TIMEOUT_PT_MS, puis suivant.
void gererSequenceEscalier() {
  if (!sequenceActive) return;

  if (millis() - tDerniereSeqCorr < 5) return;   // ~ rythme de Julien
  tDerniereSeqCorr = millis();

  // pose en mm
  float cx_mm = Centre_Robot_X * 10.0;
  float cy_mm = Centre_Robot_Y * 10.0;
  float px_mm = x_stylo * 10.0;
  float py_mm = y_stylo * 10.0;

  float cible_x = wpX[wpIndex];   // deja en mm
  float cible_y = wpY[wpIndex];

  // Pilotage PID vers le point courant
  pidVersPoint(cx_mm, cy_mm, px_mm, py_mm, cible_x, cible_y);

  // Arrive dans la boite ? (sur le STYLO, comme Julien)
  bool dedans = (fabs(px_mm - cible_x) < MINDISTPOINT && fabs(py_mm - cible_y) < MINDISTPOINT);
  if (dedans) {
    if (!dansLaBoite) { dansLaBoite = true; tDansLaBoite = millis(); }
    // reste-t-il assez longtemps dans la boite ?
    if (millis() - tDansLaBoite >= TEMPSDARRETFIN) {
      // point valide -> suivant
      if (wpIndex < wpCount - 1) {
        wpIndex++;
        Serial.printf("Point %d/%d atteint  stylo=(%.0f,%.0f)  cible=(%.0f,%.0f)\n",
                      wpIndex, wpCount, px_mm, py_mm, wpX[wpIndex], wpY[wpIndex]);
        dansLaBoite = false;
        tDebutPt = millis();
        sErrAngle = ePrevAngle = sErrDist = ePrevDist = 0;
      } else {
        arreterSequence();   // dernier point atteint et stabilise
      }
    }
  } else {
    dansLaBoite = false;
    // timeout du point (comme le end=millis()+15000 de Julien)
    if (millis() - tDebutPt > TIMEOUT_PT_MS) {
      if (wpIndex < wpCount - 1) {
        wpIndex++;
        tDebutPt = millis();
        sErrAngle = ePrevAngle = sErrDist = ePrevDist = 0;
      } else {
        arreterSequence();
      }
    }
  }
}

void corrigerPD() {
  if (commandeEnCours == "stop") { correctionDynamique = 0; return; }
  if (millis() - tDerniereCorr < 10) return;
  tDerniereCorr = millis();

  noInterrupts(); long tD = pasDroit; long tG = pasGauche; interrupts();

  long ecart = 0;
  float kp_actuel = Kp;
  float kd_actuel = Kd;

  if (commandeEnCours == "avancer" || commandeEnCours == "reculer") {
    ecart = tD - tG; kp_actuel = Kp; kd_actuel = Kd;
  }
  else if (commandeEnCours == "rotation_gauche" || commandeEnCours == "rotation_droite") {
    ecart = abs(tD) - abs(tG); kp_actuel = Kp_rotation; kd_actuel = Kd_rotation;
  }
  else if (commandeEnCours == "vag") { ecart = tG - (long)(tD * RATIO_VIRAGE); }
  else if (commandeEnCours == "vad") { ecart = tD - (long)(tG * RATIO_VIRAGE); }
  else if (commandeEnCours == "veg") { ecart = abs(tG) - (long)(abs(tD) * RATIO_VIRAGE); }
  else if (commandeEnCours == "ved") { ecart = abs(tD) - (long)(abs(tG) * RATIO_VIRAGE); }

  correctionDynamique = (int)((ecart * kp_actuel) + ((ecart - ecartPrecedent) * kd_actuel));
  ecartPrecedent = ecart;
}

void calculerVitesse() {
  if (millis() - tDerniereVit < INTERVALLE_VITESSE_MS) return;
  float dt = (millis() - tDerniereVit) / 1000.0; tDerniereVit = millis();
  noInterrupts(); long d = pasDroit; long g = pasGauche; interrupts();
  vitesseDcms = ((d - pasDroitPrev) / dt) * CM_PAR_TICK;
  vitesseGcms = ((g - pasGauchePrev) / dt) * CM_PAR_TICK;
  pasDroitPrev  = d; pasGauchePrev = g;
}

// Odometrie : cap = GYRO integre ; distance = encodeurs voie A. ~100 Hz.
void mettreAJourOdometrie() {
  uint32_t now = millis();
  if (now - tDerniereOdo < 10) return;
  float dt = (now - tDerniereOdo) / 1000.0f;
  tDerniereOdo = now;

  // 1) Cap : integration gyro (lecture ralentie a 100 Hz)
  majCapGyro(dt);

  // 2) Distance : deltas des compteurs DEDIES odo (jamais remis a zero par une
  //    commande -> plus de saut de position quand le PID manuel reset ses ticks).
  noInterrupts(); long pd = odoTicksD; long pg = odoTicksG; interrupts();
  long dPd = pd - odoPasDprev; long dPg = pg - odoPasGprev;
  odoPasDprev = pd; odoPasGprev = pg;

// Signe de la distance = sens commande aux moteurs (avance + / arriere -).
  // Pendant la sequence : vGseq/vDseq. En manuel : on deduit du sens courant.
  float signeD = (vDseq >= 0) ? 1.0 : -1.0;
  float signeG = (vGseq >= 0) ? 1.0 : -1.0;
  float distD = (float)dPd * CM_PAR_TICK * signeD;
  float distG = (float)dPg * CM_PAR_TICK * signeG;
  float deltaDCentre = (distD + distG) / 2.0;

  // 3) Integration de la pose avec le cap gyro
  Centre_Robot_X += deltaDCentre * cos(capGyroRad);
  Centre_Robot_Y += deltaDCentre * sin(capGyroRad);

  x_stylo = Centre_Robot_X + DISTANCE_MI_ENTRAXE_STYLO * cos(capGyroRad);
  y_stylo = Centre_Robot_Y + DISTANCE_MI_ENTRAXE_STYLO * sin(capGyroRad);
}

