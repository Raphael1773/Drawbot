void appliquerCommande() {
  if (commandeEnCours == "reculer" || commandeEnCours == "veg" || commandeEnCours == "ved") {
    vGseq = -1; vDseq = -1;
  } else {
    vGseq = 1; vDseq = 1;
  }
  if (commandeEnCours == "avancer") {
    digitalWrite(IN_1_D, LOW);  digitalWrite(IN_2_D, HIGH);
    digitalWrite(IN_1_G, HIGH); digitalWrite(IN_2_G, LOW);
    ledcWrite(canalDroit,  constrain(PWR_DROIT_AV - correctionDynamique, 0, 255));
    ledcWrite(canalGauche, constrain(PWR_GAUCHE_AV + correctionDynamique, 0, 255));
  }
  else if (commandeEnCours == "reculer") {
    digitalWrite(IN_1_D, HIGH); digitalWrite(IN_2_D, LOW);
    digitalWrite(IN_1_G, LOW);  digitalWrite(IN_2_G, HIGH);
    ledcWrite(canalDroit,  constrain(PWR_DROIT_AR - correctionDynamique, 0, 255));
    ledcWrite(canalGauche, constrain(PWR_GAUCHE_AR + correctionDynamique, 0, 255));
  }
  else if (commandeEnCours == "rotation_gauche") {
    digitalWrite(IN_1_D, LOW);  digitalWrite(IN_2_D, HIGH);
    digitalWrite(IN_1_G, LOW);  digitalWrite(IN_2_G, HIGH);
    ledcWrite(canalDroit,  constrain(PWR_VIRAGE - correctionDynamique, 0, 255));
    ledcWrite(canalGauche, constrain(PWR_VIRAGE + correctionDynamique, 0, 255));
  }
  else if (commandeEnCours == "rotation_droite") {
    digitalWrite(IN_1_D, HIGH); digitalWrite(IN_2_D, LOW);
    digitalWrite(IN_1_G, HIGH); digitalWrite(IN_2_G, LOW);
    ledcWrite(canalDroit,  constrain(PWR_VIRAGE - correctionDynamique, 0, 255));
    ledcWrite(canalGauche, constrain(PWR_VIRAGE + correctionDynamique, 0, 255));
  }
  else if (commandeEnCours == "vag") {
    digitalWrite(IN_1_D, LOW);  digitalWrite(IN_2_D, HIGH);
    digitalWrite(IN_1_G, HIGH); digitalWrite(IN_2_G, LOW);
    ledcWrite(canalDroit,  PWR_DROIT_AV);
    ledcWrite(canalGauche, constrain(PWR_VIR_FAIBLE - correctionDynamique, 0, 255));
  }
  else if (commandeEnCours == "vad") {
    digitalWrite(IN_1_D, LOW);  digitalWrite(IN_2_D, HIGH);
    digitalWrite(IN_1_G, HIGH); digitalWrite(IN_2_G, LOW);
    ledcWrite(canalDroit,  constrain(PWR_VIR_FAIBLE - correctionDynamique, 0, 255));
    ledcWrite(canalGauche, PWR_GAUCHE_AV);
  }
  else if (commandeEnCours == "veg") {
    digitalWrite(IN_1_D, HIGH); digitalWrite(IN_2_D, LOW);
    digitalWrite(IN_1_G, LOW);  digitalWrite(IN_2_G, HIGH);
    ledcWrite(canalDroit,  PWR_DROIT_AR);
    ledcWrite(canalGauche, constrain(PWR_VIR_FAIBLE - correctionDynamique, 0, 255));
  }
  else if (commandeEnCours == "ved") {
    digitalWrite(IN_1_D, HIGH); digitalWrite(IN_2_D, LOW);
    digitalWrite(IN_1_G, LOW);  digitalWrite(IN_2_G, HIGH);
    ledcWrite(canalDroit,  constrain(PWR_VIR_FAIBLE - correctionDynamique, 0, 255));
    ledcWrite(canalGauche, PWR_GAUCHE_AR);
  }
  else {
    ledcWrite(canalDroit,  0); ledcWrite(canalGauche, 0);
  }
  digitalWrite(LEDU2, commandeEnCours != "stop" ? HIGH : LOW);
}

void setup() {
  Serial.begin(115200);
  pinMode(LEDU1, OUTPUT); pinMode(LEDU2, OUTPUT); digitalWrite(LEDU1, HIGH);
  pinMode(IN_1_D, OUTPUT); pinMode(IN_2_D, OUTPUT);
  pinMode(IN_1_G, OUTPUT); pinMode(IN_2_G, OUTPUT);
  ledcSetup(canalDroit,  freq, resolution); ledcAttachPin(EN_D, canalDroit);
  ledcSetup(canalGauche, freq, resolution); ledcAttachPin(EN_G, canalGauche);

  // Encodeurs : interruption legere voie A (front montant) pour pasDroit/pasGauche.
  pinMode(ENC_D_CH_A, INPUT_PULLUP); pinMode(ENC_G_CH_A, INPUT_PULLUP);
  attachInterrupt(digitalPinToInterrupt(ENC_D_CH_A), ISR_Droit,  RISING);
  attachInterrupt(digitalPinToInterrupt(ENC_G_CH_A), ISR_Gauche, RISING);

  WiFi.softAP(ssid, password);
  server.on("/", handleRoot);
  server.on("/cmd", handleCmd);
  server.on("/pos", handlePositions);
  server.on("/cartesian/reset", handleCartesianReset);
  server.on("/seq", handleSequence);
  server.on("/sequence/stop", handleStopSequence);
  server.begin();

  Wire.begin(SDA_PIN, SCL_PIN); Wire.setClock(400000);
  initLIS3MDL();

  myIMU.settings.gyroRange      = 500;   // doit correspondre a GYRO_SENS_MDPS_LSB (17.5)
  myIMU.settings.gyroSampleRate = 416;
  myIMU.settings.gyroBandWidth  = 200;
  if (myIMU.begin() == 0) { calibrerGyro(); }

  capGlobal = obtenirCapMagnetometre();
  reinitialiserRepereCartesien();
  tDernierKalman = millis(); tDerniereVit = millis();
  tDerniereOdo = millis();   tDernierGyro = millis();
}

void loop() {
  server.handleClient();
  executerFiltreKalman();     // magneto/Kalman : seulement hors sequence (affichage)
  calculerVitesse();
  mettreAJourOdometrie();     // cap gyro + pose (toujours)

  // Demarrage d'une sequence demandee depuis la page web
  if (seqDemandee != SEQ_AUCUNE && !sequenceActive) {
    int id = seqDemandee; seqDemandee = SEQ_AUCUNE;
    demarrerSequence(id);
  }

  if (sequenceActive) {
    gererSequenceEscalier();
  } else {
    appliquerCommande();
    corrigerPD();
  }
}
