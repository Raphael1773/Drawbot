}

// Estimation du biais gyro (robot IMMOBILE). Appelee au boot ET au lancement
// de la sequence (le robot est pose et immobile a ce moment-la).
void calibrerGyro() {
  long somme = 0;
  int nbEchantillons = 1000; // Plus de points pour stabiliser le biais
  Serial.println("Calibration Gyro... NE PAS BOUGER");
  for (int i = 0; i < nbEchantillons; i++) {
    somme += myIMU.readRawGyroZ();
    delay(2);
  }
  gyroBiasZ = (float)somme / (float)nbEchantillons;
  Serial.print("Biais calcule : "); Serial.println(gyroBiasZ);
}

float obtenirCapMagnetometre() {
  int16_t mx = read16(LIS3MDL_ADDR, LIS3_OUT_X_L);
  int16_t my = read16(LIS3MDL_ADDR, LIS3_OUT_X_L + 2);
  float nx = (mx - CALIB_X_OFFSET) / CALIB_X_SCALE;
  float ny = (my - CALIB_Y_OFFSET) / CALIB_Y_SCALE;
  float cap = atan2(-ny, nx) * 180.0 / PI;
  if (cap < 0) cap += 360.0;
  if (INVERSER_CAP) cap = 360.0 - cap;
  return cap;
}

// Kalman magneto/gyro : conserve UNIQUEMENT pour l'affichage hors sequence.
// Desactive pendant la sequence (le magneto pollue serait nuisible + charge I2C).
void executerFiltreKalman() {
  if (sequenceActive) return;
  uint32_t maintenant = millis();
  float dt = (maintenant - tDernierKalman) / 1000.0f;
  if (dt < 0.02f) return;          // ralenti a ~50 Hz pour ne pas surcharger
  tDernierKalman = maintenant;

  float gyroCorrige = myIMU.readRawGyroZ() - gyroBiasZ;
  float w = gyroCorrige * GYRO_SENS_MDPS_LSB / 1000.0f;
  if (INVERSER_GYRO) w = -w;
  capGlobal = fKalman.update(obtenirCapMagnetometre(), w, dt);
}

// Lecture + integration du cap GYRO (avec verifications). dt en secondes.
void majCapGyro(float dt) {
  float raw = (float)myIMU.readRawGyroZ() - gyroBiasZ;
  float dps = raw * GYRO_SENS_MDPS_LSB / 1000.0f;     // deg/s
  if (fabs(dps) > GYRO_MAX_DPS)      dps = 0.0f;      // rejet pic aberrant
  if (fabs(dps) < GYRO_DEADBAND_DPS) dps = 0.0f;      // anti-derive au repos
  dps *= GYRO_SCALE_CORR;
  if (INVERSER_GYRO) dps = -dps;
  capGyroRad += dps * (float)PI / 180.0f * dt;
}

