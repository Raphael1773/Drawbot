float normRad(float a) {
  while (a >  PI) a -= 2 * PI;
  while (a < -PI) a += 2 * PI;
  return a;
}

// === Primitives de Julien : empilent des points dans la file (en mm) ===
void vasla(float x, float y) {
  if (wpCount < MAX_WP) { wpX[wpCount] = x; wpY[wpCount] = y; wpCount++; }
}

void trajectoirefaituntrait(float debutx, float debuty, float finx, float finy) {
  float distance = sqrt((finx-debutx)*(finx-debutx) + (finy-debuty)*(finy-debuty));
  int n = (int)(distance / DIFFMMPARPOINT); if (n < 1) n = 1;
  for (int i = 1; i <= n; i++) {
    float x = debutx + (finx-debutx) * (float)i / (float)n;
    float y = debuty + (finy-debuty) * (float)i / (float)n;
    vasla(x, y);
  }
}

void trajectoirefaituncercle(float cX, float cY, float rayon, float aDebut, float aFin) {
  int n = (int)fabs((aFin - aDebut) * rayon / DIFFMMPARPOINT); if (n < 1) n = 1;
  for (int i = 0; i <= n; i++) {
    float a = aDebut + (aFin - aDebut) * (float)i / (float)n;
    vasla(cX + rayon * cos(a), cY + rayon * sin(a));
  }
}

