  if      (nom == "escalier")    id = SEQ_ESCALIER;
  else if (nom == "escalier2")   id = SEQ_ESCALIER2;
  else if (nom == "carre")       id = SEQ_CARRE;
  else if (nom == "sequence1")   id = SEQ_SEQUENCE1;
  else if (nom == "angledroit")  id = SEQ_ANGLEDROIT;
