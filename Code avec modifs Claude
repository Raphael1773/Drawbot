void handleRoot() { server.send_P(200, "text/html", PAGE_HTML); }

void handleCmd() {
  if (server.hasArg("action")) {
    sequenceActive = false;     // tout bouton manuel coupe l'autopilote
    definirCommande(server.arg("action"));
  }
  server.send(200, "text/plain", "ok");
}

void handlePositions() {
  float robX, robY, styX, styY;
  if (ECHANGER_AFFICHAGE) {
    robX = Centre_Robot_Y * 10.0;  robY = Centre_Robot_X * 10.0;
    styX = y_stylo        * 10.0;  styY = x_stylo        * 10.0;
  } else {
    robX = Centre_Robot_X * 10.0;  robY = Centre_Robot_Y * 10.0;
    styX = x_stylo        * 10.0;  styY = y_stylo        * 10.0;
  }

  // CAP affiche = cap GYRO (celui qui pilote), en degres [-180,180].
  // VERIFICATIONS :
  //  - pousser le robot tout droit -> Stylo X augmente, Stylo Y ~constant ;
  //  - faire tourner le robot 360 deg REEL -> ce CAP doit afficher ~360 (ou -360).
  //    Si non, ajuster GYRO_SCALE_CORR = 360 / (valeur lue). Si sens inverse,
  //    passer INVERSER_GYRO a true.
  float capDeg = capGyroRad * 180.0 / PI;
  while (capDeg > 180.0)  capDeg -= 360.0;
  while (capDeg < -180.0) capDeg += 360.0;

  char json[220];
  snprintf(json, sizeof(json),
    "{\"rx\":%.2f,\"ry\":%.2f,\"sx\":%.2f,\"sy\":%.2f,\"cap\":%.1f,\"seq\":%d,\"seqpt\":%d,\"seqn\":%d,\"errA\":%.3f,\"corrA\":%.1f,\"corrD\":%.1f}",
    robX, robY, styX, styY, capDeg, sequenceActive ? 1 : 0, wpIndex, wpCount, dbgErrA, dbgCorrA, dbgCorrD);
  server.send(200, "application/json", json);
}

