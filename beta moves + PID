#define LEDU1 25
#define LEDU2 26

#define EN_D 23
#define EN_G  4

#define IN_1_D 19
#define IN_2_D 18
#define IN_1_G 17
#define IN_2_G 16

#define ENC_G_CH_A 32
#define ENC_G_CH_B 33
#define ENC_D_CH_A 27
#define ENC_D_CH_B 14

volatile long pasDroit  = 0;
volatile long pasGauche = 0;
volatile long ticksOdoDroit  = 0;
volatile long ticksOdoGauche = 0;

void IRAM_ATTR ISR_Droit()  { pasDroit++;  ticksOdoDroit++; }
void IRAM_ATTR ISR_Gauche() { pasGauche++; ticksOdoGauche++; }

#define SDA_PIN 21
#define SCL_PIN 22

#define LIS3MDL_ADDR 0x1E  
#define LSM6DS3_ADDR 0x6B  

#define LIS3_CTRL1   0x20
#define LIS3_CTRL2   0x21
#define LIS3_CTRL3   0x22
#define LIS3_CTRL4   0x23
#define LIS3_OUT_X_L 0x28

LSM6DS3 myIMU(I2C_MODE, LSM6DS3_ADDR);

const int freq        = 5000;
const int resolution  = 8;
const int canalDroit  = 0;
const int canalGauche = 1;

// Puissances nominales cibles
const int PWR_DROIT_AV  = 200;   
const int PWR_GAUCHE_AV = 208;   
const int PWR_DROIT_AR  = 194;   
const int PWR_GAUCHE_AR = 200;
const int PWR_VIRAGE    = 210; 
const int PWR_VIR_FAIBLE = 135; 

// Ratio pour les virages mobiles (135 / 200)
const float RATIO_VIRAGE = (float)PWR_VIR_FAIBLE / 200.0;

const float TICKS_PAR_TOUR = 1050.0;
const float DIAM_ROUE_CM   = 9.0;
const float CIRCONF_CM     = PI * DIAM_ROUE_CM;      
const float CM_PAR_TICK    = CIRCONF_CM / TICKS_PAR_TOUR; 

// CONFIGURATION DU REPERE CARTESIEN
const float DISTANCE_MI_ENTRAXE_STYLO = 13.10;
float Centre_Robot_X = -13.10; 
float Centre_Robot_Y = 0.0;
float capGlobal = 0.0; 
float capGlobalPrev = 0.0; 
float x_stylo = 0.0;   
float y_stylo = 0.0;   

float capInitialAuReset = 0.0; 

const int INTERVALLE_VITESSE_MS = 200;
float vitesseDcms  = 0.0;   
float vitesseGcms  = 0.0;   

long     pasDroitPrev   = 0;
long     pasGauchePrev  = 0;
uint32_t tDerniereVit   = 0;

long     pasDroitOdoPrev  = 0;
long     pasGaucheOdoPrev = 0;
uint32_t tDerniereOdo     = 0;

float gyroBiasZ   = 0.0;
uint32_t tDernierKalman = 0;

struct Kalman1D {
  float Q_angle = 0.001f;  
  float Q_bias  = 0.003f;  
  float R_measure = 0.03f; 
  float angle = 0.0f; 
  float bias  = 0.0f; 
  float P[2][2] = {{0, 0}, {0, 0}};

  float update(float newAngle, float newRate, float dt) {
    float rate = newRate - bias;
    angle += dt * rate;
    P[0][0] += dt * (dt * P[1][1] - P[0][1] - P[1][0] + Q_angle);
    P[0][1] -= dt * P[1][1];
    P[1][0] -= dt * P[1][1];
    P[1][1] += Q_bias * dt;
    float S = P[0][0] + R_measure;
    float K[2]; 
    K[0] = P[0][0] / S; K[1] = P[1][0] / S;
    float y = newAngle - angle;
    if (y > 180.0f)  y -= 360.0f;
    if (y < -180.0f) y += 360.0f;
    angle += K[0] * y; bias += K[1] * y;
    float P00_temp = P[0][0]; float P01_temp = P[0][1];
    P[0][0] -= K[0] * P00_temp; P[0][1] -= K[0] * P01_temp;
    P[1][0] -= K[1] * P00_temp; P[1][1] -= K[1] * P01_temp;
    if (angle >= 360.0f) angle -= 360.0f;
    if (angle < 0.0f)    angle += 360.0f;
    return angle;
  }
};

Kalman1D fKalman;

const char* ssid     = "Draw_GOAAAT";
const char* password = "12345678";
WebServer server(80);
String commandeEnCours = "stop";

const float CALIB_X_OFFSET = -2045.0;
const float CALIB_Y_OFFSET =   654.0;
const float CALIB_X_SCALE  =  1857.0;
const float CALIB_Y_SCALE  =  1922.0;

// Configuration PID d'origine
uint32_t tDerniereCorr = 0;
const float Kp = 0.8;   
const float Kd = 0.3;   

const float Kp_rotation = 0.3; 
const float Kd_rotation = 0.1;

long ecartPrecedent  = 0;
int correctionDynamique = 0; 

void writeReg(uint8_t addr, uint8_t reg, uint8_t val) {
  Wire.beginTransmission(addr); Wire.write(reg); Wire.write(val); Wire.endTransmission(); 
}

int16_t read16(uint8_t addr, uint8_t reg) {
  Wire.beginTransmission(addr); Wire.write(reg | 0x80); Wire.endTransmission(false); 
  Wire.requestFrom(addr, (uint8_t)2);
  return (int16_t)(Wire.read() | (Wire.read() << 8)); 
}

void initLIS3MDL() {
  writeReg(LIS3MDL_ADDR, LIS3_CTRL1, 0x7E); 
  writeReg(LIS3MDL_ADDR, LIS3_CTRL2, 0x00); 
  writeReg(LIS3MDL_ADDR, LIS3_CTRL3, 0x00); 
  writeReg(LIS3MDL_ADDR, LIS3_CTRL4, 0x0C); 
}

void calibrerGyro() {
  long somme = 0;
  for (int i = 0; i < 300; i++) { somme += myIMU.readRawGyroZ(); delay(4); }
  gyroBiasZ = (float)somme / 300.0;
}

float obtenirCapMagnetometre() {
  int16_t mx = read16(LIS3MDL_ADDR, LIS3_OUT_X_L);
  int16_t my = read16(LIS3MDL_ADDR, LIS3_OUT_X_L + 2);
  float nx = (mx - CALIB_X_OFFSET) / CALIB_X_SCALE;
  float ny = (my - CALIB_Y_OFFSET) / CALIB_Y_SCALE;
  float cap = atan2(-ny, nx) * 180.0 / PI;
  if (cap < 0) cap += 360.0;
  return cap;
}

void executerFiltreKalman() {
  uint32_t maintenant = millis();
  float dt = (maintenant - tDernierKalman) / 1000.0f;
  if (dt < 0.005f) return; 
  tDernierKalman = maintenant;

  float gyroCorrige = myIMU.readRawGyroZ() - gyroBiasZ;
  float vitesseAngulaireZ = gyroCorrige * 4.375f / 1000.0f; 
  capGlobal = fKalman.update(obtenirCapMagnetometre(), vitesseAngulaireZ, dt);
}

void reinitialiserRepereCartesien() {
  noInterrupts();
  pasDroit = 0; pasGauche = 0;
  ticksOdoDroit = 0; ticksOdoGauche = 0;
  interrupts();

  pasDroitPrev = 0; pasGauchePrev = 0;
  pasDroitOdoPrev = 0; pasGaucheOdoPrev = 0;

  capInitialAuReset = capGlobal;

  Centre_Robot_X = -DISTANCE_MI_ENTRAXE_STYLO; 
  Centre_Robot_Y = 0.0;

  x_stylo = 0.0; 
  y_stylo = 0.0;
  
  capGlobalPrev = capGlobal;
}

void corrigerPD() {
  if (commandeEnCours == "stop") { correctionDynamique = 0; return; }
  if (millis() - tDerniereCorr < 10) return;   
  tDerniereCorr = millis();

  noInterrupts(); long tD = pasDroit; long tG = pasGauche; interrupts();

  long ecart = 0;
  float kp_actuel = Kp;
  float kd_actuel = Kd;

  if (commandeEnCours == "avancer" || commandeEnCours == "reculer") {
    ecart = tD - tG; 
    kp_actuel = Kp;
    kd_actuel = Kd;
  }
  else if (commandeEnCours == "rotation_gauche" || commandeEnCours == "rotation_droite") {
    ecart = abs(tD) - abs(tG);
    kp_actuel = Kp_rotation; 
    kd_actuel = Kd_rotation;
  }
  else if (commandeEnCours == "vag") {
    ecart = tG - (long)(tD * RATIO_VIRAGE);
  }
  else if (commandeEnCours == "vad") {
    ecart = tD - (long)(tG * RATIO_VIRAGE);
  }
  else if (commandeEnCours == "veg") {
    ecart = abs(tG) - (long)(abs(tD) * RATIO_VIRAGE);
  }
  else if (commandeEnCours == "ved") {
    ecart = abs(tD) - (long)(abs(tG) * RATIO_VIRAGE);
  }

  correctionDynamique = (int)((ecart * kp_actuel) + ((ecart - ecartPrecedent) * kd_actuel));
  ecartPrecedent = ecart;
}

void calculerVitesse() {
  if (millis() - tDerniereVit < INTERVALLE_VITESSE_MS) return;
  float dt = (millis() - tDerniereVit) / 1000.0; tDerniereVit = millis();
  noInterrupts(); long d = pasDroit; long g = pasGauche; interrupts();
  vitesseDcms = ((d - pasDroitPrev) / dt) * CM_PAR_TICK;
  vitesseGcms = ((g - pasGauchePrev) / dt) * CM_PAR_TICK;
  pasDroitPrev  = d; pasGauchePrev = g;
}

void mettreAJourOdometrie() {
  if (millis() - tDerniereOdo < 10) return; 
  tDerniereOdo = millis();

  noInterrupts(); long actuelsD = ticksOdoDroit; long actuelsG = ticksOdoGauche; interrupts();
  long deltaTicksD = actuelsD - pasDroitOdoPrev; long deltaTicksG = actuelsG - pasGaucheOdoPrev;
  pasDroitOdoPrev  = actuelsD; pasGaucheOdoPrev = actuelsG;

  float deltaDCentre = 0.0;
  float distD = (float)deltaTicksD * CM_PAR_TICK;
  float distG = (float)deltaTicksG * CM_PAR_TICK;

  if (commandeEnCours == "avancer" || commandeEnCours == "vag" || commandeEnCours == "vad") {
    deltaDCentre = (distD + distG) / 2.0;
  } 
  else if (commandeEnCours == "reculer" || commandeEnCours == "veg" || commandeEnCours == "ved") {
    deltaDCentre = -((distD + distG) / 2.0);
  } 
  else if (commandeEnCours == "rotation_gauche" || commandeEnCours == "rotation_droite") {
    deltaDCentre = 0.0;
  }

  float angleMoyenDeg = (capGlobalPrev + capGlobal) / 2.0;
  capGlobalPrev = capGlobal;

  float capVirtuelDeg = angleMoyenDeg - capInitialAuReset;
  float capRad = capVirtuelDeg * PI / 180.0;

  Centre_Robot_X += deltaDCentre * cos(capRad);
  Centre_Robot_Y += deltaDCentre * sin(capRad);

  x_stylo = Centre_Robot_X + DISTANCE_MI_ENTRAXE_STYLO * cos(capRad);
  y_stylo = Centre_Robot_Y + DISTANCE_MI_ENTRAXE_STYLO * sin(capRad);
}

