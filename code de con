// ── HANDLERS HTTP ─────────────────────────────────────────────────────────────
void handleRoot() { server.send_P(200,"text/html",PAGE_HTML); }

void handleCmd() {
  if(etatCourant!=TELEOP){server.send(200,"text/plain","seq_running");return;}
  if(server.hasArg("action")){
    String nc=server.arg("action");
    if(nc!=commandeEnCours){
      resetTicksPID();
    }
    commandeEnCours=nc;
  }
  server.send(200,"text/plain","ok");
}

void handleStatus() {
  const char* nomEtat="TELEOP";
  if(etatCourant==SEQ1_SUIVI)   nomEtat="SUIVI";
  if(etatCourant==SEQ1_REALIGN) nomEtat="REALIGN";
  if(etatCourant==SEQ1_TERMINE) nomEtat="TERMINE";
  int seg=min(segCourant,NB_SEGS-1);
  float errp=erreurPerpendiculaire(seg);
  float axeActuel=SEGS[seg].progresseEnX ? y_stylo : x_stylo;
  char json[320];
  snprintf(json,sizeof(json),
    "{\"etat\":\"%s\",\"cmd\":\"%s\",\"seg\":%d,\"nbsegs\":%d,"
    "\"errp\":%.3f,\"cap\":%.2f,\"capc\":%.2f,"
    "\"sx\":%.1f,\"sy\":%.1f,\"axe\":%.2f,\"axec\":%.2f}",
    nomEtat,commandeEnCours.c_str(),segCourant,NB_SEGS,
    errp,capGlobal,capCibleSegment,
    x_stylo*10.0,y_stylo*10.0,
    axeActuel,SEGS[seg].valAxeFixe);
  server.send(200,"application/json",json);
}

void handleCartesianReset(){reinitialiserRepereCartesien();server.send(200,"text/plain","ok");}
void handleSeq1Start(){lancerSeq1();server.send(200,"text/plain","ok");}
void handleSeq1Stop(){
  ledcWrite(canalDroit,0);ledcWrite(canalGauche,0);
  commandeEnCours="stop";
  etatCourant=TELEOP;
  server.send(200,"text/plain","ok");
}

// ── SETUP ─────────────────────────────────────────────────────────────────────
void setup() {
  Serial.begin(115200);
  pinMode(LEDU1,OUTPUT);pinMode(LEDU2,OUTPUT);digitalWrite(LEDU1,HIGH);
  pinMode(IN_1_D,OUTPUT);pinMode(IN_2_D,OUTPUT);
  pinMode(IN_1_G,OUTPUT);pinMode(IN_2_G,OUTPUT);
  ledcSetup(canalDroit, freq,resolution);ledcAttachPin(EN_D,canalDroit);
  ledcSetup(canalGauche,freq,resolution);ledcAttachPin(EN_G,canalGauche);
  pinMode(ENC_D_CH_A,INPUT_PULLUP);
  pinMode(ENC_G_CH_A,INPUT_PULLUP);
  pinMode(ENC_D_CH_B, INPUT_PULLUP);
  pinMode(ENC_G_CH_B, INPUT_PULLUP);
  attachInterrupt(digitalPinToInterrupt(ENC_D_CH_A),ISR_Droit, RISING);
  attachInterrupt(digitalPinToInterrupt(ENC_G_CH_A),ISR_Gauche,RISING);
  WiFi.softAP(ssid,password);
  server.on("/",               handleRoot);
  server.on("/cmd",            handleCmd);
  server.on("/status",         handleStatus);
  server.on("/cartesian/reset",handleCartesianReset);
  server.on("/seq1/start",     handleSeq1Start);
  server.on("/seq1/stop",      handleSeq1Stop);
  server.begin();
  Wire.begin(SDA_PIN,SCL_PIN);Wire.setClock(400000);
  initLIS3MDL();
  if(myIMU.begin()==0){calibrerGyro();}
  capGlobal=obtenirCapMagnetometre();
  reinitialiserRepereCartesien();
  tDernierKalman=millis();tDerniereVit=millis();tDerniereOdo=millis();
}

// ── LOOP ──────────────────────────────────────────────────────────────────────
void loop() {
  server.handleClient();
  executerFiltreKalman();
  mettreAJourOdometrie();
  calculerVitesse();
  switch(etatCourant){
    case TELEOP:
      corrigerPD();
      appliquerCommande();
      break;
    case SEQ1_SUIVI:
      executerSeq1Suivi();
      break;
    case SEQ1_REALIGN:
      executerSeq1Realign();
      break;
    case SEQ1_TERMINE:
      ledcWrite(canalDroit,0);ledcWrite(canalGauche,0);
      break;
  }
}
