    digitalWrite(IN_1_G,LOW);  digitalWrite(IN_2_G,HIGH);
    ledcWrite(canalDroit, constrain(PWR_VIRAGE-correctionDynamique,0,255));
    ledcWrite(canalGauche,constrain(PWR_VIRAGE+correctionDynamique,0,255));
  } else if(commandeEnCours=="rotation_droite"){
    digitalWrite(IN_1_D,HIGH); digitalWrite(IN_2_D,LOW);
    digitalWrite(IN_1_G,HIGH); digitalWrite(IN_2_G,LOW);
    ledcWrite(canalDroit, constrain(PWR_VIRAGE-correctionDynamique,0,255));
    ledcWrite(canalGauche,constrain(PWR_VIRAGE+correctionDynamique,0,255));
  } else if(commandeEnCours=="vag"){
    digitalWrite(IN_1_D,LOW);  digitalWrite(IN_2_D,HIGH);
    digitalWrite(IN_1_G,HIGH); digitalWrite(IN_2_G,LOW);
    ledcWrite(canalDroit, PWR_DROIT_AV);
    ledcWrite(canalGauche,constrain(PWR_VIR_FAIBLE-correctionDynamique,0,255));
  } else if(commandeEnCours=="vad"){
    digitalWrite(IN_1_D,LOW);  digitalWrite(IN_2_D,HIGH);
    digitalWrite(IN_1_G,HIGH); digitalWrite(IN_2_G,LOW);
    ledcWrite(canalDroit, constrain(PWR_VIR_FAIBLE-correctionDynamique,0,255));
    ledcWrite(canalGauche,PWR_GAUCHE_AV);
  } else if(commandeEnCours=="veg"){
    digitalWrite(IN_1_D,HIGH); digitalWrite(IN_2_D,LOW);
    digitalWrite(IN_1_G,LOW);  digitalWrite(IN_2_G,HIGH);
    ledcWrite(canalDroit, PWR_DROIT_AR);
    ledcWrite(canalGauche,constrain(PWR_VIR_FAIBLE-correctionDynamique,0,255));
  } else if(commandeEnCours=="ved"){
    digitalWrite(IN_1_D,HIGH); digitalWrite(IN_2_D,LOW);
    digitalWrite(IN_1_G,LOW);  digitalWrite(IN_2_G,HIGH);
    ledcWrite(canalDroit, constrain(PWR_VIR_FAIBLE-correctionDynamique,0,255));
    ledcWrite(canalGauche,PWR_GAUCHE_AR);
  } else {
    ledcWrite(canalDroit,0); ledcWrite(canalGauche,0);
  }
  digitalWrite(LEDU2,commandeEnCours!="stop"?HIGH:LOW);
}

// ── UTILITAIRES SEQUENCE ──────────────────────────────────────────────────────
float diffCap(float cible, float actuel) {
  float d=cible-actuel;
  if(d> 180.0) d-=360.0;
  if(d<-180.0) d+=360.0;
  return d;
}

float erreurPerpendiculaire(int seg) {
  Point p1=SEGS[seg].p1, p2=SEGS[seg].p2;
  float dx=p2.x-p1.x, dy=p2.y-p1.y;
  float longueur=sqrt(dx*dx+dy*dy);
  if(longueur<0.001) return 0.0;
  return ((dx*(y_stylo-p1.y))-(dy*(x_stylo-p1.x)))/longueur;
}

// FIX 4 : condition basee sur la direction signee P2-P1
// Fonctionne pour progressions positives ET negatives
bool waypointAtteint(int seg) {
  Point p1=SEGS[seg].p1, p2=SEGS[seg].p2;
  if(SEGS[seg].progresseEnX){
    if(p2.x > p1.x) return x_stylo >= (p2.x - 0.15f);
    else             return x_stylo <= (p2.x + 0.15f);
  } else {
    if(p2.y > p1.y) return y_stylo >= (p2.y - 0.15f);
    else             return y_stylo <= (p2.y + 0.15f);
  }
}

const float TOLERANCE_CAP_REALIGN_DEG = 5.0;

bool realignTermine(int seg) {
  return abs(diffCap(capCibleSegment, capGlobal)) < TOLERANCE_CAP_REALIGN_DEG;
}

void resetTicksPID() {
  noInterrupts(); pasDroit=0; pasGauche=0; interrupts();
  ecartPrecedent=0; correctionDynamique=0;
}

void passerSegmentSuivant() {
  segCourant++;
  if(segCourant>=NB_SEGS){ etatCourant=SEQ1_TERMINE; return; }
  capCibleSegment=fmod(capInitialAuReset+SEGS[segCourant].capRelatif+360.0,360.0);
  resetTicksPID();
  cmdPrecedenteSuivi="avancer";
  segmentDemarre = false;  // ← ici
  etatCourant=SEQ1_REALIGN;
}

// ── LANCER SEQUENCE 1 ─────────────────────────────────────────────────────────
void lancerSeq1() {
  ledcWrite(canalDroit,0); ledcWrite(canalGauche,0);
  reinitialiserRepereCartesien();
  resetTicksPID();
  tDerniereVerifZone=0;
  segCourant=0;
  cmdPrecedenteSuivi="avancer";
  segmentDemarre = false;  // ← ici
  capCibleSegment=fmod(capInitialAuReset+SEGS[0].capRelatif+360.0,360.0);
  if(realignTermine(0)){
    commandeEnCours="avancer";
    etatCourant=SEQ1_SUIVI;
  } else {
    etatCourant=SEQ1_REALIGN;
  }
}

// ── EXECUTER SUIVI DE LIGNE ───────────────────────────────────────────────────

void executerSeq1Suivi() {

  // Marquer le segment comme démarré seulement quand le stylo
  // progresse dans la bonne direction depuis le point de départ
  if(!segmentDemarre) {
    Point p1 = SEGS[segCourant].p1;
    float distDepuisDepart;
    if(SEGS[segCourant].progresseEnX)
      distDepuisDepart = abs(x_stylo - p1.x);
    else
      distDepuisDepart = abs(y_stylo - p1.y);
    if(distDepuisDepart >= 2.0) segmentDemarre = true;
  }

  // Waypoint vérifié seulement si le segment est bien démarré
  if(segmentDemarre && waypointAtteint(segCourant)){
    ledcWrite(canalDroit,0); ledcWrite(canalGauche,0);
    delay(150);
    segmentDemarre = false;
    Serial.println("WP"+String(segCourant+1)+" atteint"
      +" x="+String(x_stylo)+" y="+String(y_stylo));
    passerSegmentSuivant();
    return;
  }

  // Toutes les 10ms : choisir la commande selon la zone
  if(millis()-tDerniereVerifZone >= 10){
    tDerniereVerifZone=millis();
    float errPerp=erreurPerpendiculaire(segCourant);

    String nouvelleCommande;
    if      (errPerp >  ZONE_CM) nouvelleCommande="vad";
    else if (errPerp < -ZONE_CM) nouvelleCommande="vag";
    else                          nouvelleCommande="avancer";

    if(nouvelleCommande != cmdPrecedenteSuivi){
      resetTicksPID();
      cmdPrecedenteSuivi=nouvelleCommande;
    }
    commandeEnCours=nouvelleCommande;
  }

  corrigerPD();
  appliquerCommande();
}

// ── EXECUTER REALIGNEMENT ─────────────────────────────────────────────────────
void executerSeq1Realign() {
  if(realignTermine(segCourant)){
    ledcWrite(canalDroit,0); ledcWrite(canalGauche,0);
    delay(150);
    resetTicksPID();
    tDerniereVerifZone=0;
    cmdPrecedenteSuivi="avancer";
    commandeEnCours="avancer";
    etatCourant=SEQ1_SUIVI;
    Serial.println(String("Realign termine")
      +" x="+String(x_stylo)+" y="+String(y_stylo)
      +" cap="+String(capGlobal));  // ← String() au début
    return;
  }
  float dc=diffCap(capCibleSegment,capGlobal);
  commandeEnCours=(dc>0) ? "rotation_gauche" : "rotation_droite";
  corrigerPD();
  appliquerCommande();
}

